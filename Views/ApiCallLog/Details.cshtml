@model VectorRagDemo.Models.Entities.ApiCallLog

@{
    ViewData["Title"] = "API Call Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>API Call Details</h1>
    <a asp-action="Index" btn-variant="secondary">Back to List</a>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card mb-3">
            <div class="card-header">
                <h5>Request Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-3"><strong>ID:</strong></div>
                    <div class="col-md-9">@Model.ID</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Timestamp:</strong></div>
                    <div class="col-md-9">@Model.GemaaktOp.ToString("yyyy-MM-dd HH:mm:ss")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Method:</strong></div>
                    <div class="col-md-9"><span class="badge bg-secondary">@Model.RequestMethod</span></div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Request URI:</strong></div>
                    <div class="col-md-9"><code style="word-break: break-all;">@Model.RequestUri</code></div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Client IP:</strong></div>
                    <div class="col-md-9">@(Model.ClientIP ?? "N/A")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Correlation ID:</strong></div>
                    <div class="col-md-9">@(Model.CorrelationId?.ToString() ?? "N/A")</div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5>Response Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Status Code:</strong></div>
                    <div class="col-md-9">
                        <span class="badge @(Model.ResponseStatus >= 200 && Model.ResponseStatus < 300 ? "bg-success" :
                                            Model.ResponseStatus >= 300 && Model.ResponseStatus < 400 ? "bg-warning" :
                                            Model.ResponseStatus >= 400 ? "bg-danger" : "bg-secondary")">
                            @Model.ResponseStatus
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-3"><strong>Duration:</strong></div>
                    <div class="col-md-9">
                        @if (Model.DurationMs.HasValue)
                        {
                            <span class="badge @(Model.DurationMs.Value < 1000 ? "bg-success" :
                                               Model.DurationMs.Value < 3000 ? "bg-warning" : "bg-danger")">
                                @Model.DurationMs.Value ms
                            </span>
                        }
                        else
                        {
                            <span>N/A</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="row mb-2">
                        <div class="col-md-3"><strong>Error:</strong></div>
                        <div class="col-md-9">
                            <div class="alert alert-danger" role="alert">
                                @Model.ErrorMessage
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5>Request Headers</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.RequestHeaders))
                {
                    <pre class="bg-light p-3" style="max-height: 300px; overflow-y: auto;">@Model.RequestHeaders</pre>
                }
                else
                {
                    <p class="text-muted">No request headers recorded</p>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5>Request Content</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.RequestContent))
                {
                    <pre class="bg-light p-3" style="max-height: 400px; overflow-y: auto;">@Model.RequestContent</pre>
                }
                else
                {
                    <p class="text-muted">No request content</p>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5>Response Headers</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ResponseHeaders))
                {
                    <pre class="bg-light p-3" style="max-height: 300px; overflow-y: auto;">@Model.ResponseHeaders</pre>
                }
                else
                {
                    <p class="text-muted">No response headers recorded</p>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5>Response Content</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ResponseContent))
                {
                    <pre class="bg-light p-3" style="max-height: 400px; overflow-y: auto;">@Model.ResponseContent</pre>
                }
                else
                {
                    <p class="text-muted">No response content</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <a asp-action="Index" btn-variant="secondary">Back to List</a>
</div>

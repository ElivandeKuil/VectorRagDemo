@model VectorRagDemo.Models.ViewModels.ApiCallLogViewModel

@{
    ViewData["Title"] = "API Call Logs";
}

<h1>API Call Logs</h1>

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5>Filters</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row">
                <div class="col-md-3">
                    <label for="StartDate" app-label>Start Date</label>
                    <input type="datetime-local" app-field id="StartDate" name="StartDate"
                           value="@(Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>
                <div class="col-md-3">
                    <label for="EndDate" app-label>End Date</label>
                    <input type="datetime-local" app-field id="EndDate" name="EndDate"
                           value="@(Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>
                <div class="col-md-2">
                    <label for="RequestMethodFilter" app-label>Method</label>
                    <select app-field id="RequestMethodFilter" name="RequestMethodFilter">
                        <option value="">All</option>
                        <option value="GET" selected="@(Model.RequestMethodFilter == "GET")">GET</option>
                        <option value="POST" selected="@(Model.RequestMethodFilter == "POST")">POST</option>
                        <option value="PUT" selected="@(Model.RequestMethodFilter == "PUT")">PUT</option>
                        <option value="DELETE" selected="@(Model.RequestMethodFilter == "DELETE")">DELETE</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="StatusCodeFilter" app-label>Status Code</label>
                    <input type="number" app-field id="StatusCodeFilter" name="StatusCodeFilter"
                           value="@Model.StatusCodeFilter" placeholder="e.g. 200, 500" />
                </div>
                <div class="col-md-2">
                    <label for="HasError" app-label>Has Error</label>
                    <select app-field id="HasError" name="HasError">
                        <option value="">All</option>
                        <option value="true" selected="@(Model.HasError == true)">Yes</option>
                        <option value="false" selected="@(Model.HasError == false)">No</option>
                    </select>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-6">
                    <label for="RequestUriFilter" app-label>Request URI Contains</label>
                    <input type="text" app-field id="RequestUriFilter" name="RequestUriFilter"
                           value="@Model.RequestUriFilter" placeholder="e.g. gemini, embedding" />
                </div>
                <div class="col-md-2">
                    <label for="PageSize" app-label>Page Size</label>
                    <select app-field id="PageSize" name="PageSize">
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        <option value="200" selected="@(Model.PageSize == 200)">200</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" btn-variant="primary" class="me-2">Apply Filters</button>
                    <a asp-action="Index" btn-variant="secondary">Clear Filters</a>
                </div>
            </div>
            <input type="hidden" name="SortBy" value="@Model.SortBy" />
            <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
        </form>
    </div>
</div>

<!-- Statistics -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Total Records</h5>
                <p class="card-text display-6">@Model.TotalRecords</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Success Rate</h5>
                <p class="card-text display-6">
                    @{
                        var successCount = Model.Logs.Count(l => l.ResponseStatus >= 200 && l.ResponseStatus < 300);
                        var successRate = Model.Logs.Any() ? (int)((double)successCount / Model.Logs.Count * 100) : 0;
                    }
                    @successRate%
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Avg Duration</h5>
                <p class="card-text display-6">
                    @{
                        var avgDuration = Model.Logs.Any() && Model.Logs.Any(l => l.DurationMs.HasValue)
                            ? Model.Logs.Where(l => l.DurationMs.HasValue).Average(l => l.DurationMs.Value)
                            : 0;
                    }
                    @avgDuration.ToString("F0")ms
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Errors</h5>
                <p class="card-text display-6 text-danger">
                    @Model.Logs.Count(l => !string.IsNullOrEmpty(l.ErrorMessage))
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Logs Table -->
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                    {
                        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["RequestUriFilter"] = Model.RequestUriFilter,
                        ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                        ["HasError"] = Model.HasError?.ToString(),
                        ["RequestMethodFilter"] = Model.RequestMethodFilter,
                        ["PageSize"] = Model.PageSize.ToString(),
                        ["SortBy"] = "GemaaktOp",
                        ["SortOrder"] = Model.SortBy == "GemaaktOp" && Model.SortOrder == "desc" ? "asc" : "desc"
                    })">
                        Timestamp @(Model.SortBy == "GemaaktOp" ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                    {
                        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["RequestUriFilter"] = Model.RequestUriFilter,
                        ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                        ["HasError"] = Model.HasError?.ToString(),
                        ["RequestMethodFilter"] = Model.RequestMethodFilter,
                        ["PageSize"] = Model.PageSize.ToString(),
                        ["SortBy"] = "RequestMethod",
                        ["SortOrder"] = Model.SortBy == "RequestMethod" && Model.SortOrder == "desc" ? "asc" : "desc"
                    })">
                        Method @(Model.SortBy == "RequestMethod" ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </th>
                <th>Request URI</th>
                <th>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                    {
                        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["RequestUriFilter"] = Model.RequestUriFilter,
                        ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                        ["HasError"] = Model.HasError?.ToString(),
                        ["RequestMethodFilter"] = Model.RequestMethodFilter,
                        ["PageSize"] = Model.PageSize.ToString(),
                        ["SortBy"] = "ResponseStatus",
                        ["SortOrder"] = Model.SortBy == "ResponseStatus" && Model.SortOrder == "desc" ? "asc" : "desc"
                    })">
                        Status @(Model.SortBy == "ResponseStatus" ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                    {
                        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["RequestUriFilter"] = Model.RequestUriFilter,
                        ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                        ["HasError"] = Model.HasError?.ToString(),
                        ["RequestMethodFilter"] = Model.RequestMethodFilter,
                        ["PageSize"] = Model.PageSize.ToString(),
                        ["SortBy"] = "DurationMs",
                        ["SortOrder"] = Model.SortBy == "DurationMs" && Model.SortOrder == "desc" ? "asc" : "desc"
                    })">
                        Duration @(Model.SortBy == "DurationMs" ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </th>
                <th>Error</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr class="@(log.ResponseStatus >= 400 ? "table-danger" : log.ResponseStatus >= 300 ? "table-warning" : "")">
                    <td>@log.GemaaktOp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td><span class="badge bg-secondary">@log.RequestMethod</span></td>
                    <td>
                        <small style="max-width: 300px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                               title="@log.RequestUri">
                            @log.RequestUri
                        </small>
                    </td>
                    <td>
                        <span class="badge @(log.ResponseStatus >= 200 && log.ResponseStatus < 300 ? "bg-success" :
                                            log.ResponseStatus >= 300 && log.ResponseStatus < 400 ? "bg-warning" :
                                            log.ResponseStatus >= 400 ? "bg-danger" : "bg-secondary")">
                            @log.ResponseStatus
                        </span>
                    </td>
                    <td>@(log.DurationMs?.ToString() ?? "N/A") ms</td>
                    <td>
                        @if (!string.IsNullOrEmpty(log.ErrorMessage))
                        {
                            <span class="text-danger" title="@log.ErrorMessage">
                                @(log.ErrorMessage.Length > 50 ? log.ErrorMessage.Substring(0, 50) + "..." : log.ErrorMessage)
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@log.ID" btn-variant="info" btn-size="sm">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@await Html.PartialAsync("_Pagination", new VectorRagDemo.Models.ViewModels.PaginationViewModel
{
    CurrentPage  = Model.CurrentPage,
    TotalPages   = Model.TotalPages,
    TotalRecords = Model.TotalRecords,
    ActionName   = "Index",
    PreviousLabel = "Previous",
    NextLabel     = "Next",
    SummaryFormat = "Page {0} of {1} (Total: {2} records)",
    RouteValues  = new Dictionary<string, string?>
    {
        ["StartDate"]           = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
        ["EndDate"]             = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
        ["RequestUriFilter"]    = Model.RequestUriFilter,
        ["StatusCodeFilter"]    = Model.StatusCodeFilter?.ToString(),
        ["HasError"]            = Model.HasError?.ToString(),
        ["RequestMethodFilter"] = Model.RequestMethodFilter,
        ["PageSize"]            = Model.PageSize.ToString(),
        ["SortBy"]              = Model.SortBy,
        ["SortOrder"]           = Model.SortOrder,
    }
})

<!-- Maintenance Section -->
<div class="card mt-4">
    <div class="card-header bg-warning">
        <h5>Maintenance</h5>
    </div>
    <div class="card-body">
        <p>Delete old logs to keep the database size manageable.</p>
        <form method="post" asp-action="DeleteOlderThan" onsubmit="return confirm('Are you sure you want to delete old logs? This action cannot be undone.');">
            <div class="row">
                <div class="col-md-3">
                    <label for="days" app-label>Delete logs older than (days)</label>
                    <input type="number" app-field id="days" name="days" value="30" min="1" required />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" btn-variant="danger">Delete Old Logs</button>
                </div>
            </div>
        </form>
    </div>
</div>

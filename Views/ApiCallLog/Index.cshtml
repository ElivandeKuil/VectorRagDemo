@model VectorRagDemo.Models.ViewModels.ApiCallLogViewModel

@{
    ViewData["Title"] = "API Call Logs";
}

<h1>API Call Logs</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5>Filters</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row">
                <div class="col-md-3">
                    <label for="StartDate" class="form-label">Start Date</label>
                    <input type="datetime-local" class="form-control" id="StartDate" name="StartDate"
                           value="@(Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>
                <div class="col-md-3">
                    <label for="EndDate" class="form-label">End Date</label>
                    <input type="datetime-local" class="form-control" id="EndDate" name="EndDate"
                           value="@(Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>
                <div class="col-md-2">
                    <label for="RequestMethodFilter" class="form-label">Method</label>
                    <select class="form-control" id="RequestMethodFilter" name="RequestMethodFilter">
                        <option value="">All</option>
                        <option value="GET" selected="@(Model.RequestMethodFilter == "GET")">GET</option>
                        <option value="POST" selected="@(Model.RequestMethodFilter == "POST")">POST</option>
                        <option value="PUT" selected="@(Model.RequestMethodFilter == "PUT")">PUT</option>
                        <option value="DELETE" selected="@(Model.RequestMethodFilter == "DELETE")">DELETE</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="StatusCodeFilter" class="form-label">Status Code</label>
                    <input type="number" class="form-control" id="StatusCodeFilter" name="StatusCodeFilter"
                           value="@Model.StatusCodeFilter" placeholder="e.g. 200, 500" />
                </div>
                <div class="col-md-2">
                    <label for="HasError" class="form-label">Has Error</label>
                    <select class="form-control" id="HasError" name="HasError">
                        <option value="">All</option>
                        <option value="true" selected="@(Model.HasError == true)">Yes</option>
                        <option value="false" selected="@(Model.HasError == false)">No</option>
                    </select>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-6">
                    <label for="RequestUriFilter" class="form-label">Request URI Contains</label>
                    <input type="text" class="form-control" id="RequestUriFilter" name="RequestUriFilter"
                           value="@Model.RequestUriFilter" placeholder="e.g. gemini, embedding" />
                </div>
                <div class="col-md-2">
                    <label for="PageSize" class="form-label">Page Size</label>
                    <select class="form-control" id="PageSize" name="PageSize">
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        <option value="200" selected="@(Model.PageSize == 200)">200</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Apply Filters</button>
                    <a asp-action="Index" class="btn btn-secondary">Clear Filters</a>
                </div>
            </div>
            <input type="hidden" name="SortBy" value="@Model.SortBy" />
            <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
        </form>
    </div>
</div>

<!-- Statistics -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Total Records</h5>
                <p class="card-text display-6">@Model.TotalRecords</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Success Rate</h5>
                <p class="card-text display-6">
                    @{
                        var successCount = Model.Logs.Count(l => l.ResponseStatus >= 200 && l.ResponseStatus < 300);
                        var successRate = Model.Logs.Any() ? (int)((double)successCount / Model.Logs.Count * 100) : 0;
                    }
                    @successRate%
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Avg Duration</h5>
                <p class="card-text display-6">
                    @{
                        var avgDuration = Model.Logs.Any() && Model.Logs.Any(l => l.DurationMs.HasValue)
                            ? Model.Logs.Where(l => l.DurationMs.HasValue).Average(l => l.DurationMs.Value)
                            : 0;
                    }
                    @avgDuration.ToString("F0")ms
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Errors</h5>
                <p class="card-text display-6 text-danger">
                    @Model.Logs.Count(l => !string.IsNullOrEmpty(l.ErrorMessage))
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Logs Table -->
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                    {
                        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["RequestUriFilter"] = Model.RequestUriFilter,
                        ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                        ["HasError"] = Model.HasError?.ToString(),
                        ["RequestMethodFilter"] = Model.RequestMethodFilter,
                        ["PageSize"] = Model.PageSize.ToString(),
                        ["SortBy"] = "GemaaktOp",
                        ["SortOrder"] = Model.SortBy == "GemaaktOp" && Model.SortOrder == "desc" ? "asc" : "desc"
                    })">
                        Timestamp @(Model.SortBy == "GemaaktOp" ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                    {
                        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["RequestUriFilter"] = Model.RequestUriFilter,
                        ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                        ["HasError"] = Model.HasError?.ToString(),
                        ["RequestMethodFilter"] = Model.RequestMethodFilter,
                        ["PageSize"] = Model.PageSize.ToString(),
                        ["SortBy"] = "RequestMethod",
                        ["SortOrder"] = Model.SortBy == "RequestMethod" && Model.SortOrder == "desc" ? "asc" : "desc"
                    })">
                        Method @(Model.SortBy == "RequestMethod" ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </th>
                <th>Request URI</th>
                <th>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                    {
                        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["RequestUriFilter"] = Model.RequestUriFilter,
                        ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                        ["HasError"] = Model.HasError?.ToString(),
                        ["RequestMethodFilter"] = Model.RequestMethodFilter,
                        ["PageSize"] = Model.PageSize.ToString(),
                        ["SortBy"] = "ResponseStatus",
                        ["SortOrder"] = Model.SortBy == "ResponseStatus" && Model.SortOrder == "desc" ? "asc" : "desc"
                    })">
                        Status @(Model.SortBy == "ResponseStatus" ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                    {
                        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["RequestUriFilter"] = Model.RequestUriFilter,
                        ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                        ["HasError"] = Model.HasError?.ToString(),
                        ["RequestMethodFilter"] = Model.RequestMethodFilter,
                        ["PageSize"] = Model.PageSize.ToString(),
                        ["SortBy"] = "DurationMs",
                        ["SortOrder"] = Model.SortBy == "DurationMs" && Model.SortOrder == "desc" ? "asc" : "desc"
                    })">
                        Duration @(Model.SortBy == "DurationMs" ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </th>
                <th>Error</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr class="@(log.ResponseStatus >= 400 ? "table-danger" : log.ResponseStatus >= 300 ? "table-warning" : "")">
                    <td>@log.GemaaktOp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td><span class="badge bg-secondary">@log.RequestMethod</span></td>
                    <td>
                        <small style="max-width: 300px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                               title="@log.RequestUri">
                            @log.RequestUri
                        </small>
                    </td>
                    <td>
                        <span class="badge @(log.ResponseStatus >= 200 && log.ResponseStatus < 300 ? "bg-success" :
                                            log.ResponseStatus >= 300 && log.ResponseStatus < 400 ? "bg-warning" :
                                            log.ResponseStatus >= 400 ? "bg-danger" : "bg-secondary")">
                            @log.ResponseStatus
                        </span>
                    </td>
                    <td>@(log.DurationMs?.ToString() ?? "N/A") ms</td>
                    <td>
                        @if (!string.IsNullOrEmpty(log.ErrorMessage))
                        {
                            <span class="text-danger" title="@log.ErrorMessage">
                                @(log.ErrorMessage.Length > 50 ? log.ErrorMessage.Substring(0, 50) + "..." : log.ErrorMessage)
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@log.ID" class="btn btn-sm btn-info">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                {
                    ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                    ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                    ["RequestUriFilter"] = Model.RequestUriFilter,
                    ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                    ["HasError"] = Model.HasError?.ToString(),
                    ["RequestMethodFilter"] = Model.RequestMethodFilter,
                    ["PageSize"] = Model.PageSize.ToString(),
                    ["CurrentPage"] = (Model.CurrentPage - 1).ToString(),
                    ["SortBy"] = Model.SortBy,
                    ["SortOrder"] = Model.SortOrder
                })">Previous</a>
            </li>

            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                    {
                        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        ["RequestUriFilter"] = Model.RequestUriFilter,
                        ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                        ["HasError"] = Model.HasError?.ToString(),
                        ["RequestMethodFilter"] = Model.RequestMethodFilter,
                        ["PageSize"] = Model.PageSize.ToString(),
                        ["CurrentPage"] = i.ToString(),
                        ["SortBy"] = Model.SortBy,
                        ["SortOrder"] = Model.SortOrder
                    })">@i</a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>
                {
                    ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                    ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                    ["RequestUriFilter"] = Model.RequestUriFilter,
                    ["StatusCodeFilter"] = Model.StatusCodeFilter?.ToString(),
                    ["HasError"] = Model.HasError?.ToString(),
                    ["RequestMethodFilter"] = Model.RequestMethodFilter,
                    ["PageSize"] = Model.PageSize.ToString(),
                    ["CurrentPage"] = (Model.CurrentPage + 1).ToString(),
                    ["SortBy"] = Model.SortBy,
                    ["SortOrder"] = Model.SortOrder
                })">Next</a>
            </li>
        </ul>
    </nav>
    <p class="text-center text-muted">
        Page @Model.CurrentPage of @Model.TotalPages (Total: @Model.TotalRecords records)
    </p>
}

<!-- Maintenance Section -->
<div class="card mt-4">
    <div class="card-header bg-warning">
        <h5>Maintenance</h5>
    </div>
    <div class="card-body">
        <p>Delete old logs to keep the database size manageable.</p>
        <form method="post" asp-action="DeleteOlderThan" onsubmit="return confirm('Are you sure you want to delete old logs? This action cannot be undone.');">
            <div class="row">
                <div class="col-md-3">
                    <label for="days" class="form-label">Delete logs older than (days)</label>
                    <input type="number" class="form-control" id="days" name="days" value="30" min="1" required />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-danger">Delete Old Logs</button>
                </div>
            </div>
        </form>
    </div>
</div>

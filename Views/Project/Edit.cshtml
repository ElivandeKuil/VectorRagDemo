@model VectorRagDemo.Models.Entities.Project

<div class="mb-3">
    <a asp-action="Index" btn-variant="outline-secondary" btn-size="sm" btn-icon="arrow-left" class="me-1">Terug</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.ID" method="post">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Project bewerken – @Model.Naam</h5>
        </div>
        <div class="card-body">
            <div class="row g-3" style="max-width:480px">
                <div class="col-12">
                    <label asp-for="Naam" app-label class="fw-semibold">Naam</label>
                    <input asp-for="Naam" app-field />
                    <span asp-validation-for="Naam" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="BotName" app-label class="fw-semibold">Bot naam</label>
                    <input asp-for="BotName" app-field />
                    <div class="form-text">De naam die verschijnt in de chatbot header en typindicator.</div>
                </div>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
    <div class="card shadow-sm border-warning mb-4">
        <div class="card-header bg-warning bg-opacity-10">
            <h5 class="mb-0">
                <i class="bi bi-star-fill me-2 text-warning"></i>Betaalde features
                <span class="badge bg-warning text-dark ms-2 fw-normal" style="font-size:.7em">Admin</span>
            </h5>
        </div>
        <div class="card-body d-grid gap-4">

            <div>
                <div class="form-check form-switch">
                    <input asp-for="GebruikPromptTabel" class="form-check-input" type="checkbox" role="switch" id="chk_prompttabel" />
                    <label class="form-check-label fw-semibold" for="chk_prompttabel">Gebruik geconfigureerde prompts</label>
                </div>
                <div class="form-text mt-1">
                    <strong>Aan:</strong> de technisch geconfigureerde prompttabel wordt gebruikt. De gebruiker heeft geen toegang tot de prompt-instellingenpagina.<br />
                    <strong>Uit:</strong> de gebruiker stelt zelf de prompts in via Persona, Instructies, Regels en Voorbeelden.
                </div>
            </div>

            <div>
                <div class="form-check form-switch">
                    <input asp-for="ExtraCommunicationEnabled" class="form-check-input" type="checkbox" role="switch" id="chk_extracommunication" />
                    <label class="form-check-label fw-semibold" for="chk_extracommunication">Extra communicatiekanalen inschakelen</label>
                </div>
                <div class="form-text mt-1">
                    <strong>Aan:</strong> de bot toont een doorverwijzingsknop (WhatsApp / e-mail) zodra hij een lead detecteert of vastloopt.<br />
                    <strong>Uit:</strong> doorverwijzing is uitgeschakeld, ongeacht de kanaalinstellingen in Widget instellingen.
                </div>
            </div>

            <div>
                <label class="fw-semibold mb-2 d-block">Statistieken</label>
                <div class="d-flex gap-4 flex-wrap">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="statistiekenTier" id="tier_0" value="0"
                               @(Model.StatistiekenTier == 0 ? "checked" : "") />
                        <label class="form-check-label" for="tier_0">Uitgeschakeld</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="statistiekenTier" id="tier_1" value="1"
                               @(Model.StatistiekenTier == 1 ? "checked" : "") />
                        <label class="form-check-label" for="tier_1">Basis</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="statistiekenTier" id="tier_2" value="2"
                               @(Model.StatistiekenTier == 2 ? "checked" : "") />
                        <label class="form-check-label" for="tier_2">Uitgebreid</label>
                    </div>
                </div>
                <div class="form-text mt-1">
                    <strong>Uitgeschakeld:</strong> statistiekenpagina verborgen voor gebruikers.<br />
                    <strong>Basis:</strong> gespreks- en berichtentelling, kanaalverdeling, dagtrend (30 d).<br />
                    <strong>Uitgebreid:</strong> alles van Basis plus gemiddelden, piekuren en berichtenverdeling.
                    @if (Model.ExtraCommunicationEnabled)
                    {
                        <br /><i class="bi bi-info-circle me-1"></i>@:Omdat extra communicatiekanalen zijn ingeschakeld worden ook doorverwijzingsstatistieken getoond.
                    }
                </div>
            </div>

        </div>
    </div>
    } @* end admin-only betaalde features *@

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" btn-variant="primary" btn-icon="check-lg">Opslaan</button>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Index" btn-variant="outline-secondary">Annuleren</a>
        }
        <a asp-controller="Chat" asp-action="WidgetSettings" asp-route-projectId="@Model.ID" btn-variant="outline-primary" btn-icon="sliders">Widget instellingen</a>
        @if (!Model.GebruikPromptTabel)
        {
            <a asp-controller="PromptInstelling" asp-action="Edit" asp-route-projectId="@Model.ID" btn-variant="outline-secondary" btn-icon="pencil-square">Prompt instellingen</a>
        }
        @if (Model.StatistiekenTier > 0)
        {
            <a asp-controller="Statistieken" asp-action="Index" asp-route-projectId="@Model.ID" btn-variant="outline-success" btn-icon="bar-chart-line">Statistieken</a>
        }
    </div>

</form>

@{
    bool isDevProject = Model.ProductieProjectId.HasValue;
    bool isProdProject = ViewBag.DevProjectNaam != null;
}

<div class="card shadow-sm border-secondary mt-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Omgevingen
            @if (isDevProject)
            {
                <span class="badge bg-primary ms-2 fw-normal" style="font-size:.7em">Ontwikkeling</span>
            }
            else if (isProdProject)
            {
                <span class="badge bg-success ms-2 fw-normal" style="font-size:.7em">Productie</span>
            }
        </h5>
    </div>
    <div class="card-body">
        @if (isProdProject)
        {
            <p class="mb-0 text-muted small">
                <i class="bi bi-info-circle me-1"></i>Dit project is de productieomgeving van <strong>@ViewBag.DevProjectNaam</strong>.
                Het wordt gevuld via de kloonactie in dat project.
            </p>
        }
        else if (isDevProject)
        {
            <p class="small text-muted mb-3">
                Dit is een <strong>ontwikkelproject</strong>. De widget-sleutel bevindt zich op het gekoppelde productieproject.
                Gebruik de kloonknop om alle bronnen en kennis naar productie te kopiëren.
            </p>
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="fw-semibold">Productieomgeving:</span>
                <span class="badge bg-success fs-6">@ViewBag.ProductieProjectNaam</span>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <form asp-action="CloneNaarProductie" asp-route-id="@Model.ID" method="post"
                      onsubmit="return confirm('Weet u zeker dat u alle kennis wilt kopiëren naar productie? De bestaande kennis in het productieproject wordt vervangen.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" btn-variant="success" btn-icon="arrow-up-circle">Kloon naar productie</button>
                </form>
                @if (User.IsInRole("Admin"))
                {
                    <form asp-action="UnlinkProductieProject" asp-route-id="@Model.ID" method="post"
                          onsubmit="return confirm('Weet u zeker dat u de koppeling met het productieproject wilt verwijderen?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" btn-variant="outline-danger" btn-size="sm" btn-icon="x-lg">Ontkoppelen</button>
                    </form>
                }
            </div>
        }
        else if (User.IsInRole("Admin"))
        {
            <p class="small text-muted mb-3">
                Koppel een productieproject aan dit project om een aparte ontwikkel- en productieomgeving te hebben.
                De widget-sleutel blijft op het productieproject; kennis kloon je vanuit het ontwikkelproject.
            </p>
            <form asp-action="LinkProductieProject" asp-route-id="@Model.ID" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                @Html.AntiForgeryToken()
                <div>
                    <label class="form-label fw-semibold small mb-1">Productieproject</label>
                    <select name="productieProjectId" app-field style="min-width:220px">
                        <option value="">— Selecteer project —</option>
                        @foreach (var p in (List<VectorRagDemo.Models.Entities.Project>)ViewBag.BeschikbareProductieProjecten)
                        {
                            <option value="@p.ID">@p.Naam</option>
                        }
                    </select>
                </div>
                <button type="submit" btn-variant="primary" btn-icon="link-45deg">Koppelen</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.EmbedKey) && !isDevProject)
{
    var embedSnippet = $"<script src=\"{Context.Request.Scheme}://{Context.Request.Host}/js/widget-loader.js?key={Model.EmbedKey}\" defer></script>";
    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-code-slash me-2"></i>Chat widget insluiten</h5>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                Plak dit stukje HTML in de <code>&lt;head&gt;</code> of onderaan de <code>&lt;body&gt;</code> van uw website.
                Een chatknop verschijnt rechtsonder in uw pagina.
            </p>

            <div class="mb-3">
                <label app-label class="fw-semibold">Embed-code</label>
                <div class="input-group">
                    <input type="text" id="embedSnippet" app-field class="font-monospace small" readonly
                           value="@embedSnippet" />
                    <button btn-variant="outline-secondary" type="button" onclick="copyEmbedSnippet()" title="Kopiëren">
                        <i class="bi bi-clipboard" id="copyIcon"></i>
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label app-label class="fw-semibold">Embed-sleutel</label>
                <div class="input-group">
                    <input type="password" id="embedKeyField" app-field class="font-monospace small" readonly
                           value="@Model.EmbedKey" />
                    <button btn-variant="outline-secondary" type="button" onclick="toggleEmbedKey()" title="Tonen/verbergen">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
                <div class="form-text text-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>Houd deze sleutel geheim. Iedereen met deze sleutel kan de chatbot embedden.
                </div>
            </div>

            <form asp-action="RegenerateEmbedKey" asp-route-id="@Model.ID" method="post"
                  onsubmit="return confirm('Weet u zeker dat u de embed-sleutel wilt vervangen? De huidige embed-code op externe websites werkt dan niet meer.');">
                @Html.AntiForgeryToken()
                <button type="submit" btn-variant="outline-danger" btn-size="sm" btn-icon="arrow-clockwise" class="me-1">Sleutel vervangen</button>
            </form>
        </div>
    </div>

    <script>
        function copyEmbedSnippet() {
            var input = document.getElementById('embedSnippet');
            navigator.clipboard.writeText(input.value).then(function () {
                var icon = document.getElementById('copyIcon');
                icon.className = 'bi bi-check2';
                setTimeout(function () { icon.className = 'bi bi-clipboard'; }, 2000);
            });
        }
        function toggleEmbedKey() {
            var field = document.getElementById('embedKeyField');
            var icon = document.getElementById('eyeIcon');
            if (field.type === 'password') {
                field.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                field.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}

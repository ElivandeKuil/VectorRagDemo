@model VectorRagDemo.Models.Entities.Project

<div class="mb-3">
    <a asp-action="Index" btn-variant="outline-secondary" btn-size="sm" btn-icon="arrow-left" class="me-1">Terug</a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Project bewerken – @Model.Naam</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.ID" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3" style="max-width:480px">
                <div class="col-12">
                    <label asp-for="Naam" class="form-label fw-semibold">Naam</label>
                    <input asp-for="Naam" class="form-control" />
                    <span asp-validation-for="Naam" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="BotName" class="form-label fw-semibold">Bot naam</label>
                    <input asp-for="BotName" class="form-control" />
                    <div class="form-text">De naam die verschijnt in de chatbot header en typindicator.</div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" btn-variant="primary" btn-icon="check-lg" class="me-1">Opslaan</button>
                <a asp-action="Index" btn-variant="outline-secondary">Annuleren</a>
                <a asp-controller="Chat" asp-action="WidgetSettings" asp-route-projectId="@Model.ID" btn-variant="outline-primary" btn-icon="sliders" class="me-1">Widget instellingen</a>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.EmbedKey))
{
    var embedSnippet = $"<script src=\"{Context.Request.Scheme}://{Context.Request.Host}/js/widget-loader.js?key={Model.EmbedKey}\" defer></script>";
    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-code-slash me-2"></i>Chat widget insluiten</h5>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                Plak dit stukje HTML in de <code>&lt;head&gt;</code> of onderaan de <code>&lt;body&gt;</code> van uw website.
                Een chatknop verschijnt rechtsonder in uw pagina.
            </p>

            <div class="mb-3">
                <label class="form-label fw-semibold">Embed-code</label>
                <div class="input-group">
                    <input type="text" id="embedSnippet" class="form-control font-monospace small" readonly
                           value="@embedSnippet" />
                    <button btn-variant="outline-secondary" type="button" onclick="copyEmbedSnippet()" title="Kopiëren">
                        <i class="bi bi-clipboard" id="copyIcon"></i>
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Embed-sleutel</label>
                <div class="input-group">
                    <input type="password" id="embedKeyField" class="form-control font-monospace small" readonly
                           value="@Model.EmbedKey" />
                    <button btn-variant="outline-secondary" type="button" onclick="toggleEmbedKey()" title="Tonen/verbergen">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
                <div class="form-text text-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>Houd deze sleutel geheim. Iedereen met deze sleutel kan de chatbot embedden.
                </div>
            </div>

            <form asp-action="RegenerateEmbedKey" asp-route-id="@Model.ID" method="post"
                  onsubmit="return confirm('Weet u zeker dat u de embed-sleutel wilt vervangen? De huidige embed-code op externe websites werkt dan niet meer.');">
                @Html.AntiForgeryToken()
                <button type="submit" btn-variant="outline-danger" btn-size="sm" btn-icon="arrow-clockwise" class="me-1">Sleutel vervangen</button>
            </form>
        </div>
    </div>

    <script>
        function copyEmbedSnippet() {
            var input = document.getElementById('embedSnippet');
            navigator.clipboard.writeText(input.value).then(function () {
                var icon = document.getElementById('copyIcon');
                icon.className = 'bi bi-check2';
                setTimeout(function () { icon.className = 'bi bi-clipboard'; }, 2000);
            });
        }
        function toggleEmbedKey() {
            var field = document.getElementById('embedKeyField');
            var icon = document.getElementById('eyeIcon');
            if (field.type === 'password') {
                field.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                field.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}

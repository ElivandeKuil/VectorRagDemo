@model VectorRagDemo.Models.Entities.Project

<div class="mb-3">
    <a asp-action="Index" btn-variant="outline-secondary" btn-size="sm" btn-icon="arrow-left" class="me-1">Terug</a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-folder-plus me-2"></i>Nieuw project aanmaken</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3" style="max-width:480px">
                <div class="col-12">
                    <label asp-for="Naam" app-label class="fw-semibold">Naam</label>
                    <input asp-for="Naam" app-field autofocus />
                    <span asp-validation-for="Naam" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="BotName" app-label class="fw-semibold">Bot naam</label>
                    <input asp-for="BotName" app-field />
                    <div class="form-text">De naam die verschijnt in de chatbot header en typindicator.</div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" btn-variant="primary" btn-icon="check-lg" class="me-1">Aanmaken</button>
                <a asp-action="Index" btn-variant="outline-secondary">Annuleren</a>
            </div>
        </form>
    </div>
</div>

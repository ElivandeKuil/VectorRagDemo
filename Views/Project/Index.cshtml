@model List<VectorRagDemo.Models.Entities.Project>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0"><i class="bi bi-folder2 me-2"></i>Projecten</h1>
    <a asp-action="Create" btn-variant="primary" btn-icon="plus-lg" class="me-1">Nieuw project</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-folder2 display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">Nog geen projecten aangemaakt</h4>
        <a asp-action="Create" btn-variant="primary" btn-icon="plus-lg" class="me-1 mt-3">Nieuw project</a>
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Naam</th>
                <th>Bot naam</th>
                <th>Aangemaakt</th>
                <th>Status</th>
                <th class="text-end">Acties</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr class="@(p.Status == 0 ? "text-muted" : "")">
                    <td class="fw-semibold">@p.Naam</td>
                    <td>@p.BotName</td>
                    <td class="small text-muted">@p.GemaaktOp.ToString("dd-MM-yyyy")</td>
                    <td>
                        @if (p.Status == 1)
                        {
                            <span class="badge bg-success">Actief</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactief</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@p.ID" btn-variant="outline-secondary" btn-size="sm" btn-icon="pencil" class="me-1" title="Bewerken"></a>
                        <form asp-action="ToggleStatus" asp-route-id="@p.ID" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(p.Status == 1 ? "btn-outline-warning" : "btn-outline-success")"
                                    title="@(p.Status == 1 ? "Deactiveren" : "Activeren")">
                                <i class="bi @(p.Status == 1 ? "bi-toggle-on" : "bi-toggle-off")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

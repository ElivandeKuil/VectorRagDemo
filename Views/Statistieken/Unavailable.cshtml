@{
    ViewData["Title"] = "Statistieken niet beschikbaar";
    var projectName = ViewData["ProjectName"] as string ?? "dit project";
}

<div class="card shadow-sm border-0" style="max-width:500px; margin:2rem auto;">
    <div class="card-body text-center py-5">
        <i class="bi bi-bar-chart-line text-muted" style="font-size:3rem;"></i>
        <h5 class="mt-3">Statistieken niet ingeschakeld</h5>
        <p class="text-muted">De statistiekenpagina is niet beschikbaar voor <strong>@projectName</strong>.</p>
        @if (User.IsInRole("Admin"))
        {
            <p class="text-muted small">Schakel statistieken in via <strong>Projecten → Bewerken → Statistieken</strong>.</p>
        }
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary mt-2">
            <i class="bi bi-arrow-left me-1"></i>Terug naar dashboard
        </a>
    </div>
</div>

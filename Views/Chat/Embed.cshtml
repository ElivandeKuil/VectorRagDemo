@model VectorRagDemo.Models.ViewModels.EmbedViewModel
@{
    Layout = "_WidgetLayout";
    var cfg = Model.WidgetConfig;
}

@section Styles {
<style>
    body { font-size: @Model.FontSizeCss; }
    .message.user {
        background: @cfg.UserBubbleBgColor !important;
        color: @cfg.UserBubbleTextColor !important;
    }
    .message.assistant {
        background: @cfg.BotBubbleBgColor !important;
        color: @cfg.BotBubbleTextColor !important;
    }
    .chat-messages { background: @cfg.ChatBodyBgColor !important; }
    .chat-input-container { background: @cfg.InputAreaBgColor !important; }
    .chat-input-container .btn-primary {
        background-color: @cfg.SendButtonColor !important;
        border-color: @cfg.SendButtonColor !important;
        color: @cfg.SendButtonIconColor !important;
    }
</style>
}

<div class="chat-container"
     data-ask-url="@Url.Action("AskEmbed", "Chat")?key=@Model.EmbedKey"
     data-stream-url="@Url.Action("AskEmbedStream", "Chat")?key=@Model.EmbedKey"
     data-streaming="@(Model.StreamingEnabled ? "true" : "false")"
     data-bot-name="@Model.BotName"
     data-project-id="@Model.ProjectId">

    <div class="widget-header d-flex align-items-center px-3 py-2 border-bottom" style="background:@cfg.HeaderBgColor; color:@cfg.HeaderTextColor; flex-shrink:0;">
        @if (!string.IsNullOrWhiteSpace(cfg.HeaderLogoUrl))
        {
            <img src="@cfg.HeaderLogoUrl" alt="Logo" style="height:24px; width:auto; margin-right:8px; border-radius:4px; object-fit:contain;" />
        }
        else
        {
            <i class="bi bi-stars me-2"></i>
        }
        <span class="fw-semibold">@(!string.IsNullOrWhiteSpace(cfg.HeaderTitle) ? cfg.HeaderTitle : Model.BotName)</span>
    </div>

    <div class="chat-messages" id="chatMessages">
        <div class="message assistant">
            @cfg.GreetingMessage
        </div>
        <div id="chatHistory" style="display:none;">[]</div>
        <div id="retrievedChunks" style="display:none;">[]</div>
        <div id="conversationId" style="display:none;">0</div>
    </div>

    <div class="loading-spinner" id="loadingSpinner" style="display:none;">
        <div class="typing-indicator">
            <div class="typing-avatar">@Model.BotName[0]</div>
            <div class="typing-message">
                <span class="typing-text">@Model.BotName is typing</span>
                <div class="typing-dots">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="chat-input-container">
        <textarea class="form-control" id="userInput" rows="2" placeholder="Stel uw vraag..." onkeydown="handleKeyPress(event)"></textarea>
        <button btn-variant="primary" btn-icon="send" id="sendButton" onclick="sendMessage()"></button>
    </div>
</div>

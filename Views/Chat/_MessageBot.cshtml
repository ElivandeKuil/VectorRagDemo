@model VectorRagDemo.Models.DataContracts.ChatMessage

@{
    var botName = ViewData["BotName"] as string ?? "Assistant";
}

<div class="message assistant">
    <div class="message-header">
        <div class="message-role">
            <i class="bi bi-robot"></i> @botName
        </div>
        <div class="message-timestamp">@Model.Timestamp.ToString("HH:mm")</div>
    </div>
    <div class="message-content markdown-content" data-markdown='@System.Text.Json.JsonSerializer.Serialize(Model.Content ?? "")'></div>

    @if (Model.SourceLinks != null && Model.SourceLinks.Any())
    {
        <div class="source-links mt-2">
            @foreach (var link in Model.SourceLinks)
            {
                var p = link.Preview;
                var host = Uri.TryCreate(link.Url, UriKind.Absolute, out var uri) ? uri.Host : link.Url;
                var displayTitle = p != null && !string.IsNullOrWhiteSpace(p.Title) ? p.Title : host;
                <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="link-preview-card">
                    @if (p != null && !string.IsNullOrWhiteSpace(p.ImageUrl))
                    {
                        <div class="lpc-image">
                            <img src="@p.ImageUrl" alt="" onerror="this.parentElement.style.display='none'">
                        </div>
                    }
                    <div class="lpc-body">
                        <div class="lpc-site">
                            @if (p != null && !string.IsNullOrWhiteSpace(p.FaviconUrl))
                            {
                                <img src="@p.FaviconUrl" alt="" class="lpc-favicon" onerror="this.style.display='none'">
                            }
                            <span>@(p?.SiteName ?? host)</span>
                        </div>
                        <div class="lpc-title">@displayTitle</div>
                        @if (p != null && !string.IsNullOrWhiteSpace(p.Description))
                        {
                            <div class="lpc-description">@p.Description</div>
                        }
                    </div>
                </a>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.RedirectUrl))
    {
        <div class="link-preview">
            <a href="@Model.RedirectUrl" target="_blank" rel="noopener noreferrer" class="link-preview-link">
                <div class="link-preview-thumbnail">
                    <i class="bi bi-link-45deg link-preview-icon"></i>
                </div>
                <div class="link-preview-content">
                    <div class="link-preview-title">
                        <i class="bi bi-arrow-up-right-square"></i>
                        <span>View External Resource</span>
                    </div>
                    <div class="link-preview-url">
                        <i class="bi bi-box-arrow-up-right"></i>
                        @Model.RedirectUrl
                    </div>
                </div>
            </a>
        </div>
    }

    @{
        var showWhatsApp = !string.IsNullOrWhiteSpace(Model.WhatsAppUrl);
        var showEmail    = !string.IsNullOrWhiteSpace(Model.EmailUrl);
    }
    @if (showWhatsApp || showEmail)
    {
        <div class="escalation-cta mt-2">
            <p class="escalation-cta-text">
                <i class="bi bi-person-lines-fill me-1"></i>
                @(Model.WhatsAppCtaText ?? Model.EmailCtaText ?? "Neem gelijk contact op met mijn collega")
            </p>
            <div class="escalation-cta-buttons">
                @if (showWhatsApp)
                {
                    <a href="@Model.WhatsAppUrl" target="_blank" rel="noopener noreferrer" class="whatsapp-cta-btn" data-log-escalation="whatsapp">
                        <svg class="cta-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.558 4.17 1.535 5.943L.055 23.454a.75.75 0 0 0 .918.918l5.538-1.475A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.853 0-3.628-.497-5.163-1.367l-.37-.214-3.835 1.022 1.032-3.764-.228-.376A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                        </svg>
                        @(Model.WhatsAppButtonText ?? "Chat via WhatsApp")
                    </a>
                }
                @if (showEmail)
                {
                    <a href="@Model.EmailUrl" class="email-cta-btn" data-log-escalation="email">
                        <i class="bi bi-envelope-fill cta-btn-icon"></i>
                        @(Model.EmailButtonText ?? "Stuur een e-mail")
                    </a>
                }
            </div>
        </div>
    }

</div>

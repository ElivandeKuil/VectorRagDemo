@model VectorRagDemo.Models.DataContracts.ChatMessage

@{
    var botName = ViewData["BotName"] as string ?? "Assistant";
}

<div class="message assistant">
    <div class="message-header">
        <div class="message-role">
            <i class="bi bi-robot"></i> @botName
        </div>
        <div class="message-timestamp">@Model.Timestamp.ToString("HH:mm")</div>
    </div>
    <div class="message-content markdown-content" data-markdown='@System.Text.Json.JsonSerializer.Serialize(Model.Content ?? "")'></div>

    @if (Model.SourceLinks != null && Model.SourceLinks.Any())
    {
        <div class="source-links mt-2">
            <div class="source-links-label"><i class="bi bi-journals me-1"></i>Bronnen</div>
            @foreach (var link in Model.SourceLinks)
            {
                <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="source-link-item">
                    <i class="bi bi-link-45deg"></i>
                    <span class="source-link-title">@link.Title</span>
                    <i class="bi bi-box-arrow-up-right ms-auto"></i>
                </a>
            }
        </div>
    }
    else if (Model.LinkPreview != null)
    {
        <div class="link-preview">
            <a href="@Model.LinkPreview.Url" target="_blank" rel="noopener noreferrer" class="link-preview-link">
                @if (!string.IsNullOrWhiteSpace(Model.LinkPreview.ImageUrl))
                {
                    <div class="link-preview-image">
                        <img src="@Model.LinkPreview.ImageUrl" alt="@Model.LinkPreview.Title" onerror="this.parentElement.innerHTML='<i class=\'bi bi-link-45deg link-preview-fallback-icon\'></i>'">
                    </div>
                }
                else
                {
                    <div class="link-preview-thumbnail">
                        <i class="bi bi-link-45deg link-preview-icon"></i>
                    </div>
                }
                <div class="link-preview-content">
                    <div class="link-preview-header">
                        @if (!string.IsNullOrWhiteSpace(Model.LinkPreview.FaviconUrl))
                        {
                            <img src="@Model.LinkPreview.FaviconUrl" alt="" class="link-preview-favicon" onerror="this.style.display='none'">
                        }
                        <span class="link-preview-site-name">@(Model.LinkPreview.SiteName ?? new Uri(Model.LinkPreview.Url).Host)</span>
                    </div>
                    <div class="link-preview-title">@Model.LinkPreview.Title</div>
                    @if (!string.IsNullOrWhiteSpace(Model.LinkPreview.Description))
                    {
                        <div class="link-preview-description">@Model.LinkPreview.Description</div>
                    }
                    <div class="link-preview-url">
                        <i class="bi bi-box-arrow-up-right"></i>
                        @Model.LinkPreview.Url
                    </div>
                </div>
            </a>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.RedirectUrl))
    {
        <div class="link-preview">
            <a href="@Model.RedirectUrl" target="_blank" rel="noopener noreferrer" class="link-preview-link">
                <div class="link-preview-thumbnail">
                    <i class="bi bi-link-45deg link-preview-icon"></i>
                </div>
                <div class="link-preview-content">
                    <div class="link-preview-title">
                        <i class="bi bi-arrow-up-right-square"></i>
                        <span>View External Resource</span>
                    </div>
                    <div class="link-preview-url">
                        <i class="bi bi-box-arrow-up-right"></i>
                        @Model.RedirectUrl
                    </div>
                </div>
            </a>
        </div>
    }

</div>

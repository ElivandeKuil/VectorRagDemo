@model VectorRagDemo.Models.DataContracts.ChatMessage

<div class="message assistant">
    <div class="message-role">Assistant</div>
    <div>@Model.Content</div>

    @if (!string.IsNullOrWhiteSpace(Model.Context) && Model.Context != "No source text used.")
    {
        <div class="sources-section">
            <div class="sources-title">📚 Sources:</div>
            <div class="sources-content">@Model.Context</div>
        </div>
    }
</div>

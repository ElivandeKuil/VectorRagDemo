@model VectorRagDemo.Models.DataContracts.ChatMessage

@{
    var botName      = ViewData["BotName"] as string ?? "Assistant";
    var showWhatsApp = !string.IsNullOrWhiteSpace(Model.WhatsAppUrl);
    var showEmail    = !string.IsNullOrWhiteSpace(Model.EmailUrl);
    var hasLinks     = Model.SourceLinks != null && Model.SourceLinks.Any();
    var hasRedirect  = !string.IsNullOrWhiteSpace(Model.RedirectUrl);
}

<div class="message assistant">
    <div class="message-header">
        <div class="message-role">
            <i class="bi bi-robot"></i> @botName
        </div>
        <div class="message-timestamp">@Model.Timestamp.ToString("HH:mm")</div>
    </div>
    <div class="message-content markdown-content" data-markdown='@System.Text.Json.JsonSerializer.Serialize(Model.Content ?? "")'></div>

    @if (hasLinks)
    {
        var links = Model.SourceLinks!;
        var first = links.First();
        var rest  = links.Skip(1).ToList();
        var fp    = first.Preview;
        var fHost = Uri.TryCreate(first.Url, UriKind.Absolute, out var fUri) ? fUri.Host : first.Url;
        var fTitle = (fp != null && !string.IsNullOrWhiteSpace(fp.Title)) ? fp.Title : fHost;
        var fSite  = fp?.SiteName ?? fHost;

        <div class="source-links-section">
            <a href="@first.Url" target="_blank" rel="noopener noreferrer" class="source-card" title="@fTitle">
                <div class="source-card-meta">
                    @if (fp != null && !string.IsNullOrWhiteSpace(fp.FaviconUrl))
                    {
                        <img src="@fp.FaviconUrl" alt="" class="source-card-favicon" onerror="this.style.display='none'">
                    }
                    else
                    {
                        <i class="bi bi-globe2 source-card-globe"></i>
                    }
                    <span class="source-card-site">@fSite</span>
                </div>
                <div class="source-card-title">@fTitle</div>
                @if (fp != null && !string.IsNullOrWhiteSpace(fp.Description))
                {
                    <div class="source-card-desc">@fp.Description</div>
                }
            </a>
            @if (rest.Any())
            {
                <button class="source-links-toggle" type="button"
                        onclick="var x=this.nextElementSibling;x.hidden=!x.hidden;this.classList.toggle('open')">
                    <i class="bi bi-chevron-down"></i>
                    +@rest.Count @(rest.Count == 1 ? "bron" : "bronnen")
                </button>
                <div class="source-links-extra" hidden>
                    @foreach (var link in rest)
                    {
                        var p     = link.Preview;
                        var host  = Uri.TryCreate(link.Url, UriKind.Absolute, out var lUri) ? lUri.Host : link.Url;
                        var label = p?.SiteName ?? ((p != null && !string.IsNullOrWhiteSpace(p.Title)) ? p.Title : host);
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="source-chip" title="@(p?.Title ?? link.Url)">
                            @if (p != null && !string.IsNullOrWhiteSpace(p.FaviconUrl))
                            {
                                <img src="@p.FaviconUrl" alt="" class="source-chip-favicon" onerror="this.style.display='none'">
                            }
                            else
                            {
                                <i class="bi bi-link-45deg"></i>
                            }
                            <span>@label</span>
                        </a>
                    }
                </div>
            }
        </div>
    }
    else if (hasRedirect)
    {
        var rHost = Uri.TryCreate(Model.RedirectUrl, UriKind.Absolute, out var rUri) ? rUri.Host : Model.RedirectUrl;
        <div class="source-links-section">
            <a href="@Model.RedirectUrl" target="_blank" rel="noopener noreferrer" class="source-card" title="@Model.RedirectUrl">
                <div class="source-card-meta">
                    <i class="bi bi-globe2 source-card-globe"></i>
                    <span class="source-card-site">@rHost</span>
                </div>
            </a>
        </div>
    }
</div>

@if (showWhatsApp || showEmail)
{
    <div class="message assistant escalation-bubble">
        <span class="escalation-label">
            <i class="bi bi-person-lines-fill"></i>
            @(Model.WhatsAppCtaText ?? Model.EmailCtaText ?? "Neem contact op met mijn collega")
        </span>
        <div class="escalation-btns">
            @if (showWhatsApp)
            {
                <a href="@Model.WhatsAppUrl" target="_blank" rel="noopener noreferrer" class="whatsapp-cta-btn" data-log-escalation="whatsapp">
                    <svg class="cta-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.558 4.17 1.535 5.943L.055 23.454a.75.75 0 0 0 .918.918l5.538-1.475A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.853 0-3.628-.497-5.163-1.367l-.37-.214-3.835 1.022 1.032-3.764-.228-.376A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                    </svg>
                    @(Model.WhatsAppButtonText ?? "Chat via WhatsApp")
                </a>
            }
            @if (showEmail)
            {
                <a href="@Model.EmailUrl" class="email-cta-btn" data-log-escalation="email">
                    <i class="bi bi-envelope-fill cta-btn-icon"></i>
                    @(Model.EmailButtonText ?? "Stuur een e-mail")
                </a>
            }
        </div>
    </div>
}

@model VectorRagDemo.Models.DataContracts.ChatMessage

<div class="message assistant">
    <div class="message-header">
        <div class="message-role">Assistant</div>
        <div class="message-timestamp">@Model.Timestamp.ToString("HH:mm")</div>
    </div>
    <div class="message-content">@Model.Content</div>

    @if (!string.IsNullOrWhiteSpace(Model.Context) && Model.Context != "No source text used.")
    {
        <div class="sources-section">
            <button class="sources-toggle" onclick="toggleSources(this)">
                <i class="bi bi-book"></i> Show Sources
                <i class="bi bi-chevron-down toggle-icon"></i>
            </button>
            <div class="sources-content collapsed">@Model.Context</div>
        </div>
    }
</div>

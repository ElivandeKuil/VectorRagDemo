@model VectorRagDemo.Models.ViewModels.ChatPanelViewModel
@using System.Text.Json

@foreach (var message in Model.Messages)
{
    if (message.IsResponse)
    {
        @await Html.PartialAsync("_MessageBot", message)
    }
    else
    {
        @await Html.PartialAsync("_MessageUser", message)
    }
}

<div id="chatHistory" style="display:none;">@Html.Raw(JsonSerializer.Serialize(Model.Messages))</div>
<div id="retrievedChunks" style="display:none;">@Html.Raw(JsonSerializer.Serialize(Model.RetrievedChunks))</div>

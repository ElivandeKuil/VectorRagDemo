@model VectorRagDemo.Models.Entities.Project

<h2 class="mb-4">Chat Settings</h2>

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <input type="hidden" name="id" value="@Model.ID" />
            <div class="mb-3">
                <label class="form-label">Bot name</label>
                <input type="text" class="form-control" name="botName" value="@Model.BotName" maxlength="50" required />
                <div class="form-text">This name appears in the chat header and typing indicator.</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="@Url.Action("Index", "Chat")" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@{
    ViewData["Title"] = "RAG Chatbot";
}

<style>
    .chat-container {
        max-width: 900px;
        margin: 0 auto;
    }
    .chat-messages {
        height: 500px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 20px;
        background-color: #f8f9fa;
        margin-bottom: 20px;
    }
    .message {
        margin-bottom: 15px;
        padding: 12px 16px;
        border-radius: 8px;
        max-width: 80%;
        word-wrap: break-word;
    }
    .message.user {
        background-color: #007bff;
        color: white;
        margin-left: auto;
        text-align: right;
    }
    .message.assistant {
        background-color: white;
        color: #333;
        border: 1px solid #dee2e6;
    }
    .message-role {
        font-weight: bold;
        font-size: 0.85em;
        margin-bottom: 5px;
        opacity: 0.8;
    }
    .sources-section {
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid #dee2e6;
        font-size: 0.9em;
    }
    .sources-title {
        font-weight: bold;
        color: #6c757d;
        margin-bottom: 5px;
    }
    .sources-content {
        background-color: #f8f9fa;
        padding: 8px;
        border-radius: 4px;
        white-space: pre-wrap;
        max-height: 200px;
        overflow-y: auto;
    }
    .loading-spinner {
        display: none;
        text-align: center;
        padding: 20px;
    }
    .chat-input-container {
        display: flex;
        gap: 10px;
    }
    .chat-input-container textarea {
        flex: 1;
    }
</style>

<div class="chat-container">
    <h1 class="mb-4">RAG Chatbot</h1>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">How it works</h5>
            <p class="card-text mb-0">
                This chatbot uses Retrieval-Augmented Generation (RAG). When you ask a question:
            </p>
            <ol class="mb-0">
                <li>Your question is converted to a 768D vector embedding</li>
                <li>The system finds the most similar chunks from the knowledge base</li>
                <li>Gemini AI generates an answer using those chunks as context</li>
                <li>Sources are shown so you can verify the information</li>
            </ol>
        </div>
    </div>

    <div class="chat-messages" id="chatMessages">
        <div class="message assistant">
            Welcome! Ask me anything about the knowledge base.
        </div>
    </div>

    <div class="loading-spinner" id="loadingSpinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Processing your question...</p>
    </div>

    <div class="chat-input-container">
        <textarea class="form-control" id="userInput" rows="3" placeholder="Type your question here..." onkeydown="handleKeyPress(event)"></textarea>
        <button class="btn btn-primary" id="sendButton" onclick="sendMessage()">
            <i class="bi bi-send"></i> Send
        </button>
    </div>

    <div class="mt-2">
        <button class="btn btn-sm btn-outline-secondary" onclick="clearChat()">
            <i class="bi bi-trash"></i> Clear Chat
        </button>
    </div>
</div>

@section Scripts {
<script>
    let chatHistory = [];

    function handleKeyPress(event) {
        // Send on Ctrl+Enter or Cmd+Enter
        if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
            event.preventDefault();
            sendMessage();
        }
    }

    async function sendMessage() {
        const input = document.getElementById('userInput');
        const query = input.value.trim();

        if (!query) {
            return;
        }

        // Add user message to chat
        addMessage('user', query);

        // Clear input
        input.value = '';

        // Show loading spinner
        document.getElementById('loadingSpinner').style.display = 'block';
        document.getElementById('sendButton').disabled = true;

        try {
            const response = await fetch('@Url.Action("Ask", "Chat")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    query: query,
                    history: chatHistory
                })
            });

            const data = await response.json();

            if (data.success) {
                // Add assistant response
                addMessage('assistant', data.answer, data.sources);

                // Update chat history
                chatHistory.push({ role: 'user', content: query });
                chatHistory.push({ role: 'model', content: data.answer });
            } else {
                addMessage('system', 'Error: ' + data.error);
            }
        } catch (error) {
            addMessage('system', 'Error: Failed to communicate with the server.');
            console.error('Error:', error);
        } finally {
            // Hide loading spinner
            document.getElementById('loadingSpinner').style.display = 'none';
            document.getElementById('sendButton').disabled = false;
            input.focus();
        }
    }

    function addMessage(role, content, sources = null) {
        const messagesContainer = document.getElementById('chatMessages');
        const messageDiv = document.createElement('div');
        messageDiv.className = 'message ' + role;

        let html = '';

        if (role === 'user') {
            html += '<div class="message-role">You</div>';
            html += '<div>' + escapeHtml(content) + '</div>';
        } else if (role === 'assistant') {
            html += '<div class="message-role">Assistant</div>';
            html += '<div>' + escapeHtml(content) + '</div>';

            if (sources && sources !== 'No source text used.') {
                html += '<div class="sources-section">';
                html += '<div class="sources-title">📚 Sources:</div>';
                html += '<div class="sources-content">' + escapeHtml(sources) + '</div>';
                html += '</div>';
            }
        } else {
            html += content;
        }

        messageDiv.innerHTML = html;
        messagesContainer.appendChild(messageDiv);

        // Scroll to bottom
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function clearChat() {
        if (confirm('Are you sure you want to clear the chat history?')) {
            chatHistory = [];
            const messagesContainer = document.getElementById('chatMessages');
            messagesContainer.innerHTML = '<div class="message system">Chat cleared. Ask me anything!</div>';
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Focus input on load
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('userInput').focus();
    });
</script>
}

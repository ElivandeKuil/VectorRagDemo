@model VectorRagDemo.Models.ViewModels.ChatIndexViewModel
@{
    ViewData["Title"] = "Chat";
}

@if (Model.AdminProjects != null)
{
    <form method="get" asp-action="Index" class="mb-3">
        <div class="d-flex align-items-center gap-2">
            <label app-label class="mb-0 text-muted small">Project:</label>
            @Html.DropDownList("projectId", Model.AdminProjects,
                "— Selecteer een project —",
                new { @class = "form-select form-select-sm w-auto", onchange = "this.form.submit()" })
        </div>
    </form>
}

@if (Model.HasWidget)
{
    <div class="d-flex align-items-start justify-content-between mb-3 gap-3">
        <div>
            <h5 class="mb-1">Widget preview — <span class="text-primary">@Model.BotName</span></h5>
            <p class="text-muted small mb-0">Zo ziet de chatbot eruit voor bezoekers van uw website.</p>
        </div>
        @if (Model.HasProject)
        {
            <a href="@Url.Action("Settings", "Chat")" btn-variant="outline-secondary" btn-size="sm" btn-icon="gear" class="flex-shrink-0">Botnaam</a>
        }
    </div>

    <div class="browser-mockup">
        <div class="browser-chrome">
            <div class="browser-dots">
                <span class="browser-dot browser-dot-red"></span>
                <span class="browser-dot browser-dot-yellow"></span>
                <span class="browser-dot browser-dot-green"></span>
            </div>
            <div class="browser-addressbar">
                <i class="bi bi-lock-fill browser-lock-icon"></i>
                <span>www.uw-website.nl</span>
            </div>
            <div class="browser-actions">
                <a href="@Url.Action("WidgetSettings", "Chat", new { projectId = Model.SelectedProjectId })"
                   class="browser-action-link" title="Widget-instellingen">
                    <i class="bi bi-sliders"></i>
                </a>
            </div>
        </div>
        <div class="browser-viewport">
            <iframe src="@Url.Action("Preview", "Chat")?key=@Model.EmbedKey"
                    class="browser-preview-frame"
                    title="Websitepreview met @Model.BotName chatbot"
                    sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
        </div>
    </div>
}
else if (Model.AdminProjects != null)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-arrow-up fs-3 d-block mb-2"></i>
        Selecteer een project om de chatbot-widget te bekijken.
    </div>
}
else
{
    <div class="alert alert-warning">
        Er is nog geen project gekoppeld aan uw account. Neem contact op met een beheerder.
    </div>
}

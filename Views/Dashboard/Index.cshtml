@model VectorRagDemo.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Welkom, @Model.FullName</h2>
        <p class="text-muted mb-0">
            @if (Model.IsAdmin)
            {
                <span>Selecteer een module om te beginnen</span>
            }
            else
            {
                <span>Wat wil je vandaag doen?</span>
            }
        </p>
    </div>
</div>

@if (Model.IsAdmin)
{
    @if (!Model.ProjectCards.Any())
    {
        <div class="alert alert-info d-flex align-items-center gap-2">
            <i class="bi bi-info-circle fs-5"></i>
            <span>Er zijn nog geen projecten geconfigureerd.</span>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var item in Model.ProjectCards)
            {
                var icon = item.RouteInfo?.Icon ?? "bi-folder";
                var description = item.RouteInfo?.Description ?? item.Project.Omschrijving;
                var url = item.RouteInfo?.Url ?? "#";
                var hasUrl = url != "#";

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 @(hasUrl ? "project-card" : "")">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="project-icon bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                                    <i class="bi @icon fs-3"></i>
                                </div>
                                <div>
                                    <h5 class="card-title mb-0">@item.Project.Omschrijving</h5>
                                </div>
                            </div>
                            <p class="card-text text-muted flex-grow-1">@description</p>
                            <div class="mt-3">
                                @if (hasUrl)
                                {
                                    <a href="@url" btn-variant="primary" btn-size="sm" btn-icon="arrow-right-circle" class="me-1">Openen</a>
                                }
                                else
                                {
                                    <span class="btn btn-secondary btn-sm disabled">
                                        <i class="bi bi-clock me-1"></i>Binnenkort beschikbaar
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @if (!Model.Tiles.Any() && !Model.ShowPromptInstelling)
    {
        <div class="alert alert-info d-flex align-items-center gap-2">
            <i class="bi bi-info-circle fs-5"></i>
            <span>Er zijn nog geen modules aan uw account toegewezen. Neem contact op met de beheerder.</span>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap gap-4 mt-3">
            @foreach (var tile in Model.Tiles)
            {
                <a asp-controller="@tile.Controller"
                   asp-action="@tile.Action"
                   class="quick-tile text-decoration-none">
                    <div class="icon-wrap">
                        <i class="bi @tile.Icon"></i>
                    </div>
                    <div class="fw-semibold mt-3 text-dark">@tile.DisplayName</div>
                </a>
            }
            @if (Model.ShowPromptInstelling)
            {
                <a asp-controller="PromptInstelling" asp-action="Edit" class="quick-tile text-decoration-none">
                    <div class="icon-wrap">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div class="fw-semibold mt-3 text-dark">Prompt instellingen</div>
                </a>
            }
        </div>
    }
}

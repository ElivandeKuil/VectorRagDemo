@* Renders dismissible Bootstrap alert banners for all standard TempData keys.
   Include once in _Layout.cshtml — no need to repeat it in individual views.

   Supported keys:
     TempData["Success"]        → alert-success  (with check-circle icon)
     TempData["Error"]          → alert-danger   (with exclamation-triangle icon)
     TempData["Warning"]        → alert-warning  (with exclamation-circle icon)
     TempData["Info"]           → alert-info     (with info-circle icon)
     TempData["SuccessMessage"] → alert-success  (alias, no icon — legacy key)
     TempData["ErrorMessage"]   → alert-danger   (alias, no icon — legacy key)
*@

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
    </div>
}

@if (TempData["Warning"] != null)

@inject VectorRagDemo.Services.ProjectAccessService ProjectAccessService
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ElAI</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/" asp-append-version="true" />
</head>
<body>
<div class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-stars me-1 text-primary"></i>ElAI
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* Dashboard is always visible *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid me-1"></i>Dashboard
                            </a>
                        </li>

                        @* Nav items: admin sees all, regular users see their assigned sub-projects *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Chat" asp-action="Index">
                                    <i class="bi bi-chat-dots me-1"></i>Chat
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Scraper" asp-action="Index">
                                    <i class="bi bi-globe me-1"></i>Scraper
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Chunk" asp-action="Index">
                                    <i class="bi bi-file-earmark-text me-1"></i>Documenten
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Prompts" asp-action="Index">
                                    <i class="bi bi-chat-square-text me-1"></i>Prompts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="ApiCallLog" asp-action="Index">
                                    <i class="bi bi-journal-code me-1"></i>API Logs
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="AppLog" asp-action="Index">
                                    <i class="bi bi-terminal me-1"></i>App Logs
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Project" asp-action="Index">
                                    <i class="bi bi-folder2 me-1"></i>Projecten
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Gebruiker" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Gebruikers
                                </a>
                            </li>
                        }
                        else
                        {
                            @* Render nav items for each sub-project the user has access to,
                               in the canonical order defined by SubProjectMap. *@
                            var userSubProjects = User.Claims
                                .Where(c => c.Type == "SubProject")
                                .Select(c => c.Value)
                                .ToHashSet(StringComparer.OrdinalIgnoreCase);

                            foreach (var entry in VectorRagDemo.Services.ProjectAccessService.SubProjectMap)
                            {
                                if (userSubProjects.Contains(entry.Key))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark"
                                           asp-controller="@entry.Value.Controller"
                                           asp-action="@entry.Value.Action">
                                            <i class="bi @entry.Value.Icon me-1"></i>@entry.Value.DisplayName
                                        </a>
                                    </li>
                                }
                            }
                        }
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key me-2"></i>Wachtwoord wijzigen
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Uitloggen
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    @if (User.HasClaim("MustChangePassword", "true") &&
         ViewContext.RouteData.Values["action"]?.ToString() != "ChangePassword")
    {
        <div class="alert alert-warning rounded-0 border-0 border-bottom mb-0 py-2" role="alert">
            <div class="container d-flex align-items-center gap-2">
                <i class="bi bi-shield-exclamation flex-shrink-0"></i>
                <span class="small">U gebruikt nog een tijdelijk wachtwoord.
                    <a asp-controller="Account" asp-action="ChangePassword" class="alert-link fw-semibold">Wijzig het nu</a>
                    om uw account te beveiligen.
                </span>
            </div>
        </div>
    }

    <div class="container flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-light mt-auto py-2">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="text-muted small"><i class="bi bi-stars me-1 text-primary"></i><strong>ElAI</strong> &mdash; 2026</span>
            <span class="text-muted small">
                <i class="bi bi-envelope me-1"></i>
                <a href="mailto:info@elai.nl" class="text-muted text-decoration-none footer-link">info@elai.nl</a>
                <span class="mx-2 text-muted">·</span>
                <i class="bi bi-geo-alt me-1"></i>Nederland
            </span>
        </div>
    </footer>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/global.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .footer-link:hover { color: #212529 !important; }
</style>

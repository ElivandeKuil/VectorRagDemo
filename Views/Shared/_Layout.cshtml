<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ElAi</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-stars me-1 text-primary"></i>ElAi
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @await Component.InvokeAsync("Nav")
                </div>
            </div>
        </nav>
    </header>

    @if (User.HasClaim("MustChangePassword", "true") &&
         ViewContext.RouteData.Values["action"]?.ToString() != "ChangePassword")
    {
        <div class="alert alert-warning rounded-0 border-0 border-bottom mb-0 py-2" role="alert">
            <div class="container d-flex align-items-center gap-2">
                <i class="bi bi-shield-exclamation flex-shrink-0"></i>
                <span class="small">U gebruikt nog een tijdelijk wachtwoord.
                    <a asp-controller="Account" asp-action="ChangePassword" class="alert-link fw-semibold">Wijzig het nu</a>
                    om uw account te beveiligen.
                </span>
            </div>
        </div>
    }

    <div class="container flex-grow-1">
        <main role="main" class="pb-4">
            @await Html.PartialAsync("_Alerts")
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-light mt-auto py-2">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="text-muted small"><i class="bi bi-stars me-1 text-primary"></i><strong>ElAi</strong> &mdash; 2026</span>
            <span class="text-muted small">
                <i class="bi bi-envelope me-1"></i>
                <a href="mailto:elaistudionl@gmail.com" class="text-muted text-decoration-none footer-link">elaistudionl@gmail.com</a>
                <span class="mx-2 text-muted">·</span>
                <i class="bi bi-geo-alt me-1"></i>Nederland
                <span class="mx-2 text-muted">·</span>
                <a asp-controller="Account" asp-action="Privacyverklaring"
                   class="text-muted text-decoration-none footer-link">Privacyverklaring</a>
            </span>
        </div>
    </footer>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/global.js"></script>
@{
    var _embedKey  = ViewData["EmbedKey"] as string;
    var _widgetKey = !string.IsNullOrWhiteSpace(_embedKey) ? _embedKey : "15fe6531673345b7910afaf8deafbb96";
}
<script src="~/js/widget-loader.js" data-key="@_widgetKey" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@using VectorRagDemo.Models.ViewModels
@model PaginationViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Paginering" class="mt-3">
        <ul class="pagination justify-content-center mb-1">

            @{
                var prevRoute = new Dictionary<string, string?>(Model.RouteValues) { ["CurrentPage"] = (Model.CurrentPage - 1).ToString() };
                var nextRoute = new Dictionary<string, string?>(Model.RouteValues) { ["CurrentPage"] = (Model.CurrentPage + 1).ToString() };
            }

            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.ActionName" asp-all-route-data="@prevRoute">
                    <i class="bi bi-chevron-left"></i> @Model.PreviousLabel
                </a>
            </li>

            @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
            {
                var pageRoute = new Dictionary<string, string?>(Model.RouteValues) { ["CurrentPage"] = p.ToString() };
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="@Model.ActionName" asp-all-route-data="@pageRoute">@p</a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.ActionName" asp-all-route-data="@nextRoute">
                    @Model.NextLabel <i class="bi bi-chevron-right"></i>
                </a>
            </li>

        </ul>
    </nav>
    <p class="text-center text-muted small">
        @string.Format(Model.SummaryFormat, Model.CurrentPage, Model.TotalPages, Model.TotalRecords)
    </p>
}

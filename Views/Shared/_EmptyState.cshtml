@using VectorRagDemo.Models.ViewModels
@model EmptyStateViewModel

<div class="text-center py-5">
    <i class="bi bi-@Model.Icon display-1 text-muted"></i>
    <h4 class="mt-3 text-muted">@Model.Title</h4>

    @if (Model.Subtitle != null)
    {
        <p class="text-muted mb-4">@Model.Subtitle</p>
    }

    @if (Model.ActionUrl != null && Model.ActionLabel != null)
    {
        <a href="@Model.ActionUrl" btn-variant="primary" btn-icon="@Model.ActionIcon" class="mt-2">@Model.ActionLabel</a>
    }
</div>

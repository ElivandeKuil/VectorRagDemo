@model VectorRagDemo.Models.ViewModels.NavViewModel

@* ── Nav items ─────────────────────────────────────────────────── *@
<ul class="navbar-nav flex-grow-1">
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-grid me-1"></i>Dashboard
        </a>
    </li>

    @if (Model.IsAdmin)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Chat" asp-action="Index">
                <i class="bi bi-chat-dots me-1"></i>Chat
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Chunk" asp-action="Index">
                <i class="bi bi-file-earmark-text me-1"></i>Documenten
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Prompts" asp-action="Index">
                <i class="bi bi-chat-square-text me-1"></i>Prompts
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="ApiCallLog" asp-action="Index">
                <i class="bi bi-journal-code me-1"></i>API Logs
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="AppLog" asp-action="Index">
                <i class="bi bi-terminal me-1"></i>App Logs
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Statistieken" asp-action="Index">
                <i class="bi bi-bar-chart-line me-1"></i>Statistieken
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Conversaties" asp-action="Index">
                <i class="bi bi-chat-left-text me-1"></i>Gesprekken
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Correcties" asp-action="Index">
                <i class="bi bi-pencil-square me-1"></i>Correcties
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Project" asp-action="Index">
                <i class="bi bi-folder2 me-1"></i>Projecten
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Gebruiker" asp-action="Index">
                <i class="bi bi-people me-1"></i>Gebruikers
            </a>
        </li>
    }
    else
    {
        @foreach (var item in Model.NavItems)
        {
            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-controller="@item.Controller"
                   asp-action="@item.Action">
                    <i class="bi @item.Icon me-1"></i>@item.DisplayName
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Project" asp-action="Edit">
                <i class="bi bi-gear me-1"></i>Instellingen
            </a>
        </li>
        @if (Model.ShowPromptInstelling)
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="PromptInstelling" asp-action="Edit">
                    <i class="bi bi-pencil-square me-1"></i>Prompt instellingen
                </a>
            </li>
        }
    }
</ul>

@* ── Environment switcher + user menu ──────────────────────────── *@
@if (Model.IsAuthenticated)
{
    @if (Model.IsAdmin)
    {
        <ul class="navbar-nav me-2">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">
                    <i class="bi bi-folder2-open me-1 text-primary"></i>@Model.ActiveProjectName
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    @foreach (var proj in Model.AllProjects)
                    {
                        <li>
                            <a class="dropdown-item @(proj.ID == Model.ActiveProjectId ? "active" : "")"
                               href="@Url.Action("Switch", "Omgeving", new { projectId = proj.ID, returnUrl = Model.SwitchReturnUrl })">
                                @if (proj.IsDev)
                                {
                                    <span class="badge bg-primary me-1" style="font-size:.6em">Dev</span>
                                }
                                else if (proj.IsProd)
                                {
                                    <span class="badge bg-success me-1" style="font-size:.6em">Prod</span>
                                }
                                @proj.Naam
                            </a>
                        </li>
                    }
                </ul>
            </li>
        </ul>
    }
    else if (Model.DevProdSwitcher is { } switcher)
    {
        <ul class="navbar-nav me-2 align-items-center">
            <li class="nav-item d-flex gap-1">
                <a href="@Url.Action("Switch", "Omgeving", new { projectId = switcher.DevProjectId, returnUrl = Model.SwitchReturnUrl })"
                   class="badge text-decoration-none py-1 px-2 @(switcher.IsDevActive ? "bg-primary" : "bg-secondary")">
                    Ontwikkeling
                </a>
                <a href="@Url.Action("Switch", "Omgeving", new { projectId = switcher.ProdProjectId, returnUrl = Model.SwitchReturnUrl })"
                   class="badge text-decoration-none py-1 px-2 @(!switcher.IsDevActive ? "bg-success" : "bg-secondary")">
                    Productie
                </a>
            </li>
        </ul>
    }

    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-1"></i>@Model.UserName
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                        <i class="bi bi-key me-2"></i>Wachtwoord wijzigen
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Toestemming">
                        <i class="bi bi-shield-check me-2"></i>Mijn toestemming
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="MijnGegevens">
                        <i class="bi bi-download me-2"></i>Mijn gegevens (DSAR)
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Uitloggen
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}

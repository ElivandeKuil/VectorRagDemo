@{
    ViewData["Title"] = "RAG Testing";
}

<h1>RAG System Testing</h1>

<div class="alert alert-info">
    <strong>Test your RAG pipeline step by step</strong>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5>Step 1: Generate Embeddings</h5>
    </div>
    <div class="card-body">
        <p>Generate embeddings for all chunks in the database (replaces dummy vectors)</p>
        <button id="btnGenerateEmbeddings" class="btn btn-primary">Generate Embeddings</button>
        <div id="embedResult" class="mt-3"></div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5>Step 2: Test Vector Search</h5>
    </div>
    <div class="card-body">
        <p>Search for similar chunks using vector similarity</p>
        <input type="text" id="searchQuery" class="form-control mb-2" placeholder="Enter search query" value="sample product" />
        <button id="btnTestSearch" class="btn btn-success">Test Search</button>
        <div id="searchResult" class="mt-3"></div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5>Step 3: Test Full RAG Pipeline</h5>
    </div>
    <div class="card-body">
        <p>Complete RAG: Embedding → Vector Search → LLM Response</p>
        <input type="text" id="ragQuery" class="form-control mb-2" placeholder="Ask a question" value="Tell me about the products" />
        <button id="btnTestRAG" class="btn btn-warning">Test Full RAG</button>
        <div id="ragResult" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            // Test 1: Generate Embeddings
            $('#btnGenerateEmbeddings').click(function () {
                $(this).prop('disabled', true).text('Generating...');
                $('#embedResult').html('<div class="spinner-border" role="status"></div>');

                $.get('@Url.Action("GenerateEmbeddings", "Test")', function (data) {
                    if (data.success) {
                        $('#embedResult').html('<div class="alert alert-success">' + data.message + '</div>');
                    } else {
                        $('#embedResult').html('<div class="alert alert-danger">Error: ' + data.error + '</div>');
                    }
                    $('#btnGenerateEmbeddings').prop('disabled', false).text('Generate Embeddings');
                }).fail(function (xhr) {
                    $('#embedResult').html('<div class="alert alert-danger">Request failed: ' + xhr.responseText + '</div>');
                    $('#btnGenerateEmbeddings').prop('disabled', false).text('Generate Embeddings');
                });
            });

            // Test 2: Vector Search
            $('#btnTestSearch').click(function () {
                var query = $('#searchQuery').val();
                $(this).prop('disabled', true).text('Searching...');
                $('#searchResult').html('<div class="spinner-border" role="status"></div>');

                $.get('@Url.Action("TestVectorSearch", "Test")', { query: query }, function (data) {
                    if (data.success) {
                        $('#searchResult').html(
                            '<div class="alert alert-success"><strong>Query:</strong> ' + data.query + '</div>' +
                            '<pre>' + data.results + '</pre>'
                        );
                    } else {
                        $('#searchResult').html('<div class="alert alert-danger">Error: ' + data.error + '</div>');
                    }
                    $('#btnTestSearch').prop('disabled', false).text('Test Search');
                }).fail(function (xhr) {
                    $('#searchResult').html('<div class="alert alert-danger">Request failed</div>');
                    $('#btnTestSearch').prop('disabled', false).text('Test Search');
                });
            });

            // Test 3: Full RAG
            $('#btnTestRAG').click(function () {
                var query = $('#ragQuery').val();
                $(this).prop('disabled', true).text('Processing...');
                $('#ragResult').html('<div class="spinner-border" role="status"></div>');

                $.get('@Url.Action("TestFullRAG", "Test")', { query: query }, function (data) {
                    if (data.success) {
                        $('#ragResult').html(
                            '<div class="alert alert-info"><strong>Query:</strong> ' + data.query + '</div>' +
                            '<h6>Context Used:</h6><pre>' + data.context + '</pre>' +
                            '<h6>AI Response:</h6><div class="alert alert-success">' + data.response + '</div>' +
                            '<h6>Sources:</h6><pre>' + data.sources + '</pre>'
                        );
                    } else {
                        $('#ragResult').html('<div class="alert alert-danger">Error: ' + data.error + '</div>');
                    }
                    $('#btnTestRAG').prop('disabled', false).text('Test Full RAG');
                }).fail(function (xhr) {
                    $('#ragResult').html('<div class="alert alert-danger">Request failed</div>');
                    $('#btnTestRAG').prop('disabled', false).text('Test Full RAG');
                });
            });
        });
    </script>
}
@model VectorRagDemo.Models.ViewModels.ConversatieDetailViewModel
@{
    ViewData["Title"] = $"Gesprek #{Model.ID} – {Model.Project.Naam}";
    var isAdmin = User.IsInRole("Admin");

    // Interleave messages and escalation events by timestamp, then group consecutive
    // same-sender messages so we only render the avatar once per run.
    var timeline = new List<(DateTime Ts, object Item)>();
    foreach (var b in Model.Berichten)  timeline.Add((b.GemaaktOp, b));
    foreach (var e in Model.Escalaties) timeline.Add((e.GemaaktOp, e));
    timeline.Sort((a, b) => a.Ts.CompareTo(b.Ts));

    // Build display groups: each entry is either an EscalatieEventRij
    // or a List<BerichtViewModel> (consecutive same-sender run).
    var displayItems = new List<object>();
    List<VectorRagDemo.Models.ViewModels.BerichtViewModel>? currentGroup = null;
    bool? currentIsBot = null;
    int globalBotMsgIndex = 0;  // incremented per bot message rendered, used for correction modal

    // Latest correction per message for inline display
    var correctieMap = Model.Correcties
        .GroupBy(c => c.MessageID)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(c => c.GemaaktOp).First());

    foreach (var (_, item) in timeline)
    {
        if (item is VectorRagDemo.Models.ViewModels.EscalatieEventRij esc)
        {
            currentGroup  = null;
            currentIsBot  = null;
            displayItems.Add(esc);
        }
        else if (item is VectorRagDemo.Models.ViewModels.BerichtViewModel msg)
        {
            if (currentIsBot == msg.IsBot && currentGroup != null)
            {
                currentGroup.Add(msg);
            }
            else
            {
                currentGroup = new List<VectorRagDemo.Models.ViewModels.BerichtViewModel> { msg };
                currentIsBot = msg.IsBot;
                displayItems.Add(currentGroup);
            }
        }
    }
}

<style>
    .chat-window {
        background: #f0f2f5;
        border-radius: 16px;
        padding: 1.5rem 1.25rem;
    }

    /* ── Avatar circles ─────────────────────────────────────── */
    .chat-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        flex-shrink: 0;
        align-self: flex-end; /* sits at bottom of a tall bubble group */
    }
    .chat-avatar-bot  { background: #e7f1ff; color: #0d6efd; }
    .chat-avatar-user { background: #0d6efd; color: #fff; }
    .chat-avatar-placeholder { width: 34px; flex-shrink: 0; } /* keeps alignment when no avatar */

    /* ── Message groups ─────────────────────────────────────── */
    .msg-group       { display: flex; flex-direction: column; gap: 3px; margin-bottom: 14px; }
    .msg-group:last-child { margin-bottom: 0; }
    .msg-row         { display: flex; gap: 8px; align-items: flex-end; }
    .msg-row-bot     { justify-content: flex-start; }
    .msg-row-user    { justify-content: flex-end; }

    /* ── Bubbles ────────────────────────────────────────────── */
    .bubble {
        padding: 9px 13px;
        line-height: 1.55;
        font-size: .88rem;
        max-width: 68%;
        word-break: break-word;
        white-space: pre-wrap;
        position: relative;
    }
    /* Bot: white card, top-left corner flat (tail side) */
    .bubble-bot {
        background: #ffffff;
        border: 1px solid #e4e6e9;
        border-radius: 4px 18px 18px 18px;
        color: #212529;
        box-shadow: 0 1px 2px rgba(0,0,0,.06);
    }
    /* First bubble in a bot group has the sharp corner (tail); rest are rounded */
    .bubble-bot.bubble-mid,
    .bubble-bot.bubble-last { border-radius: 18px; }
    .bubble-bot.bubble-last { border-radius: 18px 18px 18px 4px; }

    /* User: blue, top-right corner flat (tail side) */
    .bubble-user {
        background: #0d6efd;
        border: none;
        border-radius: 18px 4px 18px 18px;
        color: #fff;
        box-shadow: 0 1px 2px rgba(13,110,253,.25);
    }
    .bubble-user.bubble-mid,
    .bubble-user.bubble-last { border-radius: 18px; }
    .bubble-user.bubble-last { border-radius: 18px 4px 18px 18px; }

    /* ── Timestamp below each group ─────────────────────────── */
    .msg-time {
        font-size: .72rem;
        color: #9aa0aa;
        margin-top: 3px;
    }
    .msg-time-bot  { padding-left: 42px; } /* avatar width + gap */
    .msg-time-user { text-align: right; padding-right: 42px; }

    /* ── Correction panel ───────────────────────────────────── */
    .correctie-panel {
        margin-top: 6px;
        padding-left: 42px; /* aligns under bot bubble (avatar + gap) */
    }
    .correctie-card {
        display: inline-flex;
        align-items: flex-start;
        gap: 7px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
        padding: 7px 12px;
        font-size: .78rem;
        max-width: 68%;
    }
    .correctie-card .correctie-tekst {
        color: #374151;
        white-space: pre-wrap;
        word-break: break-word;
    }

    /* ── Correction button ───────────────────────────────────── */
    .bubble-wrapper {
        position: relative;
        display: inline-flex;
        align-items: flex-end;
        gap: 4px;
        max-width: 100%;
    }
    .correctie-btn {
        opacity: 0;
        transition: opacity .15s;
        flex-shrink: 0;
        color: #adb5bd;
        background: none;
        border: none;
        padding: 2px 4px;
        font-size: .8rem;
        line-height: 1;
        cursor: pointer;
    }
    .correctie-btn:hover { color: #0d6efd; }
    .msg-row:hover .correctie-btn { opacity: 1; }

    /* ── Escalation divider ─────────────────────────────────── */
    .escalation-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 18px 0;
        color: #6c757d;
        font-size: .78rem;
    }
    .escalation-divider hr { flex: 1; border-color: #ced4da; margin: 0; }
    .escalation-pill {
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: 20px;
        padding: 3px 12px;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 5px;
    }
</style>

@* ─── HEADER ──────────────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-1">
            <i class="bi bi-chat-left-text me-2 text-primary"></i>Gesprek #@Model.ID
            <span class="text-muted fs-5 fw-normal">– @Model.Project.Naam</span>
        </h4>
    </div>
    <a asp-action="Index"
       asp-route-projectId="@(isAdmin ? Model.ProjectID : 0)"
       class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Terug naar gesprekken
    </a>
</div>

@* ─── METADATA BAR ─────────────────────────────────────────────────────── *@
<div class="card shadow-sm mb-4">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap gap-4 align-items-center small">
            <span class="text-muted">
                <i class="bi bi-calendar3 me-1"></i>@Model.GemaaktOp.ToString("dd-MM-yyyy HH:mm")
            </span>
            <span class="text-muted">
                <i class="bi bi-chat-dots me-1"></i>@Model.Berichten.Count bericht@(Model.Berichten.Count == 1 ? "" : "en")
            </span>
            @if (Model.Escalaties.Any())
            {
                <span class="badge bg-primary">
                    <i class="bi bi-arrow-right-circle me-1"></i>Doorverwezen
                </span>
            }
        </div>
    </div>
</div>

@* ─── CHAT WINDOW ───────────────────────────────────────────────────────── *@
<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7">
        <div class="chat-window">

            @if (!displayItems.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-left display-4 d-block mb-3 opacity-50"></i>
                    <p>Geen berichten in dit gesprek.</p>
                </div>
            }

            @foreach (var displayItem in displayItems)
            {
                if (displayItem is VectorRagDemo.Models.ViewModels.EscalatieEventRij escalatie)
                {
                    var kanaalIcon  = escalatie.Kanaal == "whatsapp" ? "bi-whatsapp" : "bi-envelope";
                    var kanaalLabel = escalatie.Kanaal switch
                    {
                        "whatsapp" => "WhatsApp doorverwijzing",
                        "email"    => "E-mail doorverwijzing",
                        _          => escalatie.Kanaal + " doorverwijzing"
                    };
                    <div class="escalation-divider">
                        <hr />
                        <span class="escalation-pill">
                            <i class="bi @kanaalIcon text-primary"></i>
                            @kanaalLabel &nbsp;·&nbsp; @escalatie.GemaaktOp.ToString("HH:mm")
                        </span>
                        <hr />
                    </div>
                }
                else if (displayItem is List<VectorRagDemo.Models.ViewModels.BerichtViewModel> groep)
                {
                    var isBot = groep[0].IsBot;
                    var count = groep.Count;

                    <div class="msg-group">
                        @for (int gi = 0; gi < count; gi++)
                        {
                            var msg         = groep[gi];
                            var isFirst     = gi == 0;
                            var isLast      = gi == count - 1;
                            var bubbleClass = isBot ? "bubble-bot" : "bubble-user";

                            // Corner shaping: first = tail corner, middle = all round, last = base corner
                            if (count > 1)
                            {
                                if (!isFirst && !isLast) bubbleClass += " bubble-mid";
                                if (!isFirst && isLast)  bubbleClass += " bubble-last";
                            }

                            if (isBot)
                            {
                                var isBotFirst = globalBotMsgIndex == 0;
                                globalBotMsgIndex++;
                                <div class="msg-row msg-row-bot">
                                    @if (isFirst)
                                    {
                                        <div class="chat-avatar chat-avatar-bot">
                                            <i class="bi bi-stars"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="chat-avatar-placeholder"></div>
                                    }
                                    <div class="bubble-wrapper">
                                        <div class="bubble bubble-bot @bubbleClass">@msg.Tekst</div>
                                        <button type="button"
                                                class="correctie-btn"
                                                data-message-id="@msg.ID"
                                                data-is-first="@(isBotFirst ? "true" : "false")"
                                                data-message-text="@System.Net.WebUtility.HtmlEncode(msg.Tekst)"
                                                title="Correctie toevoegen"
                                                onclick="openCorrectieModal(this)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="msg-row msg-row-user">
                                    <div class="bubble bubble-user @bubbleClass">@msg.Tekst</div>
                                    @if (isFirst)
                                    {
                                        <div class="chat-avatar chat-avatar-user">
                                            <i class="bi bi-person"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="chat-avatar-placeholder"></div>
                                    }
                                </div>
                            }
                        }

                        @* Timestamp once per group, under the last bubble *@
                        <div class="msg-time @(isBot ? "msg-time-bot" : "msg-time-user")">
                            @groep.Last().GemaaktOp.ToString("HH:mm")
                        </div>

                        @* Correction panels — one per corrected bot message in this group *@
                        @if (isBot)
                        {
                            foreach (var botMsg in groep)
                            {
                                if (correctieMap.TryGetValue(botMsg.ID, out var correctie))
                                {
                                    <div class="correctie-panel">
                                        <div class="correctie-card">
                                            <i class="bi bi-pencil-square text-warning flex-shrink-0 mt-1"></i>
                                            <div>
                                                <div class="fw-semibold text-warning-emphasis mb-1" style="font-size:.72rem; letter-spacing:.02em;">
                                                    GECORRIGEERD
                                                    <span class="text-muted fw-normal ms-1">@correctie.GemaaktOp.ToString("dd-MM-yyyy HH:mm")</span>
                                                </div>
                                                <div class="correctie-tekst">@correctie.Correctietekst</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                }
            }

        </div>
    </div>
</div>

@* ─── CORRECTIE MODAL ────────────────────────────────────────────────────── *@
<div class="modal fade" id="correctieModal" tabindex="-1" aria-labelledby="correctieModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="correctieModalLabel">
                    <i class="bi bi-pencil-square me-2 text-primary"></i>Correctie toevoegen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body pt-2">

                @* Original message context *@
                <div id="cm-original" class="mb-3 p-3 bg-light rounded border small text-muted fst-italic"
                     style="max-height:200px; overflow-y:auto;"></div>

                @* ── Screen: decision (only shown for non-first bot messages) ── *@
                <div id="cm-screen-decision">
                    <p class="mb-3 small text-muted">Wat voor soort correctie wil je toevoegen?</p>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-primary text-start" id="cm-btn-factual">
                            <i class="bi bi-file-text me-2"></i><strong>Feitelijke correctie</strong>
                            <small class="d-block text-muted fw-normal ms-4">Het antwoord bevatte onjuiste of ontbrekende informatie</small>
                        </button>
                        <button type="button" class="btn btn-outline-secondary text-start" id="cm-btn-behavioral">
                            <i class="bi bi-sliders me-2"></i><strong>Gedragscorrectie</strong>
                            <small class="d-block text-muted fw-normal ms-4">De toon, stijl of aanpak klopte niet</small>
                        </button>
                    </div>
                </div>

                @* ── Screen: factual correction form ── *@
                <div id="cm-screen-factual" style="display:none;">
                    <form id="cm-factual-form">
                        <input type="hidden" id="cm-message-id" name="messageId" />
                        <input type="hidden" id="cm-conversation-id" name="conversationId" value="@Model.ID" />
                        <input type="hidden" name="projectId" value="@(isAdmin ? Model.ProjectID : 0)" />
                        <label class="form-label small fw-semibold" for="cm-correctie-tekst">
                            Wat had het juiste antwoord moeten zijn?
                        </label>
                        <textarea class="form-control form-control-sm" id="cm-correctie-tekst" name="correctieTekst"
                                  rows="5" placeholder="Schrijf hier de correcte informatie…"></textarea>
                        <div class="mt-3 d-flex justify-content-between align-items-center">
                            <button type="button" id="cm-btn-back-factual" class="btn btn-link btn-sm text-muted p-0">
                                <i class="bi bi-arrow-left me-1"></i>Terug
                            </button>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-send me-1"></i>Versturen
                            </button>
                        </div>
                    </form>
                </div>

                @* ── Screen: behavioral explanation ── *@
                <div id="cm-screen-behavioral" style="display:none;">
                    <div class="alert alert-info d-flex gap-2 align-items-start mb-3">
                        <i class="bi bi-info-circle-fill flex-shrink-0 mt-1"></i>
                        <div>
                            <strong>Gedragscorrecties</strong> worden gebruikt om de manier waarop de assistent
                            reageert te verbeteren — denk aan toon, structuur, lengte of stijl van antwoorden.
                            <br /><br />
                            Gedragscorrecties worden verzameld en periodiek beoordeeld om de promptinstellingen
                            van dit project bij te sturen. Ze resulteren niet in een directe aanpassing.
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <button type="button" id="cm-btn-back-behavioral" class="btn btn-link btn-sm text-muted p-0">
                            <i class="bi bi-arrow-left me-1"></i>Terug
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Sluiten</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const modal      = new bootstrap.Modal(document.getElementById('correctieModal'));
    const elOriginal = document.getElementById('cm-original');
    const screens    = {
        decision:   document.getElementById('cm-screen-decision'),
        factual:    document.getElementById('cm-screen-factual'),
        behavioral: document.getElementById('cm-screen-behavioral'),
    };

    function showScreen(name) {
        Object.values(screens).forEach(s => s.style.display = 'none');
        screens[name].style.display = '';
    }

    window.openCorrectieModal = function (btn) {
        elOriginal.textContent = btn.dataset.messageText;
        document.getElementById('cm-message-id').value      = btn.dataset.messageId;
        document.getElementById('cm-correctie-tekst').value = '';
        document.getElementById('cm-btn-back-factual').style.display = '';

        showScreen('decision');

        modal.show();
    };

    document.getElementById('cm-btn-factual').addEventListener('click',
        () => showScreen('factual'));

    document.getElementById('cm-btn-behavioral').addEventListener('click',
        () => showScreen('behavioral'));

    document.getElementById('cm-btn-back-factual').addEventListener('click',
        () => showScreen('decision'));

    document.getElementById('cm-btn-back-behavioral').addEventListener('click',
        () => showScreen('decision'));

    const submitBtn  = document.querySelector('#cm-factual-form button[type="submit"]');
    const submitIcon = submitBtn.querySelector('i');

    document.getElementById('cm-factual-form').addEventListener('submit', async function (e) {
        e.preventDefault();

        const correctieTekst = document.getElementById('cm-correctie-tekst').value.trim();
        if (!correctieTekst) return;

        // Show loading state
        submitBtn.disabled = true;
        submitIcon.className = 'bi bi-hourglass-split me-1';

        const form     = document.getElementById('cm-factual-form');
        const formData = new FormData(form);
        const token    = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.set('__RequestVerificationToken', token);

        try {
            const response = await fetch('@Url.Action("SlaCorrectieOp", "Conversaties")', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                submitIcon.className = 'bi bi-check-lg me-1';
                submitBtn.textContent = '';
                submitBtn.appendChild(document.createElement('i')).className = 'bi bi-check-lg me-1';
                submitBtn.append('Opgeslagen');
                setTimeout(() => modal.hide(), 800);
            } else {
                submitIcon.className = 'bi bi-exclamation-triangle me-1';
                submitBtn.disabled = false;
            }
        } catch {
            submitIcon.className = 'bi bi-exclamation-triangle me-1';
            submitBtn.disabled = false;
        }
    });
})();
</script>
}

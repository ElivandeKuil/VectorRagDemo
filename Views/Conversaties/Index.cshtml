@model VectorRagDemo.Models.ViewModels.ConversatiesViewModel
@{
    ViewData["Title"] = "Gesprekken – " + Model.Project.Naam;
    var isAdmin = User.IsInRole("Admin");
    var f = Model.Filter;
}

@* ─── HEADER ──────────────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-1"><i class="bi bi-chat-left-text me-2 text-primary"></i>Gesprekken – @Model.Project.Naam</h4>
        <span class="badge bg-secondary">@Model.TotaalAantal gesprek@(Model.TotaalAantal == 1 ? "" : "ken") gevonden</span>
    </div>
    @if (isAdmin)
    {
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            @Html.DropDownList("projectId",
                (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewData["AdminProjects"]!,
                "– Selecteer project –",
                new { @class = "form-select form-select-sm", onchange = "this.form.submit()", style = "min-width:180px;" })
        </form>
    }
</div>

@* ─── FILTER BAR ───────────────────────────────────────────────────────── *@
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form asp-action="Index" method="get" id="filterForm">
            @if (isAdmin)
            {
                <input type="hidden" name="projectId" value="@Model.Project.ID" />
            }
            <input type="hidden" name="filter.Pagina" value="1" />
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small mb-1 text-muted">Zoeken in berichten</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="filter.Zoekterm" class="form-control"
                               placeholder="Zoekterm…" value="@f.Zoekterm" />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1 text-muted">Kanaal</label>
                    <select name="filter.Kanaal" class="form-select form-select-sm">
                        <option value="alle" selected="@(f.Kanaal == "alle")">Alle kanalen</option>
                        <option value="widget" selected="@(f.Kanaal == "widget")">Widget</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1 text-muted">Type</label>
                    <select name="filter.Type" class="form-select form-select-sm">
                        <option value="alle" selected="@(f.Type == "alle")">Alle types</option>
                        <option value="verlaten" selected="@(f.Type == "verlaten")">Verlaten</option>
                        <option value="betrokken" selected="@(f.Type == "betrokken")">Betrokken</option>
                        <option value="escalatie" selected="@(f.Type == "escalatie")">Doorverwijzing</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1 text-muted">Datum van</label>
                    <input type="date" name="filter.DatumVan" class="form-control form-control-sm"
                           value="@(f.DatumVan.HasValue ? f.DatumVan.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1 text-muted">Datum tot</label>
                    <input type="date" name="filter.DatumTot" class="form-control form-control-sm"
                           value="@(f.DatumTot.HasValue ? f.DatumTot.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-6 col-md-1">
                    <label class="form-label small mb-1 text-muted">Sortering</label>
                    <select name="filter.Sortering" class="form-select form-select-sm">
                        <option value="nieuwste" selected="@(f.Sortering == "nieuwste")">Nieuwste</option>
                        <option value="oudste" selected="@(f.Sortering == "oudste")">Oudste</option>
                    </select>
                </div>
                <div class="col-6 col-md-auto d-flex gap-2 align-items-end">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-funnel me-1"></i>Filteren
                    </button>
                    @if (!f.IsLeeg)
                    {
                        <a asp-action="Index"
                           asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
                           class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-x me-1"></i>Wissen
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@* ─── CONVERSATION TABLE ────────────────────────────────────────────────── *@
@if (!Model.Gesprekken.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-chat-left-dots display-4 d-block mb-3 opacity-50"></i>
        <h5>Geen gesprekken gevonden</h5>
        @if (!f.IsLeeg)
        {
            <p class="mb-0 small">Probeer de filters aan te passen.</p>
        }
        else
        {
            <p class="mb-0 small">Er zijn nog geen gesprekken voor dit project.</p>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-nowrap"><i class="bi bi-calendar3 me-1"></i>Datum / tijd</th>
                    <th>Kanaal</th>
                    <th class="text-center">Berichten</th>
                    <th class="text-center">Duur</th>
                    <th>Eerste bericht</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.Gesprekken)
                {
                    <tr>
                        <td class="text-nowrap small">@g.GemaaktOp.ToString("dd-MM-yyyy HH:mm")</td>
                        <td>
                            <span class="badge bg-primary">Widget</span>
                        </td>
                        <td class="text-center small">
                            <span title="Totaal berichten">@g.TotaalBerichten</span>
                            <span class="text-muted"> / </span>
                            <span class="text-muted" title="Berichten van bezoeker">@g.GebruikerBerichten</span>
                        </td>
                        <td class="text-center small text-muted">
                            @if (g.DuurMinuten > 0)
                            {
                                @(g.DuurMinuten)<text> min</text>
                            }
                            else
                            {
                                <text>–</text>
                            }
                        </td>
                        <td class="small text-muted fst-italic" style="max-width:240px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @(g.EersteBerichtPreview ?? "–")
                        </td>
                        <td class="text-nowrap">
                            @if (g.IsVerlaten)
                            {
                                <span class="badge bg-warning text-dark me-1">Verlaten</span>
                            }
                            @if (g.IsBetrokken)
                            {
                                <span class="badge bg-success me-1">Betrokken</span>
                            }
                            @if (g.HeeftEscalatie && Model.HeeftEscalatieFunctie)
                            {
                                <span class="badge bg-primary" title="@g.EscalatieKanalen">Doorverwezen</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Detail"
                               asp-route-id="@g.ID"
                               asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye me-1"></i>Bekijk
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── PAGINATION ──────────────────────────────────────────────────────── *@
    @if (Model.TotaalPaginas > 1)
    {
        var pagina = f.Pagina;
        var totaalPaginas = Model.TotaalPaginas;

        <nav class="mt-3" aria-label="Paginering gesprekken">
            <ul class="pagination justify-content-center flex-wrap">

                @* Previous *@
                <li class="page-item @(pagina <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
                       asp-route-filter.Zoekterm="@f.Zoekterm"
                       asp-route-filter.Kanaal="@f.Kanaal"
                       asp-route-filter.Type="@f.Type"
                       asp-route-filter.DatumVan="@(f.DatumVan.HasValue ? f.DatumVan.Value.ToString("yyyy-MM-dd") : "")"
                       asp-route-filter.DatumTot="@(f.DatumTot.HasValue ? f.DatumTot.Value.ToString("yyyy-MM-dd") : "")"
                       asp-route-filter.Sortering="@f.Sortering"
                       asp-route-filter.Pagina="@(pagina - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @* Page numbers: show first, last, and 2 around current *@
                @{
                    var pagesToShow = new SortedSet<int>();
                    pagesToShow.Add(1);
                    pagesToShow.Add(totaalPaginas);
                    for (int p = Math.Max(1, pagina - 2); p <= Math.Min(totaalPaginas, pagina + 2); p++)
                        pagesToShow.Add(p);

                    int? prev = null;
                    foreach (var p in pagesToShow)
                    {
                        if (prev.HasValue && p - prev.Value > 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item @(p == pagina ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
                               asp-route-filter.Zoekterm="@f.Zoekterm"
                               asp-route-filter.Kanaal="@f.Kanaal"
                               asp-route-filter.Type="@f.Type"
                               asp-route-filter.DatumVan="@(f.DatumVan.HasValue ? f.DatumVan.Value.ToString("yyyy-MM-dd") : "")"
                               asp-route-filter.DatumTot="@(f.DatumTot.HasValue ? f.DatumTot.Value.ToString("yyyy-MM-dd") : "")"
                               asp-route-filter.Sortering="@f.Sortering"
                               asp-route-filter.Pagina="@p">@p</a>
                        </li>
                        prev = p;
                    }
                }

                @* Next *@
                <li class="page-item @(pagina >= totaalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
                       asp-route-filter.Zoekterm="@f.Zoekterm"
                       asp-route-filter.Kanaal="@f.Kanaal"
                       asp-route-filter.Type="@f.Type"
                       asp-route-filter.DatumVan="@(f.DatumVan.HasValue ? f.DatumVan.Value.ToString("yyyy-MM-dd") : "")"
                       asp-route-filter.DatumTot="@(f.DatumTot.HasValue ? f.DatumTot.Value.ToString("yyyy-MM-dd") : "")"
                       asp-route-filter.Sortering="@f.Sortering"
                       asp-route-filter.Pagina="@(pagina + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}

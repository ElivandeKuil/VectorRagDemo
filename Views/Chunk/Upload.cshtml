@using VectorRagDemo.Models.Entities

@{
    ViewData["Title"] = "Document uploaden";
    var singleProject = ViewBag.SingleProject as Project;
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" btn-variant="outline-secondary" btn-size="sm" btn-icon="arrow-left" class="me-3"></a>
    <h1 class="mb-0"><i class="bi bi-upload me-2"></i>Document uploaden</h1>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form method="post" enctype="multipart/form-data" asp-action="Upload" id="uploadForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label app-label class="fw-semibold">Project</label>
                        @if (singleProject != null)
                        {
                            <input type="hidden" name="projectId" value="@singleProject.ID" />
                            <p class="form-control-plaintext">@singleProject.Naam</p>
                        }
                        else
                        {
                            <select name="projectId" id="projectId" app-field required>
                                <option value="">-- Selecteer een project --</option>
                                @foreach (SelectListItem item in ViewBag.Projects)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="mb-4">
                        <label for="file" app-label class="fw-semibold">Bestand</label>
                        <input type="file" name="file" id="file" app-field accept=".txt,.docx" required />
                        <div class="form-text">Ondersteunde formaten: .txt en .docx (max. 50 MB)</div>
                    </div>

                    <div class="mb-4">
                        <label for="folderId" app-label class="fw-semibold">Map <span class="text-muted fw-normal">(optioneel)</span></label>
                        <select name="folderId" id="folderId" app-field>
                            <option value="">— Geen map —</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="link" app-label class="fw-semibold">Koppeling <span class="text-muted fw-normal">(optioneel)</span></label>
                        <input type="text" name="link" id="link" app-field placeholder="https://…" />
                        <div class="form-text">URL die wordt getoond in de chatbot bij antwoorden die dit document gebruiken.</div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" btn-variant="primary" btn-size="lg" id="submitBtn">
                            <span id="btnNormal">
                                <i class="bi bi-upload me-2"></i>Uploaden en verwerken
                            </span>
                            <span id="btnSpinner" class="d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                Bezig met verwerken…
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card border-0 bg-light">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-lightbulb me-2 text-warning"></i>Tips voor goede resultaten</h6>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-2">Upload documenten die over <strong>één onderwerp</strong> gaan. Een document met veel losse onderwerpen levert minder precieze antwoorden op.</li>
                    <li class="mb-2">Zorg dat de tekst <strong>leesbaar en volledig</strong> is. Gescande afbeeldingen of slecht opgemaakte bestanden worden niet goed herkend.</li>
                    <li class="mb-2">Hoe <strong>meer context</strong> een document geeft, hoe beter de chatbot vragen kan beantwoorden. Losse trefwoorden of tabellen zonder uitleg werken minder goed.</li>
                    <li>Gebruik een <strong>duidelijke bestandsnaam</strong> zodat je het document straks makkelijk terugvindt.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const initialFolderData = @Html.Raw(Json.Serialize(ViewBag.FolderData ?? new object[0]));

        function buildFolderOptions(folderData, select, parentId, depth) {
            parentId = parentId ?? null;
            depth = depth ?? 0;
            const children = folderData
                .filter(f => f.parentId === parentId)
                .sort((a, b) => a.naam.localeCompare(b.naam, 'nl'));
            for (const f of children) {
                const opt = document.createElement('option');
                opt.value = f.id;
                opt.textContent = '\u00a0\u00a0'.repeat(depth * 2) + (depth > 0 ? '└ ' : '') + f.naam;
                select.appendChild(opt);
                buildFolderOptions(folderData, select, f.id, depth + 1);
            }
        }

        buildFolderOptions(initialFolderData, document.getElementById('folderId'));

        const projectSelect = document.getElementById('projectId');
        if (projectSelect) {
            projectSelect.addEventListener('change', async function () {
                const sel = document.getElementById('folderId');
                sel.innerHTML = '<option value="">— Geen map —</option>';
                if (!this.value) return;
                const resp = await fetch('/Chunk/GetFolders?projectId=' + this.value);
                const folders = await resp.json();
                buildFolderOptions(folders, sel);
            });
        }

        document.getElementById('uploadForm').addEventListener('submit', function () {
            document.getElementById('btnNormal').classList.add('d-none');
            document.getElementById('btnSpinner').classList.remove('d-none');
            document.getElementById('submitBtn').disabled = true;
        });
    </script>
}

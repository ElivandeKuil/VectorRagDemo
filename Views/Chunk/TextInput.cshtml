@using VectorRagDemo.Models.Entities

@{
    ViewData["Title"] = "Tekst invoeren";
    var singleProject = ViewBag.SingleProject as Project;
    var inputTitle = ViewBag.InputTitle as string ?? string.Empty;
    var inputText = ViewBag.InputText as string ?? string.Empty;
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" btn-variant="outline-secondary" btn-size="sm" btn-icon="arrow-left" class="me-3"></a>
    <h1 class="mb-0"><i class="bi bi-keyboard me-2"></i>Tekst invoeren</h1>
    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto"
            data-bs-toggle="offcanvas" data-bs-target="#placeholderPanel" aria-controls="placeholderPanel"
            id="btnVariabelen" @(singleProject == null ? "disabled" : "")>
        <i class="bi bi-braces me-1"></i>Variabelen
        <span class="badge bg-primary ms-1" id="placeholderCount">…</span>
    </button>
</div>

<!-- Placeholder side panel (Bootstrap offcanvas) -->
<div class="offcanvas offcanvas-end placeholder-panel" tabindex="-1" id="placeholderPanel" aria-labelledby="placeholderPanelLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="placeholderPanelLabel">
            <i class="bi bi-braces me-2 text-primary"></i>Variabelen
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Sluiten"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column gap-3">
        <p class="text-muted small mb-0">
            Typ <code>@@@@naam</code> in de tekst. Bij ophalen wordt de variabele vervangen door de bijbehorende waarde.
            Typ <kbd>@@@@</kbd> in het tekstveld voor autocomplete.
        </p>

        <div id="placeholderList" class="d-flex flex-column gap-1">
            <div class="text-muted small text-center py-2">Laden…</div>
        </div>

        <hr class="my-1">

        <div>
            <h6 class="fw-semibold mb-2" id="phFormTitle">Nieuwe variabele</h6>
            <div class="mb-2">
                <label class="form-label small mb-1">Naam <span class="text-muted">(letters, cijfers, _)</span></label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text text-primary fw-bold">@@</span>
                    <input type="text" id="phNaam" class="form-control" placeholder="basisprijs">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label small mb-1">Waarde</label>
                <input type="text" id="phWaarde" class="form-control form-control-sm" placeholder="bijv. €99,95">
            </div>
            <input type="hidden" id="phEditId" value="0">
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm flex-grow-1" id="btnSavePlaceholder">
                    <i class="bi bi-check-lg me-1"></i>Opslaan
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="btnCancelEdit">
                    Annuleren
                </button>
            </div>
            <div id="phFormError" class="text-danger small mt-2 d-none"></div>
        </div>
    </div>
</div>

<!-- Autocomplete dropdown (portal, appended to body) -->
<div id="phAutocomplete" class="ph-autocomplete" style="display:none;" role="listbox"></div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div id="chunk-form-data"
                     data-koppeling-per-project="@(Json.Serialize(ViewBag.KoppelingPerProject ?? new object()).ToString())"
                     data-initial-project-id="@(singleProject?.ID.ToString() ?? "")"
                     data-initial-folder-data="@(Json.Serialize(ViewBag.FolderData ?? new object[0]).ToString())"
                     style="display:none;"></div>
                <form method="post" asp-action="TextInput" id="textInputForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label app-label class="fw-semibold">Project</label>
                        @if (singleProject != null)
                        {
                            <input type="hidden" name="projectId" value="@singleProject.ID" />
                            <p class="form-control-plaintext">@singleProject.Naam</p>
                        }
                        else
                        {
                            <select name="projectId" id="projectId" app-field required>
                                <option value="">-- Selecteer een project --</option>
                                @foreach (SelectListItem item in ViewBag.Projects)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="title" app-label class="fw-semibold">Titel</label>
                        <input type="text"
                               name="title"
                               id="title"
                               app-field
                               placeholder="Geef deze tekst een herkenbare naam"
                               value="@inputTitle"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="folderId" app-label class="fw-semibold">Map <span class="text-muted fw-normal">(optioneel)</span></label>
                        <select name="folderId" id="folderId" app-field>
                            <option value="">— Geen map —</option>
                        </select>
                    </div>

                    <div class="mb-3" id="linkField" style="display:none">
                        <label for="link" app-label class="fw-semibold">Koppeling <span class="text-muted fw-normal">(optioneel)</span></label>
                        <input type="text" name="link" id="link" app-field placeholder="https://…" />
                        <div class="form-text">URL die wordt getoond in de chatbot bij antwoorden die dit document gebruiken.</div>
                    </div>

                    <div class="mb-4">
                        <label for="text" app-label class="fw-semibold">Tekst</label>
                        <textarea name="text"
                                  id="text"
                                  app-field
                                  rows="14"
                                  placeholder="Plak of typ hier de tekst die je wilt opslaan…"
                                  required>@inputText</textarea>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="form-text">De tekst wordt automatisch opgesplitst in chunks en verwerkt.</span>
                            <span id="wordCount" class="form-text text-muted">0 woorden</span>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" btn-variant="primary" btn-size="lg" id="submitBtn">
                            <span id="btnNormal">
                                <i class="bi bi-check2-circle me-2"></i>Verwerken en opslaan
                            </span>
                            <span id="btnSpinner" class="d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                Bezig met verwerken…
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card border-0 bg-light">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-lightbulb me-2 text-warning"></i>Tips voor goede resultaten</h6>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-2">Voer tekst in over <strong>één onderwerp per keer</strong>. Zo kan de chatbot gerichte antwoorden geven zonder door ongerelateerde informatie heen te zoeken.</li>
                    <li class="mb-2">Schrijf in <strong>volledige zinnen</strong>. De chatbot begrijpt context veel beter dan een opsomming van losse steekwoorden.</li>
                    <li class="mb-2">Verklaar <strong>afkortingen en vaktermen</strong> de eerste keer dat je ze gebruikt. Wat voor jou vanzelfsprekend is, hoeft dat voor de chatbot niet te zijn.</li>
                    <li>Geef de tekst een <strong>duidelijke titel</strong> die het onderwerp omschrijft, zodat je hem later makkelijk terugvindt.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/placeholder-autocomplete.js"></script>
    <script src="~/js/chunk-text-input.js"></script>
}

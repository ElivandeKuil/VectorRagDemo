@using VectorRagDemo.Models.Entities

@{
    ViewData["Title"] = "Tekst invoeren";
    var singleProject = ViewBag.SingleProject as Project;
    var inputTitle = ViewBag.InputTitle as string ?? string.Empty;
    var inputText = ViewBag.InputText as string ?? string.Empty;
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" btn-variant="outline-secondary" btn-size="sm" btn-icon="arrow-left" class="me-3"></a>
    <h1 class="mb-0"><i class="bi bi-keyboard me-2"></i>Tekst invoeren</h1>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form method="post" asp-action="TextInput" id="textInputForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label app-label class="fw-semibold">Project</label>
                        @if (singleProject != null)
                        {
                            <input type="hidden" name="projectId" value="@singleProject.ID" />
                            <p class="form-control-plaintext">@singleProject.Naam</p>
                        }
                        else
                        {
                            <select name="projectId" id="projectId" app-field required>
                                <option value="">-- Selecteer een project --</option>
                                @foreach (SelectListItem item in ViewBag.Projects)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="title" app-label class="fw-semibold">Titel</label>
                        <input type="text"
                               name="title"
                               id="title"
                               app-field
                               placeholder="Geef deze tekst een herkenbare naam"
                               value="@inputTitle"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="folderId" app-label class="fw-semibold">Map <span class="text-muted fw-normal">(optioneel)</span></label>
                        <select name="folderId" id="folderId" app-field>
                            <option value="">— Geen map —</option>
                        </select>
                    </div>

                    <div class="mb-3" id="linkField" style="display:none">
                        <label for="link" app-label class="fw-semibold">Koppeling <span class="text-muted fw-normal">(optioneel)</span></label>
                        <input type="text" name="link" id="link" app-field placeholder="https://…" />
                        <div class="form-text">URL die wordt getoond in de chatbot bij antwoorden die dit document gebruiken.</div>
                    </div>

                    <div class="mb-4">
                        <label for="text" app-label class="fw-semibold">Tekst</label>
                        <textarea name="text"
                                  id="text"
                                  app-field
                                  rows="14"
                                  placeholder="Plak of typ hier de tekst die je wilt opslaan…"
                                  required>@inputText</textarea>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="form-text">De tekst wordt automatisch opgesplitst in chunks en verwerkt.</span>
                            <span id="wordCount" class="form-text text-muted">0 woorden</span>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" btn-variant="primary" btn-size="lg" id="submitBtn">
                            <span id="btnNormal">
                                <i class="bi bi-check2-circle me-2"></i>Verwerken en opslaan
                            </span>
                            <span id="btnSpinner" class="d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                Bezig met verwerken…
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card border-0 bg-light">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-lightbulb me-2 text-warning"></i>Tips voor goede resultaten</h6>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-2">Voer tekst in over <strong>één onderwerp per keer</strong>. Zo kan de chatbot gerichte antwoorden geven zonder door ongerelateerde informatie heen te zoeken.</li>
                    <li class="mb-2">Schrijf in <strong>volledige zinnen</strong>. De chatbot begrijpt context veel beter dan een opsomming van losse steekwoorden.</li>
                    <li class="mb-2">Verklaar <strong>afkortingen en vaktermen</strong> de eerste keer dat je ze gebruikt. Wat voor jou vanzelfsprekend is, hoeft dat voor de chatbot niet te zijn.</li>
                    <li>Geef de tekst een <strong>duidelijke titel</strong> die het onderwerp omschrijft, zodat je hem later makkelijk terugvindt.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const koppelingPerProject = @Html.Raw(Json.Serialize(ViewBag.KoppelingPerProject ?? new object()));

        function updateLinkFieldVisibility(projectId) {
            const enabled = koppelingPerProject[projectId] === true;
            document.getElementById('linkField').style.display = enabled ? '' : 'none';
        }

        const initialProjectId = @(singleProject?.ID.ToString() ?? "null");
        if (initialProjectId !== null) {
            updateLinkFieldVisibility(initialProjectId);
        }

        const initialFolderData = @Html.Raw(Json.Serialize(ViewBag.FolderData ?? new object[0]));

        function buildFolderOptions(folderData, select, parentId, depth) {
            parentId = parentId ?? null;
            depth = depth ?? 0;
            const children = folderData
                .filter(f => f.parentId === parentId)
                .sort((a, b) => a.naam.localeCompare(b.naam, 'nl'));
            for (const f of children) {
                const opt = document.createElement('option');
                opt.value = f.id;
                opt.textContent = '\u00a0\u00a0'.repeat(depth * 2) + (depth > 0 ? '└ ' : '') + f.naam;
                select.appendChild(opt);
                buildFolderOptions(folderData, select, f.id, depth + 1);
            }
        }

        buildFolderOptions(initialFolderData, document.getElementById('folderId'));

        const projectSelect = document.getElementById('projectId');
        if (projectSelect) {
            updateLinkFieldVisibility(parseInt(projectSelect.value));
            projectSelect.addEventListener('change', async function () {
                updateLinkFieldVisibility(parseInt(this.value));
                const sel = document.getElementById('folderId');
                sel.innerHTML = '<option value="">— Geen map —</option>';
                if (!this.value) return;
                const resp = await fetch('/Chunk/GetFolders?projectId=' + this.value);
                const folders = await resp.json();
                buildFolderOptions(folders, sel);
            });
        }

        // Word count
        const textarea = document.getElementById('text');
        const wordCountEl = document.getElementById('wordCount');
        function updateWordCount() {
            const words = textarea.value.trim().split(/\s+/).filter(w => w.length > 0);
            wordCountEl.textContent = words.length.toLocaleString('nl-NL') + ' woorden';
        }
        textarea.addEventListener('input', updateWordCount);
        updateWordCount();

        // Spinner on submit
        document.getElementById('textInputForm').addEventListener('submit', function () {
            document.getElementById('btnNormal').classList.add('d-none');
            document.getElementById('btnSpinner').classList.remove('d-none');
            document.getElementById('submitBtn').disabled = true;
        });
    </script>
}

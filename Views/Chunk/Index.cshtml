@model List<VectorRagDemo.Models.ViewModels.DocumentViewModel>

@{
    ViewData["Title"] = "Documenten";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Documenten</h1>
    <a asp-action="Upload" class="btn btn-primary">
        <i class="bi bi-upload me-1"></i>Document uploaden
    </a>
</div>

@if (User.IsInRole("Admin") && ViewBag.Projects != null)
{
    <form method="get" asp-action="Index" class="mb-4">
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 text-muted small">Project:</label>
            @Html.DropDownList("projectId", (SelectList)ViewBag.Projects,
                new { @class = "form-select form-select-sm w-auto", onchange = "this.form.submit()" })
        </div>
    </form>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-file-earmark-text display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">Nog geen documenten geüpload</h4>
        <p class="text-muted mb-4">Upload een .txt of .docx bestand om te beginnen.</p>
        <a asp-action="Upload" class="btn btn-primary btn-lg">
            <i class="bi bi-upload me-2"></i>Eerste document uploaden
        </a>
    </div>
}
else
{
    <p class="text-muted small mb-2">Klik op een rij om een voorvertoning te tonen.</p>
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th style="width:40px"></th>
                <th>Bestandsnaam</th>
                <th>Geüpload</th>
                <th class="text-end">Acties</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in Model)
            {
                <tr class="doc-row"
                    data-bron-id="@doc.BronId"
                    data-file-name="@doc.FileName"
                    style="cursor:pointer">
                    <td>
                        @if (doc.Extension == ".docx")
                        {
                            <i class="bi bi-file-earmark-word text-primary fs-5"></i>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-text text-secondary fs-5"></i>
                        }
                    </td>
                    <td>@doc.FileName</td>
                    <td class="text-muted small">@doc.GemaaktOp.ToString("dd-MM-yyyy")</td>
                    <td class="text-end doc-actions">
                        <a asp-action="Download" asp-route-id="@doc.BronId"
                           class="btn btn-sm btn-outline-secondary me-1"
                           title="Downloaden">
                            <i class="bi bi-download"></i>
                        </a>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger btn-delete"
                                data-bron-id="@doc.BronId"
                                data-bron-name="@doc.FileName"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                title="Verwijderen">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Document verwijderen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Weet je zeker dat je <strong id="deleteFileName"></strong> wilt verwijderen?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Verwijderen
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Document preview offcanvas -->
<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="previewPanel"
     aria-labelledby="previewPanelLabel"
     style="width: min(45%, 680px)">
    <div class="offcanvas-header border-bottom">
        <div>
            <h5 class="offcanvas-title mb-0" id="previewPanelLabel">
                <i id="previewIcon" class="bi me-2"></i><span id="previewTitle"></span>
            </h5>
            <small id="previewFileName" class="text-muted"></small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div id="previewLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted small">Document laden…</p>
        </div>
        <div id="previewError" class="alert alert-danger m-3 d-none"></div>
        <pre id="previewContent"
             class="d-none m-0 p-4"
             style="white-space: pre-wrap; font-size: 0.82rem; line-height: 1.65; font-family: inherit; overflow-y: auto; height: 100%;"></pre>
        <div id="previewTruncatedNote" class="d-none border-top p-3 bg-light text-muted small">
            <i class="bi bi-info-circle me-1"></i>Voorvertoning beperkt tot de eerste 15.000 tekens.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const previewUrl = '@Url.Action("Preview")';
        const deleteActionBase = '@Url.Action("Delete")';

        // Wire up delete modal
        document.querySelectorAll('.btn-delete').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation(); // don't trigger row preview
                document.getElementById('deleteFileName').textContent = this.dataset.bronName;
                document.getElementById('deleteId').value = this.dataset.bronId;
                document.getElementById('deleteForm').action = deleteActionBase + '/' + this.dataset.bronId;
            });
        });

        // Wire up row click → preview
        document.querySelectorAll('.doc-row').forEach(function (row) {
            row.addEventListener('click', function (e) {
                if (e.target.closest('.doc-actions')) return;
                loadPreview(this.dataset.bronId, this.dataset.fileName);
            });
        });

        function loadPreview(bronId, fileName) {
            const offcanvas = bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('previewPanel'));

            document.getElementById('previewTitle').textContent = fileName;
            document.getElementById('previewFileName').textContent = '';
            document.getElementById('previewContent').textContent = '';
            document.getElementById('previewContent').classList.add('d-none');
            document.getElementById('previewError').classList.add('d-none');
            document.getElementById('previewTruncatedNote').classList.add('d-none');
            document.getElementById('previewLoading').classList.remove('d-none');

            const ext = fileName.split('.').pop().toLowerCase();
            const icon = document.getElementById('previewIcon');
            icon.className = ext === 'docx'
                ? 'bi bi-file-earmark-word text-primary me-2'
                : 'bi bi-file-earmark-text text-secondary me-2';

            offcanvas.show();

            fetch(previewUrl + '/' + bronId)
                .then(function (r) {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(function (data) {
                    document.getElementById('previewLoading').classList.add('d-none');
                    document.getElementById('previewContent').textContent = data.text || '(geen tekst gevonden)';
                    document.getElementById('previewContent').classList.remove('d-none');
                    if (data.truncated) {
                        document.getElementById('previewTruncatedNote').classList.remove('d-none');
                    }
                })
                .catch(function (err) {
                    document.getElementById('previewLoading').classList.add('d-none');
                    document.getElementById('previewError').textContent = 'Kon het document niet laden: ' + err.message;
                    document.getElementById('previewError').classList.remove('d-none');
                });
        }
    </script>
}

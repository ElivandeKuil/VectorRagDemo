@model List<VectorRagDemo.Models.ViewModels.DocumentViewModel>

@{
    ViewData["Title"] = "Documenten";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Documenten</h1>
    <a asp-action="Upload" class="btn btn-primary">
        <i class="bi bi-upload me-1"></i>Document uploaden
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-file-earmark-text display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">Nog geen documenten geüpload</h4>
        <p class="text-muted mb-4">Upload een .txt of .docx bestand om te beginnen met RAG.</p>
        <a asp-action="Upload" class="btn btn-primary btn-lg">
            <i class="bi bi-upload me-2"></i>Eerste document uploaden
        </a>
    </div>
}
else
{
    @foreach (var group in Model.GroupBy(d => d.ProjectNaam).OrderBy(g => g.Key))
    {
        <div class="mb-4">
            <h5 class="text-muted border-bottom pb-2 mb-3">
                <i class="bi bi-folder me-1"></i>@group.Key
            </h5>
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px"></th>
                        <th>Bestandsnaam</th>
                        <th class="text-center">Chunks</th>
                        <th>Geüpload</th>
                        <th class="text-end">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in group.OrderByDescending(d => d.GemaaktOp))
                    {
                        <tr>
                            <td>
                                @if (doc.Extension == ".docx")
                                {
                                    <i class="bi bi-file-earmark-word text-primary fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-text text-secondary fs-5"></i>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@doc.FileName</div>
                                <small class="text-muted">@doc.Title</small>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@doc.ChunkCount</span>
                            </td>
                            <td class="text-muted small">@doc.GemaaktOp.ToString("dd-MM-yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Download" asp-route-id="@doc.BronId"
                                   class="btn btn-sm btn-outline-secondary me-1"
                                   title="Downloaden">
                                    <i class="bi bi-download"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger btn-delete"
                                        data-bron-id="@doc.BronId"
                                        data-bron-name="@doc.FileName"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        title="Verwijderen">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Document verwijderen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Weet je zeker dat je <strong id="deleteFileName"></strong> wilt verwijderen?
                <div class="text-muted small mt-2">Alle bijbehorende chunks worden ook verwijderd. Dit kan niet ongedaan worden gemaakt.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Verwijderen
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-delete').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('deleteFileName').textContent = this.dataset.bronName;
                document.getElementById('deleteId').value = this.dataset.bronId;
                document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + this.dataset.bronId;
            });
        });
    </script>
}

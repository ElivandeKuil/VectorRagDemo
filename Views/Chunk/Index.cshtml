@model IEnumerable<VectorRagDemo.Models.Chunk>

@{
    ViewData["Title"] = "Chunks Overview";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Chunks in Database</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Chunk
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tekst</th>
            <th>Bron</th>
            <th>Project</th>
            <th>Gemaakt Op</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var chunk in Model)
        {
            <tr>
                <td>@chunk.ID</td>
                <td>@chunk.Tekst</td>
                <td>@chunk.Bron?.Title</td>
                <td>@chunk.Bron?.ProjectNavigation?.Naam</td>
                <td>@chunk.GemaaktOp.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@chunk.Status</td>
            </tr>
        }
    </tbody>
</table>

<p>Total chunks: @Model.Count()</p>
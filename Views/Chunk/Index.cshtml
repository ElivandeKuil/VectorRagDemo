@model List<VectorRagDemo.Models.ViewModels.DocumentViewModel>
@using VectorRagDemo.Models.ViewModels

@{
    ViewData["Title"] = "Documenten";
    var currentFolderId = ViewBag.CurrentFolderId as int?;
    var selectedProjectId = (int)(ViewBag.SelectedProjectId ?? 0);
    var totalDocCount = (int)(ViewBag.TotalDocCount ?? 0);
    var breadcrumb = ViewBag.Breadcrumb as List<FolderCrumb>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Documenten</h1>
    <div class="btn-group">
        <a asp-action="Upload" btn-variant="primary" btn-icon="upload" class="me-1">Document uploaden</a>
        <a asp-action="TextInput" btn-variant="outline-primary" btn-icon="keyboard" class="me-1">Tekst invoeren</a>
    </div>
</div>

@if (User.IsInRole("Admin") && ViewBag.Projects != null)
{
    <form method="get" asp-action="Index" class="mb-3">
        <div class="d-flex align-items-center gap-2">
            <label app-label class="mb-0 text-muted small">Project:</label>
            @Html.DropDownList("projectId", (SelectList)ViewBag.Projects,
                new { @class = "form-select form-select-sm w-auto", onchange = "this.form.submit()" })
        </div>
    </form>
}

<div class="row gx-4">

    @* Folder sidebar *@
    <div class="col-lg-3 col-md-4 mb-4 mb-md-0">
        <div class="folder-sidebar">
            <div class="d-flex align-items-center justify-content-between mb-2 px-1">
                <span class="small fw-semibold text-uppercase text-muted" style="letter-spacing:.05em">Mappen</span>
            </div>
            <div id="folderTree">
                <div class="text-muted small py-2 px-1">Laden…</div>
            </div>
        </div>
    </div>

    @* Document area *@
    <div class="col-lg-9 col-md-8">

        @if (breadcrumb != null && breadcrumb.Any())
        {
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="?projectId=@selectedProjectId">Alle documenten</a>
                    </li>
                    @for (int i = 0; i < breadcrumb.Count; i++)
                    {
                        var crumb = breadcrumb[i];
                        if (i < breadcrumb.Count - 1)
                        {
                            <li class="breadcrumb-item">
                                <a href="?projectId=@selectedProjectId&folderId=@crumb.Id">@crumb.Naam</a>
                            </li>
                        }
                        else
                        {
                            <li class="breadcrumb-item active" aria-current="page">@crumb.Naam</li>
                        }
                    }
                </ol>
            </nav>
        }

        @if (Model.Any())
        {
            <div class="mb-3">
                <div class="input-group input-group-sm" style="max-width:320px">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="docSearch" app-field
                           placeholder="Zoeken…" autocomplete="off" />
                    <button btn-variant="outline-secondary" btn-icon="x" class="d-none" id="docSearchClear" type="button" title="Wissen"></button>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-file-earmark-text display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">
                    @(currentFolderId.HasValue ? "Geen documenten in deze map" : "Nog geen documenten geüpload")
                </h4>
                @if (!currentFolderId.HasValue)
                {
                    <p class="text-muted mb-4">Upload een bestand of voer tekst in om te beginnen.</p>
                    <div class="btn-group">
                        <a asp-action="Upload" btn-variant="primary" btn-size="lg" btn-icon="upload" class="me-2">Document uploaden</a>
                        <a asp-action="TextInput" btn-variant="outline-primary" btn-size="lg" btn-icon="keyboard" class="me-2">Tekst invoeren</a>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted small mb-2">Klik op een rij om een voorvertoning te tonen.</p>
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px"></th>
                        <th>Bestandsnaam</th>
                        <th>Geüpload</th>
                        <th class="text-end">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model)
                    {
                        <tr class="doc-row"
                            data-bron-id="@doc.BronId"
                            data-file-name="@doc.FileName"
                            data-title="@doc.Title"
                            data-link="@(doc.Link ?? "")"
                            draggable="true"
                            style="cursor:grab">
                            <td>
                                @if (doc.Extension == ".docx")
                                {
                                    <i class="bi bi-file-earmark-word text-primary fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-text text-secondary fs-5"></i>
                                }
                            </td>
                            <td>
                                @doc.Title
                                @if (!string.IsNullOrWhiteSpace(doc.Link))
                                {
                                    <a href="@doc.Link" target="_blank" rel="noopener noreferrer"
                                       class="text-primary" style="font-size:.72rem" title="@doc.Link"
                                       onclick="event.stopPropagation()">
                                        <i class="bi bi-link-45deg"></i>@doc.Link
                                    </a>
                                }
                            </td>
                            <td class="text-muted small">
                                @doc.GemaaktOp.ToString("dd-MM-yyyy")
                                @if (!currentFolderId.HasValue && doc.FolderNaam != null)
                                {
                                    <br /><span class="text-muted" style="font-size:.75rem"><i class="bi bi-folder me-1"></i>@doc.FolderNaam</span>
                                }
                            </td>
                            <td class="text-end doc-actions">
                                <a asp-action="Download" asp-route-id="@doc.BronId"
                                   btn-variant="outline-secondary" btn-size="sm" btn-icon="download" class="me-1"
                                   title="Downloaden als .txt"></a>
                                <a asp-action="EditChunks" asp-route-bronId="@doc.BronId"
                                   btn-variant="outline-primary" btn-size="sm" btn-icon="pencil-square" class="me-1"
                                   title="Chunks bewerken"
                                   onclick="event.stopPropagation()"></a>
                                <button type="button"
                                        class="btn btn-sm @(!string.IsNullOrWhiteSpace(doc.Link) ? "btn-outline-primary" : "btn-outline-secondary") me-1 btn-set-link"
                                        data-bron-id="@doc.BronId"
                                        data-current-link="@(doc.Link ?? "")"
                                        title="Koppeling instellen">
                                    <i class="bi bi-link-45deg"></i>
                                </button>
                                <button type="button"
                                        btn-variant="outline-primary" btn-size="sm" btn-icon="folder-symlink" class="me-1 btn-move"
                                        data-bron-id="@doc.BronId"
                                        data-current-folder="@(doc.FolderId?.ToString() ?? "")"
                                        title="Verplaatsen"></button>
                                <button type="button"
                                        btn-variant="outline-danger" btn-size="sm" btn-icon="trash" class="btn-delete"
                                        data-bron-id="@doc.BronId"
                                        data-bron-name="@doc.FileName"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        title="Verwijderen"></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@* Set document link modal *@
<div class="modal fade" id="setLinkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-link-45deg me-2"></i>Koppeling instellen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="setLinkForm">
                <div class="modal-body">
                    <label app-label>URL <span class="text-muted small">(optioneel)</span></label>
                    <input type="text" id="setLinkInput" app-field placeholder="https://…" />
                    <div class="form-text">Laat leeg om de koppeling te verwijderen.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" btn-variant="secondary" btn-size="sm" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" btn-variant="primary" btn-size="sm">Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Rename document modal *@
<div class="modal fade" id="renameDocModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Document hernoemen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="renameDocForm">
                <div class="modal-body">
                    <label app-label>Nieuwe titel</label>
                    <input type="text" id="renameDocInput" app-field required />
                </div>
                <div class="modal-footer">
                    <button type="button" btn-variant="secondary" btn-size="sm" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" btn-variant="primary" btn-size="sm">Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Delete modal *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Document verwijderen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Weet je zeker dat je <strong id="deleteFileName"></strong> wilt verwijderen?</div>
            <div class="modal-footer">
                <button type="button" btn-variant="secondary" data-bs-dismiss="modal">Annuleren</button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" btn-variant="danger" btn-icon="trash" class="me-1">Verwijderen</button>
                </form>
            </div>
        </div>
    </div>
</div>

@* Create folder modal *@
<div class="modal fade" id="createFolderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-folder-plus me-2"></i>Nieuwe map</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createFolderForm">
                <div class="modal-body">
                    <label app-label>Naam</label>
                    <input type="text" id="createFolderInput" app-field placeholder="Mapnaam…" required />
                </div>
                <div class="modal-footer">
                    <button type="button" btn-variant="secondary" btn-size="sm" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" btn-variant="primary" btn-size="sm">Aanmaken</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Rename folder modal *@
<div class="modal fade" id="renameFolderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Map hernoemen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="renameFolderForm">
                <div class="modal-body">
                    <label app-label>Nieuwe naam</label>
                    <input type="text" id="renameFolderInput" app-field required />
                </div>
                <div class="modal-footer">
                    <button type="button" btn-variant="secondary" btn-size="sm" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" btn-variant="primary" btn-size="sm">Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Move document modal *@
<div class="modal fade" id="moveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-folder-symlink me-2"></i>Verplaatsen naar map</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="moveFolderForm">
                <div class="modal-body">
                    <label app-label>Bestemming</label>
                    <select id="moveFolderSelect" app-field></select>
                </div>
                <div class="modal-footer">
                    <button type="button" btn-variant="secondary" btn-size="sm" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" btn-variant="primary" btn-size="sm">Verplaatsen</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Preview offcanvas *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="previewPanel"
     aria-labelledby="previewPanelLabel" style="width: min(45%, 680px)">
    <div class="offcanvas-header border-bottom">
        <div>
            <h5 class="offcanvas-title mb-0" id="previewPanelLabel">
                <i id="previewIcon" class="bi me-2"></i><span id="previewTitle"></span>
            </h5>
            <small id="previewFileName" class="text-muted"></small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div id="previewLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted small">Document laden…</p>
        </div>
        <div id="previewError" class="alert alert-danger m-3 d-none"></div>
        <pre id="previewContent" class="d-none m-0 p-4"
             style="white-space:pre-wrap;font-size:.82rem;line-height:1.65;font-family:inherit;overflow-y:auto;height:100%"></pre>
        <div id="previewTruncatedNote" class="d-none border-top p-3 bg-light text-muted small">
            <i class="bi bi-info-circle me-1"></i>Voorvertoning beperkt tot de eerste 15.000 tekens.
        </div>
    </div>
</div>

<div id="chunk-index-data"
     data-folder-data="@(Json.Serialize(ViewBag.FolderTreeData ?? new object[0]).ToString())"
     data-current-folder-id="@(currentFolderId.HasValue ? currentFolderId.Value.ToString() : "")"
     data-project-id="@selectedProjectId"
     data-total-doc-count="@totalDocCount"
     data-delete-url="@Url.Action("Delete")"
     data-preview-url="@Url.Action("Preview")"
     style="display:none;"></div>

@section Scripts {
<script src="~/js/chunk-index.js"></script>
}

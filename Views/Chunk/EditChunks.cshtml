@model List<VectorRagDemo.Models.Entities.Chunk>
@{
    var bron = ViewBag.Bron as VectorRagDemo.Models.Entities.Bron;
    int projectId = ViewBag.ProjectId ?? 0;
    ViewData["Title"] = $"Chunks bewerken — {bron?.Title}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="text-muted small me-2">
            <i class="bi bi-arrow-left me-1"></i>Terug naar documenten
        </a>
        <h1 class="mb-0 mt-1 d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-text me-2"></i><span id="docTitle">@bron?.Title</span>
            <button type="button"
                    btn-variant="outline-secondary" btn-size="sm" btn-icon="pencil"
                    class="btn-rename-doc"
                    data-bron-id="@bron?.ID"
                    data-current-title="@bron?.Title"
                    title="Hernoemen"></button>
        </h1>
        <p class="text-muted small mb-0">@Model.Count chunk@(Model.Count != 1 ? "s" : "") &mdash; bewerk tekst en sla op om de embedding automatisch bij te werken.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <button type="button" class="btn btn-sm btn-outline-secondary"
                data-bs-toggle="offcanvas" data-bs-target="#placeholderPanel" aria-controls="placeholderPanel">
            <i class="bi bi-braces me-1"></i>Variabelen
            <span class="badge bg-primary ms-1" id="placeholderCount">…</span>
        </button>
        <a asp-action="Download" asp-route-id="@bron?.ID"
           btn-variant="outline-secondary" btn-icon="download" title="Downloaden als .txt"></a>
    </div>
</div>

<!-- Placeholder side panel (Bootstrap offcanvas) -->
<div class="offcanvas offcanvas-end placeholder-panel" tabindex="-1" id="placeholderPanel" aria-labelledby="placeholderPanelLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="placeholderPanelLabel">
            <i class="bi bi-braces me-2 text-primary"></i>Variabelen
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Sluiten"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column gap-3">
        <p class="text-muted small mb-0">
            Typ <code>@@@@naam</code> in een chunktekst. Bij ophalen wordt de variabele vervangen door de bijbehorende waarde.
            Typ <kbd>@@@@</kbd> in een tekstveld voor autocomplete.
        </p>

        <!-- Placeholder list -->
        <div id="placeholderList" class="d-flex flex-column gap-1">
            <div class="text-muted small text-center py-2">Laden…</div>
        </div>

        <hr class="my-1">

        <!-- Add / edit form -->
        <div>
            <h6 class="fw-semibold mb-2" id="phFormTitle">Nieuwe variabele</h6>
            <div class="mb-2">
                <label class="form-label small mb-1">Naam <span class="text-muted">(letters, cijfers, _)</span></label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text text-primary fw-bold">@@</span>
                    <input type="text" id="phNaam" class="form-control" placeholder="basisprijs">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label small mb-1">Waarde</label>
                <input type="text" id="phWaarde" class="form-control form-control-sm" placeholder="bijv. €99,95">
            </div>
            <input type="hidden" id="phEditId" value="0">
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm flex-grow-1" id="btnSavePlaceholder">
                    <i class="bi bi-check-lg me-1"></i>Opslaan
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="btnCancelEdit">
                    Annuleren
                </button>
            </div>
            <div id="phFormError" class="text-danger small mt-2 d-none"></div>
        </div>
    </div>
</div>

<div id="chunk-edit-data"
     data-bron-id="@bron!.ID"
     data-project-id="@projectId"
     style="display:none;"></div>
<div id="chunkList">
    @for (int i = 0; i < Model.Count; i++)
    {
        var chunk = Model[i];
        <div class="card mb-3 chunk-card" id="chunk-card-@chunk.ID" data-chunk-id="@chunk.ID">
            <div class="card-header d-flex align-items-center justify-content-between py-2">
                <span class="text-muted small fw-semibold">Chunk @(i + 1)</span>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-muted small chunk-word-count" id="wc-@chunk.ID">
                        @chunk.Tekst.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length woorden
                    </span>
                    <button type="button"
                            class="btn btn-sm btn-outline-primary btn-save-chunk"
                            data-chunk-id="@chunk.ID"
                            title="Opslaan en embedding vernieuwen">
                        <i class="bi bi-floppy me-1"></i>Opslaan
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-danger btn-delete-chunk"
                            data-chunk-id="@chunk.ID"
                            title="Chunk verwijderen">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <textarea class="form-control border-0 rounded-0 chunk-textarea"
                          id="tekst-@chunk.ID"
                          rows="6"
                          style="resize:vertical;font-size:.85rem;line-height:1.65;font-family:inherit">@chunk.Tekst</textarea>
            </div>
            <div class="card-footer py-1 px-3 d-none chunk-status" id="status-@chunk.ID"></div>
        </div>
    }
</div>

<div class="card border-dashed mt-4" id="addChunkCard">
    <div class="card-header py-2">
        <span class="fw-semibold"><i class="bi bi-plus-circle me-2 text-primary"></i>Nieuwe chunk toevoegen</span>
    </div>
    <div class="card-body p-0">
        <textarea id="newChunkText" class="form-control border-0 rounded-0"
                  rows="5"
                  placeholder="Typ of plak hier de tekst voor de nieuwe chunk…"
                  style="resize:vertical;font-size:.85rem;line-height:1.65;font-family:inherit"></textarea>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center py-2">
        <span class="text-muted small" id="newChunkWc">0 woorden</span>
        <button type="button" btn-variant="primary" btn-icon="plus-circle" id="btnAddChunk">
            Chunk toevoegen &amp; embedden
        </button>
    </div>
</div>

<!-- Autocomplete dropdown (portal, appended to body) -->
<div id="phAutocomplete" class="ph-autocomplete" style="display:none;" role="listbox"></div>

<!-- Rename document modal -->
<div class="modal fade" id="renameDocModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Document hernoemen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="renameDocForm">
                <div class="modal-body">
                    <label class="form-label">Nieuwe titel</label>
                    <input type="text" id="renameDocInput" class="form-control" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-primary btn-sm">Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/placeholder-autocomplete.js"></script>
<script src="~/js/chunk-edit.js"></script>
}

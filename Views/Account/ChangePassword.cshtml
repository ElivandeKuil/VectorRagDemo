@model VectorRagDemo.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Wachtwoord wijzigen";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">

        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                 style="width:64px;height:64px">
                <i class="bi bi-key fs-3"></i>
            </div>
            <h4 class="mb-0">Wachtwoord wijzigen</h4>
            <p class="text-muted small mt-1">Kies een sterk nieuw wachtwoord van minimaal 8 tekens.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="HuidigWachtwoord" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="HuidigWachtwoord" class="form-control" autocomplete="current-password" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NieuwWachtwoord" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="NieuwWachtwoord" class="form-control" autocomplete="new-password" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BevestigWachtwoord" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="BevestigWachtwoord" class="form-control" autocomplete="new-password" />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" btn-variant="primary" btn-icon="check-circle" class="me-2">Wachtwoord opslaan</button>
                        <a asp-controller="Dashboard" asp-action="Index" btn-variant="outline-secondary">
                            Annuleren
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

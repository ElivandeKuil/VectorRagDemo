@model List<VectorRagDemo.Models.ViewModels.GebruikerListItemViewModel>
@{
    ViewData["Title"] = "Gebruikersbeheer";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-people me-2"></i>Gebruikersbeheer</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Nieuwe gebruiker
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Naam</th>
                    <th>Gebruikersnaam</th>
                    <th>Rollen</th>
                    <th>Status</th>
                    <th class="text-end">Acties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.Gebruiker.Status == 0 ? "table-secondary text-muted" : "")">
                        <td class="align-middle">@item.Gebruiker.Naam</td>
                        <td class="align-middle">@item.Gebruiker.GebruikersNaam</td>
                        <td class="align-middle">
                            @if (item.Rollen.Any())
                            {
                                foreach (var rol in item.Rollen)
                                {
                                    <span class="badge bg-primary me-1">@rol</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Geen rollen</span>
                            }
                        </td>
                        <td class="align-middle">
                            @if (item.Gebruiker.Status == 1)
                            {
                                <span class="badge bg-success">Actief</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactief</span>
                            }
                        </td>
                        <td class="align-middle text-end">
                            <a asp-action="Edit" asp-route-id="@item.Gebruiker.ID" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i> Bewerken
                            </a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.Gebruiker.ID" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (item.Gebruiker.Status == 1)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-warning"
                                            onclick="return confirm('Gebruiker \'@item.Gebruiker.Naam\' deactiveren?')">
                                        <i class="bi bi-person-dash"></i> Deactiveren
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-person-check"></i> Activeren
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Geen gebruikers gevonden.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model VectorRagDemo.Models.ViewModels.WoordenboekViewModel
@{
    ViewData["Title"] = "Woordenboek – " + Model.Project.Naam;
    var isAdmin = User.IsInRole("Admin");
}

@* ─── HEADER ──────────────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-1"><i class="bi bi-book me-2 text-primary"></i>Woordenboek – @Model.Project.Naam</h4>
        <span class="badge bg-secondary">@Model.TotaalAantal term@(Model.TotaalAantal == 1 ? "" : "en") opgeslagen</span>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (isAdmin)
        {
            <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
                @Html.DropDownList("projectId",
                    (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewData["AdminProjects"]!,
                    "– Selecteer project –",
                    new { @class = "form-select form-select-sm", onchange = "this.form.submit()", style = "min-width:180px;" })
            </form>
        }
        <a asp-action="Aanmaken"
           asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
           class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Nieuwe term
        </a>
    </div>
</div>

@* ─── TABLE ────────────────────────────────────────────────────────────── *@
@if (!Model.Entries.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-book display-4 d-block mb-3 opacity-50"></i>
        <h5>Geen termen gevonden</h5>
        <p class="mb-0 small">Voeg termen toe om de AI te voorzien van extra context.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:200px"><i class="bi bi-tag me-1"></i>Term</th>
                    <th>Omschrijving</th>
                    <th class="text-nowrap"><i class="bi bi-calendar3 me-1"></i>Aangemaakt</th>
                    <th class="text-center">Bijgewerkt</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Entries)
                {
                    <tr>
                        <td class="fw-semibold small">@e.Woord</td>
                        <td class="small" style="max-width:400px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                            title="@e.Omschrijving">
                            @e.Omschrijving
                        </td>
                        <td class="text-nowrap small text-muted">@e.GemaaktOp.ToString("dd-MM-yyyy")</td>
                        <td class="text-center small text-muted">
                            @if (e.GewijzigdOp.HasValue)
                            {
                                <span title="@e.GewijzigdOp.Value.ToString("dd-MM-yyyy HH:mm")">
                                    <i class="bi bi-check-circle text-success"></i>
                                </span>
                            }
                            else
                            {
                                <text>–</text>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Bewerk"
                               asp-route-id="@e.ID"
                               asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
                               class="btn btn-outline-primary btn-sm me-1">
                                <i class="bi bi-pencil me-1"></i>Bewerken
                            </a>
                            <form asp-action="Verwijder" method="post" class="d-inline"
                                  onsubmit="return confirm('Term \'@e.Woord\' verwijderen?')">
                                <input type="hidden" name="id" value="@e.ID" />
                                <input type="hidden" name="projectId" value="@(isAdmin ? Model.Project.ID : 0)" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── PAGINATION ──────────────────────────────────────────────────────── *@
    @if (Model.TotaalPaginas > 1)
    {
        var pagina = Model.Pagina;
        var totaalPaginas = Model.TotaalPaginas;

        <nav class="mt-3" aria-label="Paginering woordenboek">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(pagina <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
                       asp-route-pagina="@(pagina - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @{
                    var pagesToShow = new SortedSet<int> { 1, totaalPaginas };
                    for (int p = Math.Max(1, pagina - 2); p <= Math.Min(totaalPaginas, pagina + 2); p++)
                        pagesToShow.Add(p);
                    int? prev = null;
                    foreach (var p in pagesToShow)
                    {
                        if (prev.HasValue && p - prev.Value > 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item @(p == pagina ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
                               asp-route-pagina="@p">@p</a>
                        </li>
                        prev = p;
                    }
                }
                <li class="page-item @(pagina >= totaalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-projectId="@(isAdmin ? Model.Project.ID : 0)"
                       asp-route-pagina="@(pagina + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}

@{
    ViewData["Title"] = "Manage Scraping Elements";
}


<div class="container">
    <h1 class="mb-4">Manage Scraping Elements</h1>

    <div class="alert alert-info">
        <strong>About Scraping Elements:</strong>
        Scraping elements define what data to extract from web pages. Each element consists of a <strong>selector</strong> (CSS or XPath),
        an <strong>attribute name</strong> (what to extract), and optional <strong>default values</strong>.
        Configure elements per project and they will be used automatically during scraping.
    </div>

    <!-- Project Selection -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-8">
                    <label for="projectSelect" app-label>
                        <strong>Select Project</strong>
                    </label>
                    <select app-field id="projectSelect" onchange="loadElements()">
                        <option value="">-- Select a Project --</option>
                        @foreach (var project in ViewBag.Projects)
                        {
                            <option value="@project.ID">@project.Naam</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button btn-variant="primary" btn-icon="plus-circle" class="w-100" onclick="showAddModal()" id="addButton" disabled> Add New Element</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Elements List -->
    <div id="elementsContainer" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>Configured Elements</h4>
            <a asp-action="Index" btn-variant="secondary" btn-icon="arrow-left"> Back to Scraper</a>
        </div>
        <div id="elementsList" class="row g-3">
            <!-- Elements will be loaded here -->
        </div>
        <div id="emptyState" class="alert alert-warning" style="display: none;">
            <i class="bi bi-info-circle"></i> No scraping elements configured for this project yet. Click "Add New Element" to get started.
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="elementModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Scraping Element</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="elementForm">
                    <input type="hidden" id="elementId" value="0">
                    <input type="hidden" id="elementProjectId" value="0">

                    <div class="mb-3">
                        <label for="elementName" app-label>
                            Element Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" app-field id="elementName" required
                               placeholder="e.g., ProductTitle, ProductDescription, ProductPrice" />
                        <div class="form-text">A descriptive name for this element (will appear in chunk output)</div>
                    </div>

                    <div class="mb-3">
                        <label for="selector" app-label>
                            Selector (CSS or XPath) <span class="text-danger">*</span>
                        </label>
                        <input type="text" app-field class="selector-input" id="selector" required
                               placeholder="e.g., .product-title, //h1[@@class='title']" />
                        <div class="form-text">
                            Use CSS selectors (e.g., <code>.class-name</code>, <code>#id</code>) or XPath (e.g., <code>//div[@@class='content']</code>)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="attributeName" app-label>
                            Attribute Name <span class="text-danger">*</span>
                        </label>
                        <select app-field id="attributeName">
                            <option value="text">text (extract text content)</option>
                            <option value="href">href (extract link URL)</option>
                            <option value="src">src (extract image/resource URL)</option>
                            <option value="alt">alt (extract alt text)</option>
                            <option value="title">title (extract title attribute)</option>
                            <option value="value">value (extract input value)</option>
                        </select>
                        <div class="form-text">Choose what to extract from the selected element</div>
                    </div>

                    <div class="mb-3">
                        <label for="defaultValue" app-label>
                            Default Value (optional)
                        </label>
                        <input type="text" app-field id="defaultValue"
                               placeholder="Value to use if element is not found" />
                        <div class="form-text">Leave empty if no default value needed</div>
                    </div>

                    <div class="mb-3">
                        <label for="sortOrder" app-label>
                            Sort Order <span class="text-danger">*</span>
                        </label>
                        <input type="number" app-field id="sortOrder" value="1" min="1" required />
                        <div class="form-text">Determines the order elements appear in the output (lower numbers first)</div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input app-field type="checkbox" id="isRequired"/>
                            <label app-label="check" for="isRequired">
                                Required Element
                            </label>
                        </div>
                        <div class="form-text">Check if this element must be present</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" btn-variant="secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" btn-variant="primary" onclick="saveElement()">Save Element</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentProjectId = 0;
    let elementModal = null;

    document.addEventListener('DOMContentLoaded', function() {
        elementModal = new bootstrap.Modal(document.getElementById('elementModal'));
    });

    function loadElements() {
        const projectId = parseInt(document.getElementById('projectSelect').value);
        currentProjectId = projectId;

        if (!projectId) {
            document.getElementById('elementsContainer').style.display = 'none';
            document.getElementById('addButton').disabled = true;
            return;
        }

        document.getElementById('addButton').disabled = false;

        fetch(`@Url.Action("GetScrapingElements", "Scraper")?projectId=${projectId}`)
            .then(response => response.json())
            .then(data => {
                displayElements(data);
            })
            .catch(error => {
                alert('Error loading elements: ' + error.message);
            });
    }

    function displayElements(elements) {
        const container = document.getElementById('elementsList');
        const emptyState = document.getElementById('emptyState');
        const elementsContainer = document.getElementById('elementsContainer');

        elementsContainer.style.display = 'block';

        if (!elements || elements.length === 0) {
            container.innerHTML = '';
            emptyState.style.display = 'block';
            return;
        }

        emptyState.style.display = 'none';

        let html = '';
        elements.forEach(element => {
            html += `
                <div class="col-md-6 col-lg-4">
                    <div class="card element-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">${escapeHtml(element.elementName)}</h5>
                                <span class="badge bg-primary badge-sortorder">#${element.sortOrder}</span>
                            </div>
                            <p class="card-text">
                                <small class="text-muted">Selector:</small><br>
                                <code class="selector-input">${escapeHtml(element.selector)}</code>
                            </p>
                            <p class="card-text mb-2">
                                <small class="text-muted">Attribute:</small>
                                <span class="badge bg-secondary">${escapeHtml(element.attributeName)}</span>
                                ${element.isRequired ? '<span class="badge bg-warning text-dark ms-1">Required</span>' : ''}
                            </p>
                            ${element.defaultValue ? `<p class="card-text"><small class="text-muted">Default:</small> ${escapeHtml(element.defaultValue)}</p>` : ''}
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group w-100" role="group">
                                <button class="btn btn-sm btn-outline-primary" onclick="editElement(${element.id})">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteElement(${element.id})">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        });

        container.innerHTML = html;
    }

    function showAddModal() {
        document.getElementById('modalTitle').textContent = 'Add Scraping Element';
        document.getElementById('elementForm').reset();
        document.getElementById('elementId').value = '0';
        document.getElementById('elementProjectId').value = currentProjectId;
        document.getElementById('sortOrder').value = '1';
        document.getElementById('attributeName').value = 'text';
        elementModal.show();
    }

    function editElement(id) {
        fetch(`@Url.Action("GetScrapingElements", "Scraper")?projectId=${currentProjectId}`)
            .then(response => response.json())
            .then(elements => {
                const element = elements.find(e => e.id === id);
                if (!element) {
                    alert('Element not found');
                    return;
                }

                document.getElementById('modalTitle').textContent = 'Edit Scraping Element';
                document.getElementById('elementId').value = element.id;
                document.getElementById('elementProjectId').value = element.project;
                document.getElementById('elementName').value = element.elementName;
                document.getElementById('selector').value = element.selector;
                document.getElementById('attributeName').value = element.attributeName;
                document.getElementById('defaultValue').value = element.defaultValue || '';
                document.getElementById('sortOrder').value = element.sortOrder;
                document.getElementById('isRequired').checked = element.isRequired;

                elementModal.show();
            })
            .catch(error => {
                alert('Error loading element: ' + error.message);
            });
    }

    function saveElement() {
        const form = document.getElementById('elementForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const elementId = parseInt(document.getElementById('elementId').value);
        const data = {
            id: elementId,
            projectId: parseInt(document.getElementById('elementProjectId').value),
            elementName: document.getElementById('elementName').value,
            selector: document.getElementById('selector').value,
            attributeName: document.getElementById('attributeName').value,
            defaultValue: document.getElementById('defaultValue').value,
            sortOrder: parseInt(document.getElementById('sortOrder').value),
            isRequired: document.getElementById('isRequired').checked
        };

        const url = elementId === 0
            ? '@Url.Action("CreateScrapingElement", "Scraper")'
            : '@Url.Action("UpdateScrapingElement", "Scraper")';

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                elementModal.hide();
                loadElements();
            } else {
                alert('Error saving element: ' + (result.error || 'Unknown error'));
            }
        })
        .catch(error => {
            alert('Error saving element: ' + error.message);
        });
    }

    function deleteElement(id) {
        if (!confirm('Are you sure you want to delete this scraping element?')) {
            return;
        }

        fetch('@Url.Action("DeleteScrapingElement", "Scraper")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(id)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                loadElements();
            } else {
                alert('Error deleting element: ' + (result.error || 'Unknown error'));
            }
        })
        .catch(error => {
            alert('Error deleting element: ' + error.message);
        });
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
}

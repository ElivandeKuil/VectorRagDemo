@{
    ViewData["Title"] = "Product Scraper";
}


<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="mb-3">
                <i class="bi bi-globe"></i> Web Scraper
            </h1>
        </div>
    </div>

    <div class="card info-card mb-4">
        <div class="card-body">
            <h5 class="card-title"><i class="bi bi-info-circle"></i> How It Works</h5>
            <ol class="mb-0">
                <li><strong>Configure Elements:</strong> Define what to scrape using the <a href="@Url.Action("ManageElements")" class="text-white text-decoration-underline">Manage Scraping Elements</a> page</li>
                <li><strong>Select Project:</strong> Choose your project with configured scraping elements</li>
                <li><strong>Choose Mode:</strong> Pick how to discover products (sitemap, single URL, or multi-page)</li>
                <li><strong>Start Scraping:</strong> Products are converted to text chunks with 768D embeddings and stored in the vector database</li>
            </ol>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form id="scrapeForm">
                <!-- Project Selection -->
                <div class="mb-4">
                    <h5 class="mb-3"><i class="bi bi-folder"></i> Select Project</h5>
                    <select app-field="lg" id="projectId" required>
                        <option value="">-- Select a Project --</option>
                        @foreach (var project in ViewBag.Projects)
                        {
                            <option value="@project.ID">@project.Naam</option>
                        }
                    </select>
                    <div class="form-text mt-2">
                        <i class="bi bi-lightbulb"></i> Scraping elements configured for this project will be used automatically.
                        <a href="@Url.Action("ManageElements")" target="_blank">Configure elements</a>
                    </div>
                </div>

                <hr class="my-4">

                <!-- URL Configuration -->
                <h5 class="mb-3"><i class="bi bi-link-45deg"></i> Sitemap Configuration</h5>

                <div class="mb-3">
                    <label for="baseUrl" app-label>Website Base URL <span class="text-danger">*</span></label>
                    <input type="url" app-field="lg" id="baseUrl"
                           placeholder="https://www.example.com" required readonly />
                    <div class="form-text" id="baseUrlHelp">
                        <i class="bi bi-lock"></i> Auto-filled from project configuration
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="sitemapUrl" app-label>Sitemap URL (optional)</label>
                        <input type="url" app-field id="sitemapUrl"
                               placeholder="https://www.example.com/sitemap.xml" />
                        <div class="form-text">Leave empty for auto-discovery</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="urlFilterPattern" app-label>URL Filter Pattern (optional)</label>
                        <input type="text" app-field id="urlFilterPattern"
                               placeholder="/product/ or /item/" />
                        <div class="form-text">Only scrape URLs containing this text</div>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Storage Configuration -->
                <h5 class="mb-3"><i class="bi bi-database"></i> Storage Configuration</h5>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-check form-check-inline">
                            <input app-field type="radio" name="bronMode" id="bronExisting" value="existing" checked onchange="updateBronFields()"/>
                            <label app-label="check" for="bronExisting">
                                Use Existing Source
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input app-field type="radio" name="bronMode" id="bronNew" value="new" onchange="updateBronFields()"/>
                            <label app-label="check" for="bronNew">
                                Create New Source
                            </label>
                        </div>
                    </div>
                </div>

                <div id="existingBronGroup" class="mb-3">
                    <label for="bronId" app-label>Select Source (Bron)</label>
                    <select app-field id="bronId">
                        <option value="">-- Select a Source --</option>
                        @foreach (var bron in ViewBag.Bronnen)
                        {
                            <option value="@bron.ID">@bron.Title (@bron.ProjectNavigation?.Naam)</option>
                        }
                    </select>
                </div>

                <div id="newBronGroup" style="display: none;">
                    <div class="mb-3">
                        <label for="bronTitle" app-label>New Source Title</label>
                        <input type="text" app-field id="bronTitle" placeholder="e.g., Example.com Product Catalog" />
                        <div class="form-text">Give this source a descriptive name</div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="maxProducts" app-label>
                        <i class="bi bi-speedometer2"></i> Maximum Products
                    </label>
                    <input type="number" app-field id="maxProducts" value="50" min="1" max="1000" />
                    <div class="form-text">Limit the number of products to scrape (prevents timeouts)</div>
                </div>

                <!-- Action Buttons -->
                <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                    <div>
                        <button type="submit" btn-variant="primary" btn-size="lg" btn-icon="play-circle" id="startButton"> Start Scraping</button>
                    </div>
                    <div class="btn-group">
                        <a href="@Url.Action("ManageElements")" btn-variant="outline-secondary" btn-icon="gear"> Manage Elements</a>
                        <a href="@Url.Action("Index", "Chunk")" btn-variant="outline-secondary" btn-icon="list"> View Chunks</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Progress Indicator -->
    <div class="scraping-progress" id="progress">
        <div class="card border-primary shadow-lg">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" style="width: 4rem; height: 4rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h4 class="mb-3">Scraping in Progress...</h4>
                <p class="text-muted mb-0">
                    Fetching and processing products. This may take several minutes depending on the number of products.
                </p>
                <div class="progress mt-4" style="height: 30px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%">
                        Processing...
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Display -->
    <div class="results-container" id="results">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-check-circle"></i> Scraping Complete</h5>
            </div>
            <div class="card-body">
                <div id="resultsContent"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentProject = null;

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        // Add event listener for project selection
        document.getElementById('projectId').addEventListener('change', loadProjectDetails);
    });

    async function loadProjectDetails() {
        const projectId = parseInt(document.getElementById('projectId').value);

        if (!projectId) {
            currentProject = null;
            document.getElementById('baseUrl').value = '';
            return;
        }

        try {
            const response = await fetch(`@Url.Action("GetProjectDetails", "Scraper")?projectId=${projectId}`);
            const data = await response.json();

            if (data.success && data.project) {
                currentProject = data.project;
                // Update the baseUrl field with project data
                document.getElementById('baseUrl').value = data.project.baseUrl || '';
            } else {
                alert('Error loading project details: ' + (data.error || 'Unknown error'));
                currentProject = null;
                document.getElementById('baseUrl').value = '';
            }
        } catch (error) {
            alert('Error loading project details: ' + error.message);
            currentProject = null;
            document.getElementById('baseUrl').value = '';
        }
    }

    function updateBronFields() {
        const mode = document.querySelector('input[name="bronMode"]:checked').value;
        const existingGroup = document.getElementById('existingBronGroup');
        const newGroup = document.getElementById('newBronGroup');

        if (mode === 'new') {
            existingGroup.style.display = 'none';
            newGroup.style.display = 'block';
        } else {
            existingGroup.style.display = 'block';
            newGroup.style.display = 'none';
        }
    }

    document.getElementById('scrapeForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const bronMode = document.querySelector('input[name="bronMode"]:checked').value;
        const projectId = parseInt(document.getElementById('projectId').value);

        // Validation
        if (!projectId) {
            alert('Please select a project');
            return;
        }

        const baseUrl = document.getElementById('baseUrl').value;
        if (!baseUrl) {
            alert('Please enter a URL or select a project with a configured base URL');
            return;
        }

        const requestData = {
            baseUrl: baseUrl,
            scrapeMode: 'sitemap',
            productLinkSelector: '',
            sitemapUrl: document.getElementById('sitemapUrl').value || '',
            urlFilterPattern: document.getElementById('urlFilterPattern').value || '',
            maxProducts: parseInt(document.getElementById('maxProducts').value),
            createNewBron: bronMode === 'new',
            bronTitle: document.getElementById('bronTitle')?.value || '',
            projectId: projectId,
            bronId: parseInt(document.getElementById('bronId')?.value) || 0
        };

        if (bronMode === 'existing' && !requestData.bronId) {
            alert('Please select a source (Bron)');
            return;
        }

        if (bronMode === 'new' && !requestData.bronTitle) {
            alert('Please enter a source title');
            return;
        }

        // Show progress
        document.getElementById('progress').style.display = 'block';
        document.getElementById('results').style.display = 'none';
        document.getElementById('startButton').disabled = true;
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });

        try {
            const response = await fetch('@Url.Action("ScrapeProducts", "Scraper")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(requestData)
            });

            const data = await response.json();

            // Hide progress
            document.getElementById('progress').style.display = 'none';
            document.getElementById('startButton').disabled = false;

            if (data.success) {
                displayResults(data);
            } else {
                alert('Error: ' + data.error);
            }
        } catch (error) {
            document.getElementById('progress').style.display = 'none';
            document.getElementById('startButton').disabled = false;
            alert('Error: ' + error.message);
        }
    });

    function displayResults(data) {
        const resultsContainer = document.getElementById('results');
        const resultsContent = document.getElementById('resultsContent');

        let html = '<div class="row mb-4">';
        html += '<div class="col-md-3"><div class="card text-center"><div class="card-body">';
        html += `<h2 class="text-primary">${data.totalProducts || 0}</h2>`;
        html += '<p class="text-muted mb-0">Products Found</p></div></div></div>';

        html += '<div class="col-md-3"><div class="card text-center"><div class="card-body">';
        html += `<h2 class="text-success">${data.successCount || 0}</h2>`;
        html += '<p class="text-muted mb-0">Successfully Scraped</p></div></div></div>';

        html += '<div class="col-md-3"><div class="card text-center"><div class="card-body">';
        html += `<h2 class="text-danger">${data.errorCount || 0}</h2>`;
        html += '<p class="text-muted mb-0">Errors</p></div></div></div>';

        html += '<div class="col-md-3"><div class="card text-center"><div class="card-body">';
        html += `<h2 class="text-info">${data.bronId || 'N/A'}</h2>`;
        html += '<p class="text-muted mb-0">Source ID</p></div></div></div>';
        html += '</div>';

        html += `<div class="alert alert-info"><strong>Discovery Method:</strong> ${escapeHtml(data.discoveryMethod || 'N/A')}</div>`;

        if (data.results && data.results.length > 0) {
            html += '<h6 class="mb-3"><i class="bi bi-check-circle"></i> Success Log:</h6>';
            html += '<div style="max-height: 300px; overflow-y: auto;" class="border rounded p-2">';
            data.results.forEach(result => {
                html += `<div class="result-item result-success"><i class="bi bi-check"></i> ${escapeHtml(result)}</div>`;
            });
            html += '</div>';
        }

        if (data.errors && data.errors.length > 0) {
            html += '<h6 class="mt-4 mb-3"><i class="bi bi-exclamation-triangle"></i> Error Log:</h6>';
            html += '<div style="max-height: 200px; overflow-y: auto;" class="border rounded p-2">';
            data.errors.forEach(error => {
                html += `<div class="result-item result-error"><i class="bi bi-x"></i> ${escapeHtml(error)}</div>`;
            });
            html += '</div>';
        }

        html += '<div class="mt-4 d-grid gap-2 d-md-flex">';
        html += '<a href="@Url.Action("Index", "Chunk")" class="btn btn-primary"><i class="bi bi-list"></i> View All Chunks</a>';
        html += '<a href="@Url.Action("Index", "Chat")" class="btn btn-success"><i class="bi bi-chat-dots"></i> Test in Chat</a>';
        html += '<button class="btn btn-secondary" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i> Scrape More</button>';
        html += '</div>';

        resultsContent.innerHTML = html;
        resultsContainer.style.display = 'block';
        window.scrollTo({ top: resultsContainer.offsetTop - 100, behavior: 'smooth' });
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
}

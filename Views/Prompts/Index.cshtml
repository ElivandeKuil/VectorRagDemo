@model IEnumerable<VectorRagDemo.Models.Prompt>

@{
    ViewData["Title"] = "Prompts Overview";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Prompts Management</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Prompt
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Project</th>
                    <th>Prompt Type</th>
                    <th>System Instruction</th>
                    <th>Content Preview</th>
                    <th>Created</th>
                    <th>Modified</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prompt in Model)
                {
                    <tr>
                        <td>@prompt.ID</td>
                        <td>@prompt.ProjectNavigation?.Naam</td>
                        <td>@prompt.PromptTypeNavigation?.Omschrijving</td>
                        <td>
                            @if (prompt.SystemInstruction.Length > 50)
                            {
                                @(prompt.SystemInstruction.Substring(0, 50) + "...")
                            }
                            else
                            {
                                @prompt.SystemInstruction
                            }
                        </td>
                        <td>
                            @if (prompt.Content.Length > 50)
                            {
                                @(prompt.Content.Substring(0, 50) + "...")
                            }
                            else
                            {
                                @prompt.Content
                            }
                        </td>
                        <td>@prompt.GemaaktOp.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (prompt.GewijzigdOp.HasValue)
                            {
                                @prompt.GewijzigdOp.Value.ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@prompt.ID" class="btn btn-sm btn-info" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@prompt.ID" class="btn btn-sm btn-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@prompt.ID" class="btn btn-sm btn-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="alert alert-info" role="alert">
                No prompts found. <a asp-action="Create">Create your first prompt</a>.
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <p><strong>Total prompts:</strong> @Model.Count()</p>
</div>

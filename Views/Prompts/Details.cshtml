@model VectorRagDemo.Models.Entities.Prompt
@{
    ViewData["Title"] = "Prompt Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Prompt Details</h1>
    <div class="btn-group" role="group">
        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.ID" class="btn btn-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">
                <span class="badge bg-primary">@Model.ID</span>
            </dd>

            <dt class="col-sm-3">Project</dt>
            <dd class="col-sm-9">
                <strong>@Model.ProjectNavigation?.Naam</strong>
                @if (!string.IsNullOrEmpty(Model.ProjectNavigation?.BaseUrl))
                {
                    <br />
                    <small class="text-muted">@Model.ProjectNavigation.BaseUrl</small>
                }
            </dd>

            <dt class="col-sm-3">Prompt Type</dt>
            <dd class="col-sm-9">
                <span class="badge bg-info text-dark">@Model.PromptTypeNavigation?.Omschrijving</span>
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Status == 1)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>
        </dl>

        <hr />

        <div class="mb-4">
            <h5>System Instruction</h5>
            <div class="border rounded p-3 bg-light">
                <pre class="mb-0" style="white-space: pre-wrap; word-wrap: break-word;">@Model.SystemInstruction</pre>
            </div>
        </div>

        <div class="mb-4">
            <h5>Prompt Content</h5>
            <div class="border rounded p-3 bg-light">
                <pre class="mb-0" style="white-space: pre-wrap; word-wrap: break-word;">@Model.Content</pre>
            </div>
        </div>

        <hr />

        <dl class="row">
            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">
                <i class="bi bi-calendar-plus"></i> @Model.GemaaktOp.ToString("dddd, MMMM dd, yyyy 'at' HH:mm:ss")
            </dd>

            <dt class="col-sm-3">Last Modified</dt>
            <dd class="col-sm-9">
                @if (Model.GewijzigdOp.HasValue)
                {
                    <i class="bi bi-calendar-check"></i> @Model.GewijzigdOp.Value.ToString("dddd, MMMM dd, yyyy 'at' HH:mm:ss")
                }
                else
                {
                    <span class="text-muted">Never modified</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning">
        <i class="bi bi-pencil"></i> Edit Prompt
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="mt-4">
    <div class="card bg-light">
        <div class="card-body">
            <h5 class="card-title">Usage Information</h5>
            <p class="mb-0">
                This prompt is configured for the <strong>@Model.ProjectNavigation?.Naam</strong> project and uses
                the <strong>@Model.PromptTypeNavigation?.Omschrijving</strong> type. It can be used in RAG queries
                to provide context-aware AI responses based on retrieved chunks from the vector database.
            </p>
        </div>
    </div>
</div>

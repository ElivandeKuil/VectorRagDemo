@model VectorRagDemo.Models.Entities.Prompt

@{
    ViewData["Title"] = "Delete Prompt";
}

<h1>Delete Prompt</h1>

<div class="alert alert-warning" role="alert">
    <i class="bi bi-exclamation-triangle"></i> <strong>Warning:</strong> Are you sure you want to delete this prompt?
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Prompt Details</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.ID</dd>

            <dt class="col-sm-3">Project</dt>
            <dd class="col-sm-9">@Model.ProjectNavigation?.Naam</dd>

            <dt class="col-sm-3">Prompt Type</dt>
            <dd class="col-sm-9">@Model.PromptTypeNavigation?.Omschrijving</dd>

            <dt class="col-sm-3">System Instruction</dt>
            <dd class="col-sm-9">
                <div class="border rounded p-2 bg-light" style="max-height: 150px; overflow-y: auto;">
                    @Model.SystemInstruction
                </div>
            </dd>

            <dt class="col-sm-3">Content</dt>
            <dd class="col-sm-9">
                <div class="border rounded p-2 bg-light" style="max-height: 200px; overflow-y: auto;">
                    @Model.Content
                </div>
            </dd>

            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">@Model.GemaaktOp.ToString("yyyy-MM-dd HH:mm:ss")</dd>

            <dt class="col-sm-3">Last Modified</dt>
            <dd class="col-sm-9">
                @if (Model.GewijzigdOp.HasValue)
                {
                    @Model.GewijzigdOp.Value.ToString("yyyy-MM-dd HH:mm:ss")
                }
                else
                {
                    <span class="text-muted">Never</span>
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Status == 1)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ID" />
        <div class="d-flex gap-2">
            <button type="submit" btn-variant="danger" btn-icon="trash"> Confirm Delete</button>
            <a asp-action="Index" btn-variant="secondary" btn-icon="x-circle"> Cancel</a>
        </div>
    </form>
</div>

<div class="mt-3">
    <div class="alert alert-info" role="alert">
        <strong>Note:</strong> This is a soft delete. The prompt's status will be set to inactive (0) but the record will remain in the database.
    </div>
</div>

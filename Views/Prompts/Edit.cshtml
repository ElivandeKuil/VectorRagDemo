@model VectorRagDemo.Models.Entities.Prompt

@{
    ViewData["Title"] = "Edit Prompt";
}

<h1>Edit Prompt</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ID" />
            <input type="hidden" asp-for="GemaaktOp" />
            <input type="hidden" asp-for="Status" />

            <div class="mb-3">
                <label asp-for="Project" app-label>Project</label>
                <select asp-for="Project" app-field asp-items="ViewBag.Projects" required>
                    <option value="">-- Select a Project --</option>
                </select>
                <div class="form-text">Select the project this prompt is associated with.</div>
            </div>

            <div class="mb-3">
                <label asp-for="PromptType" app-label>Prompt Type</label>
                <select asp-for="PromptType" app-field asp-items="ViewBag.PromptTypes" required>
                    <option value="">-- Select a Prompt Type --</option>
                </select>
                <div class="form-text">Choose the type of prompt.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Model" app-label>Model</label>
                <select asp-for="Model" app-field required>
                    <option value="">-- Select a Model --</option>
                    <option value="gemini-2.5-flash-lite">Gemini 2.5 Flash Lite (Faster, Lower Cost)</option>
                    <option value="gemini-2.5-flash">Gemini 2.5 Flash (Balanced)</option>
                </select>
                <div class="form-text">Select the Gemini model to use for this prompt.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Volgorde" app-label>Volgorde</label>
                <input asp-for="Volgorde" type="number" app-field min="0" required />
                <div class="form-text">Order/priority of the prompt (lower values are processed first).</div>
            </div>

            <div class="mb-3">
                <label asp-for="SystemInstruction" app-label>System Instruction</label>
                <textarea asp-for="SystemInstruction" app-field rows="4" required></textarea>
                <div class="form-text">
                    System instructions guide the overall behavior of the AI model.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Content" app-label>Prompt Content</label>
                <textarea asp-for="Content" app-field rows="8" required></textarea>
                <div class="form-text">
                    The main content of the prompt that will be used in RAG queries.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ResponseSchema" app-label>Response Schema (Output Format)</label>
                <textarea asp-for="ResponseSchema" app-field rows="6" placeholder="Enter JSON schema for structured output..."></textarea>
                <div class="form-text">
                    Define the JSON schema for the AI's response format. Leave empty for unstructured responses.
                </div>
            </div>

            <h5 class="mt-4 mb-3">Model Parameters</h5>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="MaxTokens" app-label>Max Tokens</label>
                    <input asp-for="MaxTokens" type="number" app-field min="1" max="8192" required />
                    <div class="form-text">Maximum number of tokens in the response (1-8192).</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="TopK" app-label>Top K</label>
                    <input asp-for="TopK" type="number" app-field min="1" max="100" required />
                    <div class="form-text">Top-K sampling parameter (1-100).</div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Temperature" app-label>Temperature</label>
                    <input asp-for="Temperature" type="number" app-field step="0.1" min="0.0" max="2.0" required />
                    <div class="form-text">Controls randomness (0.0 = deterministic, 2.0 = very random).</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="TopP" app-label>Top P</label>
                    <input asp-for="TopP" type="number" app-field step="0.1" min="0.0" max="1.0" required />
                    <div class="form-text">Nucleus sampling parameter (0.0-1.0).</div>
                </div>
            </div>

            <div class="mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <label app-label>Created On</label>
                        <input type="text" app-field value="@Model.GemaaktOp.ToString("yyyy-MM-dd HH:mm:ss")" readonly disabled />
                    </div>
                    <div class="col-md-6">
                        <label app-label>Last Modified</label>
                        <input type="text" app-field value="@(Model.GewijzigdOp?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Never")" readonly disabled />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" btn-variant="primary" btn-icon="save"> Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.ID" btn-variant="info" btn-icon="eye"> View Details</a>
                <a asp-action="Index" btn-variant="secondary" btn-icon="arrow-left"> Back to List</a>
            </div>
        </form>
    </div>
</div>

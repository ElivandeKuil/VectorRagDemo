@model VectorRagDemo.Models.Entities.Prompt

@{
    ViewData["Title"] = "Edit Prompt";
}

<h1>Edit Prompt</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ID" />
            <input type="hidden" asp-for="GemaaktOp" />
            <input type="hidden" asp-for="Status" />

            <div class="mb-3">
                <label asp-for="Project" class="form-label">Project</label>
                <select asp-for="Project" class="form-select" asp-items="ViewBag.Projects" required>
                    <option value="">-- Select a Project --</option>
                </select>
                <div class="form-text">Select the project this prompt is associated with.</div>
            </div>

            <div class="mb-3">
                <label asp-for="PromptType" class="form-label">Prompt Type</label>
                <select asp-for="PromptType" class="form-select" asp-items="ViewBag.PromptTypes" required>
                    <option value="">-- Select a Prompt Type --</option>
                </select>
                <div class="form-text">Choose the type of prompt.</div>
            </div>

            <div class="mb-3">
                <label asp-for="SystemInstruction" class="form-label">System Instruction</label>
                <textarea asp-for="SystemInstruction" class="form-control" rows="4" required></textarea>
                <div class="form-text">
                    System instructions guide the overall behavior of the AI model.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label">Prompt Content</label>
                <textarea asp-for="Content" class="form-control" rows="8" required></textarea>
                <div class="form-text">
                    The main content of the prompt that will be used in RAG queries.
                </div>
            </div>

            <div class="mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label">Created On</label>
                        <input type="text" class="form-control" value="@Model.GemaaktOp.ToString("yyyy-MM-dd HH:mm:ss")" readonly disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last Modified</label>
                        <input type="text" class="form-control" value="@(Model.GewijzigdOp?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Never")" readonly disabled />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.ID" class="btn btn-info">
                    <i class="bi bi-eye"></i> View Details
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Vector RAG Demo</h1>
    <p class="lead">SQL Server 2025 Vector Search with RAG Chatbot</p>
</div>

<div class="mt-4">
    @await Html.PartialAsync("_StatsPartial")
</div>

<div class="mt-5">
    <a asp-controller="Chat" asp-action="Index" btn-variant="success" btn-size="lg" btn-icon="chat-dots"> Chat with RAG</a>
    <a asp-controller="Chunk" asp-action="Index" btn-variant="primary" btn-size="lg" btn-icon="file-text"> View Chunks</a>
</div>
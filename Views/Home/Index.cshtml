@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "AI Chatbot voor uw website | ElAi Solutions";
    ViewData["MetaDescription"] = "Geef uw klanten 24/7 direct antwoord met een slimme AI-assistent op uw website. Volledig ingericht door ons, geen technische kennis vereist.";
}

@section Styles {
<style>
  /* === Hero chat mockup page-level styles === */
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @@media (max-width: 991px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-text { text-align: center; }
    .hero-actions { justify-content: center; }
    .hero-badge { margin-left: auto; margin-right: auto; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .chat-mockup { max-width: 400px; }
  }

  .roi-section-heading {
    max-width: 600px;
  }

  .pricing-preview-tier-label {
    text-align: center;
    margin-top: 2.5rem;
  }

  .pricing-preview-note {
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 1.5rem;
  }
</style>
}

<!-- ===== 1. HERO ===== -->
<section class="hero">
    <div class="container">
        <div class="hero-inner">
            <div class="hero-text">
                <h1>Uw klanten krijgen direct antwoord.<br><span class="text-blue">24 uur per dag, 7 dagen per week.</span></h1>
                <p class="hero-sub">Een slimme assistent op uw website, getraind op uw eigen bedrijfsinformatie.</p>
                <div class="hero-actions">
                    <a href="/tarieven" class="btn-primary-cta">Bekijk onze tarieven</a>
                    <a href="/contact" class="btn-outline-cta">Plan een gratis demo</a>
                </div>
            </div>

            <!-- Chat widget mockup -->
            <div class="chat-mockup">
                <div class="chat-mockup-header">
                    <span class="chat-dot"></span><span class="chat-dot"></span><span class="chat-dot"></span>
                    &nbsp; ElAi Assistent
                </div>
                <div class="chat-mockup-body">
                    <div class="chat-msg user-msg">Wat zijn uw levertijden voor bestellingen boven €500?</div>
                    <div class="chat-msg bot-msg">Bestellingen boven €500 worden gratis bezorgd. De levertijd is 2–3 werkdagen. Heeft u een specifiek product in gedachten?</div>
                    <div class="chat-msg user-msg">Nee, ik weet nog niet zo goed welke gordijnen het best passen in mijn woonkamer.</div>
                    <div class="chat-msg bot-msg">Dat snap ik goed. Laten we samen kijken welke gordijnen er het best bij uw stijl passen. Heeft u al wel een kleurgroep in gedachten?</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 2. TRUST BAR ===== -->
<div class="trust-bar">
    <div class="container">
        <div class="trust-bar-inner">
            <span class="trust-pill"><i class="bi bi-shield-check"></i> GDPR-compliant</span>
            <span class="trust-pill"><i class="bi bi-tag"></i> Geen installatiekosten</span>
            <span class="trust-pill"><i class="bi bi-calendar-check"></i> Maandelijks opzegbaar</span>
            <span class="trust-pill"><i class="bi bi-patch-check"></i> Geen branding van derden</span>
        </div>
    </div>
</div>

<!-- ===== 3. HET PROBLEEM ===== -->
<section class="section-alt">
    <div class="container">
        <div class="text-center">
            <span class="section-label">Het probleem</span>
            <h2 class="section-title">Kent u dit?</h2>
            <p class="section-sub mx-auto">Veel bedrijven verliezen dagelijks tijd en klanten aan vragen die ook automatisch beantwoord kunnen worden.</p>
        </div>
        <div class="pain-cards-grid">
            <div class="pain-card">
                <div class="pain-icon">
                    <i class="bi bi-telephone-x"></i>
                </div>
                <h3>Uw team beantwoordt dagelijks dezelfde vragen</h3>
                <p>Productspecificaties, levertijden, prijzen — steeds opnieuw. Uw medewerkers hebben wel betere dingen te doen.</p>
            </div>
            <div class="pain-card">
                <div class="pain-icon">
                    <i class="bi bi-moon"></i>
                </div>
                <h3>Bezoekers buiten kantooruren vertrekken zonder antwoord</h3>
                <p>Uw website is 24/7 bereikbaar, maar uw team niet. Elke nacht verliest u potentiële klanten.</p>
            </div>
            <div class="pain-card">
                <div class="pain-icon">
                    <i class="bi bi-person-dash"></i>
                </div>
                <h3>Potentiële klanten haken af door trage informatieverstrekking</h3>
                <p>Wie geen snel antwoord krijgt, zoekt verder bij de concurrent. Dat is omzet die u misloopt.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== 5. VOORDELEN ===== -->
<section class="section-alt">
    <div class="container">
        <div class="text-center">
            <span class="section-label">Voordelen</span>
            <h2 class="section-title">Waarom ElAi Solutions?</h2>
            <p class="section-sub mx-auto">Alles wat u nodig heeft voor een professionele AI-assistent, zonder de technische rompslomp.</p>
        </div>
        <div class="benefits-grid">
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="bi bi-clock-fill"></i>
                </div>
                <h3>Altijd bereikbaar</h3>
                <p>Uw chatbot staat 24/7 klaar, ook in het weekend en 's nachts.</p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon blue-bg">
                    <i class="bi bi-file-earmark-check-fill"></i>
                </div>
                <h3>Antwoorden op basis van uw informatie</h3>
                <p>Geen verzinsels. Alleen antwoorden uit uw eigen documentatie.</p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon light-bg">
                    <i class="bi bi-tools"></i>
                </div>
                <h3>Nul technische kennis nodig</h3>
                <p>Wij installeren, configureren en lanceren. U levert de kennis.</p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="bi bi-shield-check-fill"></i>
                </div>
                <h3>Geen zichtbare branding</h3>
                <p>Uw chatbot, uw merk. Geen 'powered by' logo's.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== 6. ROI CALCULATOR ===== -->
<section class="section-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center">
                    <span class="section-label">Rekenvoorbeeld</span>
                    <h2 class="section-title roi-section-heading mx-auto">Wat levert een chatbot u op?</h2>
                </div>
                <div class="roi-block">
                    <p>Stel: uw chatbot voorkomt dagelijks 4 telefoontjes of emails van 10 minuten. Dat is 40 minuten per dag × 22 werkdagen = circa <strong>15 uur per maand</strong> aan bespaard teamwerk. Tegen een gemiddeld uurloon van €20 is dat <strong>€300/maand aan bespaarde arbeidstijd</strong> — En dan is de waarde van behouden klanten die wél antwoord kregen buiten kantooruren nog niet meegerekend.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 7. FINAL CTA ===== -->
<section class="cta-section">
    <div class="container">
        <h2>Klaar om uw klanten 24/7 te helpen?</h2>
        <p>Plan een gratis demo en ontdek wat een AI-assistent voor uw bedrijf kan betekenen.</p>
        <a href="/contact" class="btn-primary-cta">Plan een gratis demo</a>
        <a href="/tarieven" class="cta-secondary-link">Of bekijk onze tarieven</a>
    </div>
</section>

@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "AI Chatbot voor uw website | ElAI Solutions";
    ViewData["MetaDescription"] = "Geef uw klanten 24/7 direct antwoord met een slimme AI-assistent op uw website. Volledig ingericht door ons, geen technische kennis vereist.";
}

@section Styles {
<style>
  /* === Hero chat mockup page-level styles === */
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @@media (max-width: 991px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-text { text-align: center; }
    .hero-actions { justify-content: center; }
    .hero-badge { margin-left: auto; margin-right: auto; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .chat-mockup { max-width: 400px; }
  }

  .roi-section-heading {
    max-width: 600px;
  }

  .pricing-preview-tier-label {
    text-align: center;
    margin-top: 2.5rem;
  }

  .pricing-preview-note {
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 1.5rem;
  }
</style>
}

<!-- ===== 1. HERO ===== -->
<section class="hero">
    <div class="container">
        <div class="hero-inner">
            <div class="hero-text">
                <div class="hero-badge">
                    <i class="bi bi-stars"></i> AI chatbot voor Nederlandse bedrijven
                </div>
                <h1>Uw klanten krijgen direct antwoord.<br><span class="text-blue">24 uur per dag, 7 dagen per week.</span></h1>
                <p class="hero-sub">Een slimme assistent op uw website, getraind op uw eigen bedrijfsinformatie. Volledig door ons ingericht — u hoeft niets te doen.</p>
                <div class="hero-actions">
                    <a href="/tarieven" class="btn-primary-cta">Bekijk onze tarieven</a>
                    <a href="/contact" class="btn-outline-cta">Plan een gratis demo</a>
                </div>
            </div>

            <!-- Chat widget mockup -->
            <div class="chat-mockup">
                <div class="chat-mockup-header">
                    <span class="chat-dot"></span><span class="chat-dot"></span><span class="chat-dot"></span>
                    &nbsp; ElAI Assistent
                </div>
                <div class="chat-mockup-body">
                    <div class="chat-msg user-msg">Wat zijn uw levertijden voor bestellingen boven €500?</div>
                    <div class="chat-msg bot-msg">Bestellingen boven €500 worden gratis bezorgd. De levertijd is 2–3 werkdagen. Heeft u een specifiek product in gedachten?</div>
                    <div class="chat-msg user-msg">Ja, de industriële ventilator model V-350.</div>
                    <div class="chat-msg bot-msg">De V-350 is op voorraad en wordt morgen verzonden bij bestelling vóór 15:00 uur. Wilt u direct bestellen of heeft u nog vragen?</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 2. TRUST BAR ===== -->
<div class="trust-bar">
    <div class="container">
        <div class="trust-bar-inner">
            <span class="trust-pill"><i class="bi bi-shield-check"></i> GDPR-compliant</span>
            <span class="trust-pill"><i class="bi bi-tag"></i> Geen installatiekosten</span>
            <span class="trust-pill"><i class="bi bi-calendar-check"></i> Maandelijks opzegbaar</span>
            <span class="trust-pill"><i class="bi bi-patch-check"></i> Geen branding van derden</span>
        </div>
    </div>
</div>

<!-- ===== 3. HET PROBLEEM ===== -->
<section class="section-alt">
    <div class="container">
        <div class="text-center">
            <span class="section-label">Het probleem</span>
            <h2 class="section-title">Kent u dit?</h2>
            <p class="section-sub mx-auto">Veel Nederlandse bedrijven verliezen dagelijks tijd en klanten aan vragen die ook automatisch beantwoord kunnen worden.</p>
        </div>
        <div class="pain-cards-grid">
            <div class="pain-card">
                <div class="pain-icon">
                    <i class="bi bi-telephone-x"></i>
                </div>
                <h3>Uw team beantwoordt dagelijks dezelfde vragen</h3>
                <p>Productspecificaties, levertijden, prijzen — steeds opnieuw. Uw medewerkers hebben wel betere dingen te doen.</p>
            </div>
            <div class="pain-card">
                <div class="pain-icon">
                    <i class="bi bi-moon"></i>
                </div>
                <h3>Bezoekers buiten kantooruren vertrekken zonder antwoord</h3>
                <p>Uw website is 24/7 bereikbaar, maar uw team niet. Elke nacht verliest u potentiële klanten.</p>
            </div>
            <div class="pain-card">
                <div class="pain-icon">
                    <i class="bi bi-person-dash"></i>
                </div>
                <h3>Potentiële klanten haken af door trage informatieverstrekking</h3>
                <p>Wie geen snel antwoord krijgt, zoekt verder bij de concurrent. Dat is omzet die u misloopt.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== 4. HOE HET WERKT ===== -->
<section class="section-light">
    <div class="container">
        <div class="text-center">
            <span class="section-label">Hoe het werkt</span>
            <h2 class="section-title">In drie stappen live op uw website</h2>
            <p class="section-sub mx-auto">Wij nemen het volledige traject uit handen. Van configuratie tot livegang — u levert de kennis, wij regelen de rest.</p>
        </div>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <h3>Wij richten alles in</h3>
                <p>De chatbot wordt volledig door ons geconfigureerd en afgestemd op uw huisstijl.</p>
            </div>
            <div class="step-card">
                <div class="step-number">2</div>
                <h3>Uw kennis wordt geladen</h3>
                <p>Productinformatie, prijslijsten, FAQ's — alles wordt de kennisbank van uw chatbot.</p>
            </div>
            <div class="step-card">
                <div class="step-number">3</div>
                <h3>Direct live op uw website</h3>
                <p>Een elegante chatwidget, volledig in uw huisstijl. Geen branding van derden.</p>
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="/hoe-het-werkt" class="link-arrow">Lees meer over hoe het werkt <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</section>

<!-- ===== 5. VOORDELEN ===== -->
<section class="section-alt">
    <div class="container">
        <div class="text-center">
            <span class="section-label">Voordelen</span>
            <h2 class="section-title">Waarom ElAI Solutions?</h2>
            <p class="section-sub mx-auto">Alles wat u nodig heeft voor een professionele AI-assistent, zonder de technische rompslomp.</p>
        </div>
        <div class="benefits-grid">
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="bi bi-clock-fill"></i>
                </div>
                <h3>Altijd bereikbaar</h3>
                <p>Uw chatbot staat 24/7 klaar, ook in het weekend en 's nachts.</p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon blue-bg">
                    <i class="bi bi-file-earmark-check-fill"></i>
                </div>
                <h3>Antwoorden op basis van uw informatie</h3>
                <p>Geen verzinsels. Alleen antwoorden uit uw eigen documentatie.</p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon light-bg">
                    <i class="bi bi-tools"></i>
                </div>
                <h3>Nul technische kennis nodig</h3>
                <p>Wij installeren, configureren en lanceren. U levert de kennis.</p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="bi bi-shield-check-fill"></i>
                </div>
                <h3>Geen zichtbare branding</h3>
                <p>Uw chatbot, uw merk. Geen 'powered by' logo's.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== 6. ROI CALCULATOR ===== -->
<section class="section-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center">
                    <span class="section-label">Rekenvoorbeeld</span>
                    <h2 class="section-title roi-section-heading mx-auto">Wat levert een chatbot u op?</h2>
                </div>
                <div class="roi-block">
                    <p>Stel: uw chatbot voorkomt dagelijks 2 telefoontjes van 10 minuten. Dat is ±40 minuten per dag × 22 werkdagen = circa <strong>15 uur per maand</strong> aan bespaard teamwerk. Tegen een gemiddeld uurloon van €25 is dat <strong>€375/maand aan bespaarde arbeidstijd</strong> — meer dan de investering in het Professional- of Business-abonnement. En dan is de waarde van behouden klanten die wél antwoord kregen buiten kantooruren nog niet meegerekend.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 7. TARIEVEN PREVIEW ===== -->

<!-- Concierge preview — first and emphasized -->
<section class="pricing-tier-section concierge-tier">
    <div class="container">
        <div class="tier-intro">
            <span class="section-label" style="color: rgba(255,255,255,0.5); background: transparent; padding: 0;">Tarieven</span>
            <span class="tier-badge tier-badge-concierge" style="display:block; margin: 0.5rem auto 0; width: fit-content;">Volledig beheerd door ons</span>
            <h2>Wij nemen alles uit handen</h2>
            <p>U levert de kennis, wij doen de rest. Van inrichting en installatie tot dagelijks beheer en optimalisatie.</p>
        </div>
        <div class="pricing-grid-2col wide" style="margin-top: 1.5rem;">
            <div class="pricing-card concierge-card">
                <div class="pricing-plan-name">Concierge</div>
                <div class="pricing-amount">
                    <span class="pricing-currency">€</span>
                    <span class="price-amount">349</span>
                    <span class="pricing-period">/maand</span>
                </div>
                <p class="pricing-sub">Tot 10 wijzigingen/maand. Persoonlijk contactpersoon. Maandrapportage.</p>
                <a href="/tarieven" class="pricing-cta">Meer informatie</a>
            </div>
            <div class="pricing-card elite-card">
                <div class="badge-elite">Elite</div>
                <div class="pricing-plan-name">Concierge Elite</div>
                <div class="pricing-amount">
                    <span class="pricing-currency">€</span>
                    <span class="price-amount">649</span>
                    <span class="pricing-period">/maand</span>
                </div>
                <p class="pricing-sub">Onbeperkt wijzigen. Tweewekelijkse rapportage. Dedicated strateeg.</p>
                <a href="/tarieven" class="pricing-cta">Meer informatie</a>
            </div>
        </div>
        <div class="concierge-value-strip">
            <span><i class="bi bi-check-circle-fill"></i> Geen dashboardbeheer voor u</span>
            <span><i class="bi bi-check-circle-fill"></i> Altijd up-to-date kennisbank</span>
            <span><i class="bi bi-check-circle-fill"></i> Maandelijks opzegbaar</span>
        </div>
    </div>
</section>

<!-- Self-service preview — secondary, compact -->
<section class="section-light" style="padding: 3rem 0;">
    <div class="container">
        <div class="text-center mb-4">
            <span class="tier-badge tier-badge-saas">U beheert zelf</span>
            <p class="mt-2 mb-0" style="color: var(--muted); font-size: 0.95rem;">Liever zelf aan de knoppen? Ook dat kan. Wij installeren alles, u beheert de chatbot via uw eigen dashboard.</p>
        </div>
        <div class="pricing-grid-2col">
            <div class="pricing-card">
                <div class="pricing-plan-name">Professional</div>
                <div class="pricing-amount">
                    <span class="pricing-currency">€</span>
                    <span class="price-amount">89</span>
                    <span class="pricing-period">/maand</span>
                </div>
                <p class="pricing-sub">1.000 gesprekken/maand. Eigen beheer via dashboard.</p>
                <a href="/tarieven" class="pricing-cta">Meer informatie</a>
            </div>
            <div class="pricing-card">
                <div class="pricing-plan-name">Business</div>
                <div class="pricing-amount">
                    <span class="pricing-currency">€</span>
                    <span class="price-amount">149</span>
                    <span class="pricing-period">/maand</span>
                </div>
                <p class="pricing-sub">2.500 gesprekken + aparte testomgeving.</p>
                <a href="/tarieven" class="pricing-cta">Meer informatie</a>
            </div>
        </div>
        <p class="text-center mt-3" style="font-size:0.8rem; color: var(--muted);">
            Alle abonnementen incl. installatie en configuratie. Maandelijks opzegbaar. &mdash; <a href="/tarieven" style="color: var(--blue);">Bekijk alle tarieven</a>
        </p>
    </div>
</section>

<!-- ===== 8. FINAL CTA ===== -->
<section class="cta-section">
    <div class="container">
        <h2>Klaar om uw klanten 24/7 te helpen?</h2>
        <p>Plan een gratis demo en ontdek wat een AI-assistent voor uw bedrijf kan betekenen.</p>
        <a href="/contact" class="btn-primary-cta">Plan een gratis demo</a>
        <a href="/tarieven" class="cta-secondary-link">Of bekijk onze tarieven</a>
    </div>
</section>

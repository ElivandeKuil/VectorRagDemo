@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "Over ons | ElAi Solutions";
    ViewData["MetaDescription"] = "ElAi Solutions maakt professionele AI-chatbots toegankelijk voor het Nederlandse MKB. Eerlijke prijzen, directe service, volledig beheerd.";
}

<!-- ===== 1. PAGE HEADER ===== -->
<section class="page-header">
    <div class="container">
        <div class="text-center">
            <span class="section-label" style="color: rgba(255,255,255,0.55);">Over ons</span>
            <h1>Wij geloven dat iedere ondernemer recht heeft op professionele AI</h1>
        </div>
    </div>
</section>

<!-- ===== 2. STORY ===== -->
<section class="section-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <span class="section-label">Ons verhaal</span>
                <h2 class="section-title">Hoe ElAi Solutions is ontstaan</h2>
                <div class="mt-3" style="font-size: 1rem; color: var(--text); line-height: 1.8;">
                    <p>ElAi Solutions is opgericht vanuit een eenvoudige observatie: grote bedrijven profiteren al jaren van AI-technologie om hun klantcommunicatie te verbeteren. Kleine en middelgrote bedrijven worden daar doorgaans buiten gehouden — niet omdat de technologie er niet is, maar omdat de implementatie of te complex is, of de service te duur is.</p>
                    <p>Wij bouwen die brug. Met directe service, eerlijke prijzen en een team dat uw bedrijf echt kent.</p>
                    <p>Ons systeem is gebouwd op bewezen AI-technologie die werkt met uw eigen documentatie — geen algemene kennis van het internet, geen verzinsels. Alleen antwoorden die u zelf heeft goedgekeurd.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 3. WAARDEN ===== -->
<section class="section-alt">
    <div class="container">
        <div class="text-center">
            <span class="section-label">Onze waarden</span>
            <h2 class="section-title">Waar wij voor staan</h2>
        </div>
        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon">
                    <i class="bi bi-eye"></i>
                </div>
                <h3>Transparantie</h3>
                <p>Eerlijke prijzen, duidelijke afspraken. Geen verborgen kosten of onduidelijke beperkingen.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">
                    <i class="bi bi-lightbulb"></i>
                </div>
                <h3>Eenvoud</h3>
                <p>
                    Technologie mag complex zijn; voor u is het dat niet. Wij nemen de technische complexiteit weg zodat u gelijk kunt instappen.
                </p>
            </div>
            <div class="value-card">
                <div class="value-icon">
                    <i class="bi bi-person-check"></i>
                </div>
                <h3>Persoonlijk contact</h3>
                <p>U heeft altijd een direct aanspreekpunt. Geen ticketsystemen of lange reactietijden.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== 4. TECHNOLOGY ===== -->
<section class="section-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <span class="section-label">Technologie</span>
                <h2 class="section-title">Gebouwd op bewezen AI-technologie</h2>
                <div class="tech-block">
                    <p>Wij gebruiken bewezen AI-modellen die specifiek worden getraind op uw bedrijfsinformatie. Uw documentatie blijft uw eigendom — versleuteld opgeslagen, volledig GDPR-compliant.</p>
                </div>
                <div class="mt-4 d-flex flex-wrap gap-3">
                    <span class="trust-pill"><i class="bi bi-shield-lock"></i> Versleutelde opslag</span>
                    <span class="trust-pill"><i class="bi bi-shield-check"></i> GDPR-compliant</span>
                    <span class="trust-pill"><i class="bi bi-building"></i> Eigendom blijft bij u</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 5. CTA ===== -->
<section class="cta-section">
    <div class="container">
        <h2>Wilt u kennismaken?</h2>
        <p>Ontdek in een gratis gesprek wat een AI-assistent voor uw bedrijf kan betekenen.</p>
        <a href="/contact" class="btn-primary-cta">Neem contact op</a>
        <a href="/hoe-het-werkt" class="cta-secondary-link">Of lees meer over hoe het werkt</a>
    </div>
</section>

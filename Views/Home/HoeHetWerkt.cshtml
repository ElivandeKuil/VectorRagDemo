@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "Hoe het werkt | ElAI Solutions";
    ViewData["MetaDescription"] = "Van aanmelding tot live chatbot in enkele dagen. Wij verzorgen alles — u levert de documentatie.";
}

<!-- ===== 1. PAGE HEADER ===== -->
<section class="page-header">
    <div class="container">
        <div class="text-center">
            <span class="section-label" style="color: rgba(255,255,255,0.55);">Ons proces</span>
            <h1>Van aanmelding tot live chatbot — in dagen, niet weken</h1>
            <p>Wij nemen het volledige traject voor onze rekening. Uw enige taak is het aanleveren van uw bedrijfsinformatie.</p>
        </div>
    </div>
</section>

<!-- ===== 2. TIMELINE ===== -->
<section class="section-light">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label">Stappenplan</span>
            <h2 class="section-title">Hoe het in zijn werk gaat</h2>
        </div>

        <div class="timeline">
            <!-- Step 1 -->
            <div class="timeline-item">
                <div class="timeline-icon-wrap">
                    <i class="bi bi-chat-square-dots"></i>
                </div>
                <div class="timeline-content">
                    <div class="timeline-step-num">Stap 1</div>
                    <h3>Kennismakingsgesprek</h3>
                    <p>We bespreken uw wensen, doelgroep en welke informatie de chatbot moet kennen. Dit gesprek duurt 30–45 minuten en is volledig vrijblijvend.</p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="timeline-item">
                <div class="timeline-icon-wrap">
                    <i class="bi bi-file-earmark-arrow-up"></i>
                </div>
                <div class="timeline-content">
                    <div class="timeline-step-num">Stap 2</div>
                    <h3>Documentatie aanleveren</h3>
                    <p>U levert productinformatie, FAQ's, prijslijsten of andere documentatie aan. Dit kan via e-mail, Google Drive of een eigen systeem. Wij verwerken alles.</p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="timeline-item">
                <div class="timeline-icon-wrap">
                    <i class="bi bi-sliders"></i>
                </div>
                <div class="timeline-content">
                    <div class="timeline-step-num">Stap 3</div>
                    <h3>Configuratie &amp; afstemming</h3>
                    <p>De chatbot wordt ingesteld op uw huisstijl, tone-of-voice en specifieke instructies. U krijgt een preview ter goedkeuring.</p>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="timeline-item">
                <div class="timeline-icon-wrap">
                    <i class="bi bi-bug"></i>
                </div>
                <div class="timeline-content">
                    <div class="timeline-step-num">Stap 4</div>
                    <h3>Testen</h3>
                    <p>U test de chatbot en geeft feedback. Wij verfijnen tot het perfect is. Alle Concierge-abonnenten hebben een aparte testomgeving zodat aanpassingen veilig getest kunnen worden.</p>
                </div>
            </div>

            <!-- Step 5 -->
            <div class="timeline-item">
                <div class="timeline-icon-wrap">
                    <i class="bi bi-rocket-takeoff"></i>
                </div>
                <div class="timeline-content">
                    <div class="timeline-step-num">Stap 5</div>
                    <h3>Live op uw website</h3>
                    <p>Een klein stukje code op uw website en de chatbot is bereikbaar voor uw bezoekers. Wij ondersteunen alle gangbare CMS-platforms.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 3. WAT MAAKT ONZE AANPAK ANDERS ===== -->
<section class="section-alt">
    <div class="container">
        <div class="text-center mb-4">
            <span class="section-label">Onze aanpak</span>
            <h2 class="section-title">Wat maakt onze aanpak anders?</h2>
        </div>
        <div class="approach-grid">
            <div class="approach-card negative">
                <div class="approach-card-header">
                    <i class="bi bi-x-circle-fill"></i> Zelf doen
                </div>
                <p>Bij de meeste chatbot-tools moet u zelf documenten uploaden, de widget configureren, API-sleutels beheren en de kennisbank bijhouden. Dat kost tijd, frustratie en technische kennis die u misschien niet heeft.</p>
            </div>
            <div class="approach-card positive">
                <div class="approach-card-header">
                    <i class="bi bi-check-circle-fill"></i> Met ons
                </div>
                <p>Wij nemen alles uit handen. Van de eerste configuratie tot doorlopend beheer — of u doet het zelf via ons intuïtieve dashboard. De keuze is aan u.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== 4. INFO STRIP ===== -->
<section class="section-light">
    <div class="container">
        <div class="info-strip">
            <div class="info-strip-item">
                <i class="bi bi-clock"></i>
                <span>Gemiddelde doorlooptijd: 3–5 werkdagen</span>
            </div>
            <div class="info-strip-item">
                <i class="bi bi-chat-dots"></i>
                <span>Eerste gesprek: gratis en vrijblijvend</span>
            </div>
            <div class="info-strip-item">
                <i class="bi bi-headset"></i>
                <span>Ondersteuning: gedurende hele traject</span>
            </div>
        </div>
    </div>
</section>

<!-- ===== 5. CTA ===== -->
<section class="cta-section">
    <div class="container">
        <h2>Klaar om te starten?</h2>
        <p>Plan een vrijblijvend kennismakingsgesprek en ontdek wat een AI-assistent voor uw bedrijf kan betekenen.</p>
        <a href="/contact" class="btn-primary-cta">Plan een gratis demo</a>
        <a href="/tarieven" class="cta-secondary-link">Of bekijk onze tarieven</a>
    </div>
</section>
